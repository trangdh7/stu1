@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>STU - Chọn vai trò</title>
    <link href="/css/Dangnhap.css" rel="stylesheet" />
    <style>
        .role-selection {
            max-width: 500px;
            margin: 50px auto;
            padding: 30px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .role-option {
            display: block;
            width: 100%;
            padding: 15px 20px;
            margin: 10px 0;
            background: #f8f9fa;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s;
            text-align: left;
            font-size: 16px;
        }
        .role-option:hover {
            background: #e9ecef;
            border-color: #0c6215;
            transform: translateX(5px);
        }
        .role-option input[type="radio"] {
            margin-right: 10px;
        }
        .role-label {
            font-weight: 500;
            color: #333;
        }
        .role-description {
            font-size: 12px;
            color: #666;
            margin-top: 5px;
        }
        .btn-select-role {
            width: 100%;
            padding: 12px;
            background: #0c6215;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 20px;
            transition: background 0.3s;
        }
        .btn-select-role:hover {
            background: #0a4f10;
        }
        .btn-select-role:disabled {
            background: #ccc;
            cursor: not-allowed;
        }
        .current-role-badge {
            display: inline-block;
            padding: 5px 10px;
            background: #0c6215;
            color: white;
            border-radius: 15px;
            font-size: 12px;
            margin-left: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="logo-section">
            <img src="https://cdn.nhanlucnganhluat.vn/uploads/images/B937CC5F/logo/2019-11/logo2.jpg" alt="STU Logo" />
            <div class="company-name">
                CÔNG TY CỔ PHẦN DỊCH VỤ TỰ ĐỘNG HÓA STU
            </div>
        </div>

        <div class="role-selection">
            <h1>Chọn Vai Trò</h1>
            <p style="text-align: center; color: #666; margin-bottom: 30px;">
                Xin chào <strong>@ViewBag.Username</strong><br />
                Bạn có nhiều vai trò, vui lòng chọn vai trò bạn muốn sử dụng:
            </p>

            <form id="roleForm" method="post" asp-action="SetRole">
                @if (ViewBag.Roles != null)
                {
                    foreach (var role in ViewBag.Roles)
                    {
                        <label class="role-option">
                            <input type="radio" name="selectedRole" value="@role" required />
                            <span class="role-label">
                                @GetRoleDisplayName(role)
                                @if (ViewBag.CurrentRole != null && ViewBag.CurrentRole == role)
                                {
                                    <span class="current-role-badge">Đang sử dụng</span>
                                }
                            </span>
                            <div class="role-description">@GetRoleDescription(role)</div>
                        </label>
                    }
                }

                <button type="submit" class="btn-select-role" id="btnSelect">Chọn vai trò</button>
            </form>

            @if (ViewData["ErrorMessage"] != null)
            {
                <p class="error-message show" style="margin-top: 15px;">@ViewData["ErrorMessage"]</p>
            }

            <div style="text-align: center; margin-top: 20px;">
                <a href="/Home/Logout" style="color: #666; text-decoration: none;">Đăng xuất</a>
            </div>
        </div>
    </div>

    <script>
        document.getElementById("roleForm").addEventListener("submit", function(e) {
            const selected = document.querySelector('input[name="selectedRole"]:checked');
            if (!selected) {
                e.preventDefault();
                alert('Vui lòng chọn một vai trò');
                return false;
            }
        });

        // Highlight selected role
        document.querySelectorAll('input[name="selectedRole"]').forEach(radio => {
            radio.addEventListener('change', function() {
                document.querySelectorAll('.role-option').forEach(opt => {
                    opt.style.borderColor = '#e9ecef';
                });
                if (this.checked) {
                    this.closest('.role-option').style.borderColor = '#0c6215';
                }
            });
        });

        // Auto-select current role if exists
        @if (ViewBag.CurrentRole != null)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                const currentRole = '@ViewBag.CurrentRole';
                const radio = document.querySelector('input[value="' + currentRole + '"]');
                if (radio) {
                    radio.checked = true;
                    radio.closest('.role-option').style.borderColor = '#0c6215';
                }
            });
            </text>
        }
    </script>
</body>
</html>

@functions {
    private string GetRoleDisplayName(string role)
    {
        switch (role)
        {
            case "Giám đốc":
                return "Giám đốc";
            case "Nhân viên-BP kỹ thuật":
                return "Nhân viên Kỹ thuật";
            case "Trưởng BP-BP kỹ thuật":
                return "Trưởng BP Kỹ thuật";
            case "Trưởng BP-BP kho":
                return "Trưởng BP Kho";
            case "Trưởng BP-BP kế toán":
                return "Trưởng BP Kế toán";
            case "Trưởng BP-BP mua hàng":
                return "Trưởng BP Mua hàng";
            default:
                return role;
        }
    }

    private string GetRoleDescription(string role)
    {
        switch (role)
        {
            case "Giám đốc":
                return "Toàn quyền quản lý hệ thống";
            case "Nhân viên-BP kỹ thuật":
                return "Tạo và theo dõi yêu cầu vật tư";
            case "Trưởng BP-BP kỹ thuật":
                return "Duyệt yêu cầu và quản lý dự án";
            case "Trưởng BP-BP kho":
                return "Quản lý tồn kho và xuất nhập kho";
            case "Trưởng BP-BP kế toán":
                return "Duyệt thanh toán và quản lý tài chính";
            case "Trưởng BP-BP mua hàng":
                return "Quản lý phiếu mua hàng và báo giá";
            default:
                return "";
        }
    }
}












