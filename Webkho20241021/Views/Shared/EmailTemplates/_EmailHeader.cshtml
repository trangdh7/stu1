@{
    var loginUrl = ViewBag.LoginUrl ?? "https://stu.vn/Home/Dangnhap";
    var logoUrl = ViewBag.LogoUrl ?? "https://stu.vn/images/logo.png";
}
<div style="text-align:center; margin-bottom:16px; padding: 20px 0; background-color: #ffffff;">
    <a href="@loginUrl" style="text-decoration:none;">
        <img src="@logoUrl" alt="Logo" style="max-height:60px; margin-bottom:8px;" />
        <div style="font-size:18px; color:#2c3e50; font-weight:bold;">Hệ thống Quản lý Kho</div>
    </a>
</div>
