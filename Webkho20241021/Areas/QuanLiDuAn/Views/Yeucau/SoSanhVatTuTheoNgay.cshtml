@model List<dynamic>
@{
    ViewData["Title"] = "So sánh số liệu vật tư theo ngày";
    Layout = "~/Areas/QuanLiDuAn/Views/Layout/Layout.cshtml";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>So sánh số liệu vật tư theo ngày</title>
    <link rel="stylesheet" href="~/css/sosanhvattutheongay.css" />
</head>
<body>
    <div class="bodyyeucau">
        <!-- <div class="header-nav">
            <a href="@Url.Action("DanhSachFileExcel", "Yeucau", new { area = "QuanLiDuAn" })" class="btn-back">
                ← Quay lại
            </a>
        </div> -->

        <div class="page-header">
            <h2>So sánh số liệu vật tư</h2>
            <p>Theo ngày upload dự án</p>
        </div>

        <div class="filter-section">
            <form method="get" action="@Url.Action("SoSanhVatTuTheoNgay", "Yeucau", new { area = "QuanLiDuAn" })" class="filter-form">
                <input type="hidden" name="page" value="1" />
                
                <input type="date" id="ngay1" name="ngay1" value="@ViewBag.Ngay1" placeholder="Từ ngày" required />
                
                <input type="date" id="ngay2" name="ngay2" value="@ViewBag.Ngay2" placeholder="Đến ngày" required />
                
                <select id="maDuan" name="maDuan">
                    <option value="">Tất cả dự án</option>
                    @foreach (var duan in ViewBag.Duans)
                    {
                        <option value="@duan.MaDuan" selected="@(ViewBag.MaDuan == duan.MaDuan)">@duan.MaDuan - @duan.TenDuan</option>
                    }
                </select>
                
                @if (!string.IsNullOrEmpty(ViewBag.Ngay1) && !string.IsNullOrEmpty(ViewBag.Ngay2))
                {
                    <input type="text" id="searchMaVT" name="searchMaVT" placeholder="Mã vật tư..." value="@ViewBag.SearchMaVT" />
                    
                    <input type="text" id="searchTenVT" name="searchTenVT" placeholder="Tên vật tư..." value="@ViewBag.SearchTenVT" />
                    
                    <input type="date" id="searchNgay" name="searchNgay" value="@ViewBag.SearchNgay" placeholder="Ngày upload" />
                    
                    <input type="text" id="searchHangSX" name="searchHangSX" placeholder="Hãng sản xuất..." value="@ViewBag.SearchHangSX" />
                }
                
                <button type="submit">Tìm kiếm</button>
                
                @if (!string.IsNullOrEmpty(ViewBag.Ngay1) || !string.IsNullOrEmpty(ViewBag.SearchMaVT) || !string.IsNullOrEmpty(ViewBag.SearchTenVT) || !string.IsNullOrEmpty(ViewBag.SearchNgay) || !string.IsNullOrEmpty(ViewBag.SearchHangSX) || !string.IsNullOrEmpty(ViewBag.MaDuan))
                {
                    <a href="@Url.Action("SoSanhVatTuTheoNgay", "Yeucau", new { area = "QuanLiDuAn" })" class="btn-clear-filter">Xóa bộ lọc</a>
                }
            </form>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <div class="summary-box">
                <div class="summary-card">
                    <h4>Số file Excel</h4>
                    <div class="value">@ViewBag.ExcelFiles.Count</div>
                </div>
                <div class="summary-card">
                    <h4>Loại vật tư</h4>
                    <div class="value">@Model.Count</div>
                </div>
                <div class="summary-card">
                    <h4>Tổng số lượng</h4>
                    <div class="value">@Model.Sum(m => m.TongSL)</div>
                </div>
            </div>

            <div class="table-container">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width: 50px;">STT</th>
                            <th>Ngày upload</th>
                            <th>Mã VT</th>
                            <th>Tên thiết bị/hàng hóa</th>
                            <th>Hãng SX</th>
                            <th style="text-align: right;">Tổng SL</th>
                            <th style="text-align: right;">Số file</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int currentPage = ViewBag.Page ?? 1;
                            int pageSize = 20;
                            int stt = (currentPage - 1) * pageSize + 1;
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="stt-badge">@stt</div>
                                </td>
                                <td>@(((DateTime)item.NgayUpload).ToString("dd/MM/yyyy"))</td>
                                <td><strong>@item.MaSanpham</strong></td>
                                <td>@item.TenSanpham</td>
                                <td>@item.HangSX</td>
                                <td style="text-align: right;">@item.TongSL</td>
                                <td style="text-align: right;">@item.SoLuongFile</td>
                            </tr>
                            stt++;
                        }
                    </tbody>
                </table>
            </div>

            @if (ViewBag.TotalPages > 1)
            {
                <div class="pagination">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <a href="@Url.Action("SoSanhVatTuTheoNgay", "Yeucau", new { area = "QuanLiDuAn", page = i, ngay1 = ViewBag.Ngay1, ngay2 = ViewBag.Ngay2, maDuan = ViewBag.MaDuan, searchMaVT = ViewBag.SearchMaVT, searchTenVT = ViewBag.SearchTenVT, searchNgay = ViewBag.SearchNgay, searchHangSX = ViewBag.SearchHangSX })" 
                           class="@(ViewBag.Page == i ? "active" : "")">@i</a>
                    }
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <p>Không có dữ liệu</p>
                <small>Hãy chọn khoảng thời gian để xem dữ liệu so sánh</small>
            </div>
        }
    </div>
</body>
</html>
