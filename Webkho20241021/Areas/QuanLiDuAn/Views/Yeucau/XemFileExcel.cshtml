@using System.IO
@using System.Linq
@model Webkho_20241021.Models.ExcelFile
@{
    ViewData["Title"] = "Chi tiết file Excel";
    Layout = "~/Areas/QuanLiDuAn/Views/Layout/Layout.cshtml";
    var yeucau = ViewBag.Yeucau as Webkho_20241021.Models.yeucau;
    var duan = ViewBag.Duan as Webkho_20241021.Models.duans;
    var vtyeucau = ViewBag.VTYeucau as List<Webkho_20241021.Models.vtyeucau> ?? new List<Webkho_20241021.Models.vtyeucau>();
    
    var invalidFileChars = System.IO.Path.GetInvalidFileNameChars();
    Func<string, string> sanitizeFileName = value =>
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return new string(value
            .Select(ch => invalidFileChars.Contains(ch) ? '_' : ch)
            .ToArray());
    };
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chi tiết file Excel</title>
    <link rel="stylesheet" href="~/css/ChiTietFileExcel.css" />
</head>
<body>
    <div class="bodyyeucau">
        <a href="@Url.Action("DanhSachFileExcel", "Yeucau", new { area = "QuanLiDuAn" })" class="btn-back">← Quay lại</a>

        @if (!string.IsNullOrEmpty(Model.DuongDanFile))
        {
            var originalNameRaw = string.IsNullOrWhiteSpace(Model.TenFile)
                ? $"File_{Model.ID}"
                : System.IO.Path.GetFileNameWithoutExtension(Model.TenFile);
            var originalName = sanitizeFileName(originalNameRaw);
            if (string.IsNullOrEmpty(originalName))
            {
                originalName = $"File_{Model.ID}";
            }
            var originalExt = System.IO.Path.GetExtension(Model.TenFile);
            if (string.IsNullOrWhiteSpace(originalExt))
            {
                originalExt = ".xlsx";
            }
            var uploaderName = sanitizeFileName(Model.NguoiUpload ?? "nguoi_upload");
            if (string.IsNullOrEmpty(uploaderName))
            {
                uploaderName = "nguoi_upload";
            }
            var downloadName = $"{originalName}_{uploaderName}{originalExt}";

            <a href="@Model.DuongDanFile"
               target="_blank"
               download="@downloadName"
               class="btn-download">📥 Tải file Excel</a>
        }

        <div class="info-container">
            <div class="info-section">
                <h3>📄 Thông tin file</h3>
                <div class="info-row">
                    <span class="info-label">Tên file:</span>
                    <span>@Model.TenFile</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Ngày upload:</span>
                    <span>@(Model.NgayUpload?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Người upload:</span>
                    <span>@Model.NguoiUpload</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Kích thước:</span>
                    <span>@((Model.KichThuocFile ?? 0) / 1024) KB</span>
                </div>
            </div>

            @if (yeucau != null)
            {
                <div class="info-section">
                    <h3>📋 Thông tin yêu cầu</h3>
                    <div class="info-row">
                        <span class="info-label">Mã yêu cầu:</span>
                        <span>@yeucau.MaYeucau</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Tên yêu cầu:</span>
                        <span>@yeucau.TenYeucau</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Người yêu cầu:</span>
                        <span>@yeucau.NguoiYeucau</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Ngày yêu cầu:</span>
                        <span>@(yeucau.NgayYeucau?.ToString("dd/MM/yyyy") ?? "N/A")</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Trạng thái:</span>
                        <span>@yeucau.TrangThai</span>
                    </div>
                </div>
            }
        </div>

        @if (duan != null)
        {
            <div class="info-section full-width">
                <h3>🏗️ Thông tin dự án</h3>
                <div class="info-row">
                    <span class="info-label">Mã dự án:</span>
                    <span>@duan.MaDuan</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Tên dự án:</span>
                    <span>@duan.TenDuan</span>
                </div>
            </div>
        }

        <div class="info-section full-width">
            <h3>📦 Danh sách vật tư trong file (@vtyeucau.Count vật tư)</h3>
            <div class="table-container">
                <table class="table">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Tên thiết bị/hàng hóa</th>
                            <th>Mã VT</th>
                            <th>Hãng SX</th>
                            <th>ĐV</th>
                            <th>SL</th>
                            <th>Nhà CC</th>
                            <th>Ngày cần</th>
                            <th>Ngày có hàng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int stt = 1;
                        }
                        @foreach (var vt in vtyeucau)
                        {
                            <tr>
                                <td>@stt</td>
                                <td>@vt.TenSanpham</td>
                                <td>@vt.MaSanpham</td>
                                <td>@vt.HangSX</td>
                                <td>@vt.DonVi</td>
                                <td>@vt.SL</td>
                                <td>@vt.NhaCC</td>
                                <td>@(vt.NgayCanHang?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                <td>@(vt.NgayCoHang?.ToString("dd/MM/yyyy") ?? "-")</td>
                            </tr>
                            stt++;
                        }
                        @if (vtyeucau.Count == 0)
                        {
                            <tr>
                                <td colspan="9">
                                    Không có vật tư nào trong file này.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>