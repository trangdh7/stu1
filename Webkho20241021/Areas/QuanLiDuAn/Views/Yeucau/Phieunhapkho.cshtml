@{
    ViewData["Title"] = "Phieunhapkho";
    Layout = "~/Areas/QuanLiDuAn/Views/Layout/Layout.cshtml";
}
@model Webkho_20241021.Areas.QuanLiDuAn.Data.Phieunhapkhoviewmodel
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Phiếu nhập kho</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>

    <nav class="bodyyeucau">
        <div class="menu-kho">
            <ul class="timkiem">
                <li class="menu-yeucau">
                    <a href="/QuanLiDuAn/Yeucau/Yeucau">Vật tư yêu cầu</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-muahang">
                    <a href="/QuanLiDuAn/Yeucau/Phieumuahang">Vật tư mua hàng</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>

                <li class="menu-nhapkho">
                    <a href="/QuanLiDuAn/Yeucau/Phieunhapkho">Phiếu nhập kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-xuatkho">
                    <a href="/QuanLiDuAn/Yeucau/Phieuxuatkho">Phiếu xuất kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
            </ul>
            <ul>
                <input type="text" id="timkiem" name="Timkiem" placeholder="Tìm kiếm" />
            </ul>
        </div>

        <div class="Tableyeucau">
            <table class="table">
                <thead>
                    <tr>
                        <td>STT</td>
                        <td>Mã nhập kho</td>
                        <td>Mã yêu cầu</td>
                        <td>Mã dự án</td>
                        <td>Người yêu cầu</td>
                        <td>Ngày nhập kho</td>
                        <td>Trạng thái</td>
                        <td>Thao tác</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int STT = 1;
                    }
                    @foreach (var item in Model.Phieunhapkho)
                    {
                        // Chỉ hiển thị phiếu có MaYeucau bắt đầu bằng NHAPKHO_DUAN_ hoặc NHAPKHO_CANHAN
                        // Ẩn các phiếu có format cũ (dạng số + chữ như "171125 251201STUP12.5 QUYNHTT1")
                        bool isNhapKhoDuanOrCaNhan = !string.IsNullOrEmpty(item.MaYeucau) && 
                                                      (item.MaYeucau.StartsWith("NHAPKHO_DUAN_", StringComparison.OrdinalIgnoreCase) || 
                                                       item.MaYeucau.StartsWith("NHAPKHO_CANHAN", StringComparison.OrdinalIgnoreCase));
                        
                        if (!isNhapKhoDuanOrCaNhan)
                        {
                            continue; // Bỏ qua phiếu không phải dạng NHAPKHO_DUAN_ hoặc NHAPKHO_CANHAN
                        }
                        
                        string ChucvuSession = Context.Session.GetString("Chucvu");
                        string BophanSession = Context.Session.GetString("Bophan");
                        <tr class="clickable-row" data-manhapkho="@item.MaNhapkho" onclick="showVTnhapkho('@item.MaNhapkho')" style="cursor: pointer;">
                            <td>@STT</td>
                            <td>
                                <a href="javascript:void(0);" onclick="showVTnhapkho('@item.MaNhapkho')">
                                    @item.MaNhapkho
                                </a>
                            </td>
                            <td>@item.MaYeucau</td>
                            <td>@item.MaDuan</td>
                            <td>@item.MaNguoidung</td>
                            <td>@item.NgayNhapkho?.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span>@item.TrangThai</span>
                            </td>
                            <td>
                                @if (item.TrangThai == "Đã nhập kho")
                                {
                                    @* Kiểm tra xem có phải phiếu nhập kho hoàn trả không (NHAPKHO_DUAN, NHAPKHO_CANHAN) và thuộc về user hiện tại *@
                                    string currentUserId = Context.Session.GetString("MaNguoidung");
                                    
                                    bool belongsToCurrentUser = false;
                                    if (isNhapKhoDuanOrCaNhan && !string.IsNullOrEmpty(currentUserId))
                                    {
                                        // Kiểm tra nếu MaYeucau chứa MaNguoidung của user hiện tại
                                        belongsToCurrentUser = item.MaYeucau.Contains(currentUserId, StringComparison.OrdinalIgnoreCase) ||
                                                               (!string.IsNullOrEmpty(item.MaNguoidung) && item.MaNguoidung.Equals(currentUserId, StringComparison.OrdinalIgnoreCase));
                                    }
                                    
                                    if (isNhapKhoDuanOrCaNhan && belongsToCurrentUser)
                                    {
                                        @* Phiếu nhập kho hoàn trả của user hiện tại → In phiếu trả hàng *@
                                        <a href="@Url.Action("InPhietrahang", "Yeucau", new { area = "QuanLiDuAn", MaNhapkho = item.MaNhapkho })"
                                           target="_blank"
                                           class="btn-icon"
                                           title="In phiếu trả hàng"
                                           onclick="event.stopPropagation();">
                                            <i class="bx bx-printer"></i>
                                        </a>
                                    }
                                }
                            </td>
                        </tr>
                        STT++;
                    }
                </tbody>
            </table>
        </div>
        <div class="action">
            <ul class="hanhdong">
                <li>
                    <a href="/QuanLiDuAn/Yeucau/ThemPhieunhapkho">Thêm phiếu nhập kho</a>
                </li>
            </ul>
        </div>
    </nav>
    <nav class="bodyyeucau-thietbi">
        <div id="phieunhapkho-header" class="yeucau-info" style="margin-bottom: 10px; padding: 10px; background-color: #f0f0f0; border-radius: 5px; display: none;">
            <strong id="phieunhapkho-header-text"></strong>
        </div>
        <div class="Tableyeucau-thietbi-box">
            <table class="tablethietbi">
                <thead>
                    <tr>
                        <td>STT</td>
                        <td>Tên vật tư</td>
                        <td>Mã vật tư</td>
                        <td>Mã kho</td>
                        <td>Hãng SX</td>
                        <td>Nhà cung cấp</td>
                        <td>Số lượng</td>
                        <td>Đơn vị</td>
                        <td>Trạng thái</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int ST = 1;
                    }
                    @foreach (var item in Model.VTphieunhapkho)
                    {
                        <tr>
                            <td>@ST</td>
                            <td>@item.TenSanpham</td>
                            <td>@item.MaSanpham</td>
                            <td>@item.Makho</td>
                            <td>@item.HangSX</td>
                            <td>@item.NhaCC</td>
                            <td>@item.SL</td>
                            <td>@item.DonVi</td>
                        </tr>
                        ST++;
                    }
                </tbody>
            </table>
        </div>
        @* Ẩn nút Duyệt và Từ chối cho QuanLiDuAn - chức năng này được chuyển sang trang Yeucau/Yeucau *@
        <div style="text-align: right; padding: 20px 20px 0 0;">
            @* Nút Duyệt và Từ chối đã được ẩn - chức năng này được xử lý ở trang Yeucau/Yeucau với nút Xác nhận *@
        </div>
        @{
            // Kiểm tra xem người dùng có phải là QLDA không
            var maNguoiDung = Context.Session.GetString("MaNguoidung");
            var isQLDA = false;
            if (Model.Duans != null && Model.Phieunhapkho != null)
            {
                // Kiểm tra xem có phiếu nhập kho nào thuộc dự án mà người dùng là QLDA không
                foreach (var item in Model.Phieunhapkho)
                {
                    if (!string.IsNullOrEmpty(item.MaDuan))
                    {
                        var duan = Model.Duans.FirstOrDefault(d => d.MaDuan == item.MaDuan);
                        if (duan != null && duan.MaNguoiQLDA == maNguoiDung)
                        {
                            isQLDA = true;
                            break;
                        }
                    }
                }
            }
        }

    </nav>
    @inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
    @{
        var requestToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    }
    <input type="hidden" id="RequestVerificationToken" name="__RequestVerificationToken" value="@requestToken" />
    <script>
        // Truyền thông tin session vào JavaScript
        var userChucvu = '@Context.Session.GetString("Chucvu")' || '';
        var userBophan = '@Context.Session.GetString("Bophan")' || '';
    </script>
    <script src="~/js/phieunhapkho.js"></script>
    <script>
        $(document).ready(function () {
            if (typeof getThongbaoData === 'function') {
                getThongbaoData();
            }

            // Chức năng tìm kiếm
            $('#timkiem').on('keyup', function() {
                var value = $(this).val().toLowerCase();
                $('.table tbody tr').filter(function() {
                    var match = false;
                    $(this).find('td').each(function() {
                        var text = $(this).text().toLowerCase();
                        if (text.indexOf(value) > -1) {
                            match = true;
                            return false; // break loop
                        }
                    });
                    $(this).toggle(match);
                });
            });

            // Xử lý nút Duyệt
            $('#btn-duyet').on('click', function() {
                if (!selectedManhapkho) {
                    alert("Vui lòng chọn phiếu nhập kho trước.");
                    return;
                }

                if (!confirm("Bạn có chắc chắn muốn duyệt phiếu nhập kho " + selectedManhapkho + "?")) {
                    return;
                }

                submitPhieunhapkhoAction('approve');
            });

            // Xử lý nút Từ chối
            $('#btn-tuchoi').on('click', function() {
                if (!selectedManhapkho) {
                    alert("Vui lòng chọn phiếu nhập kho trước.");
                    return;
                }

                if (!confirm("Bạn có chắc chắn muốn từ chối phiếu nhập kho " + selectedManhapkho + "?")) {
                    return;
                }

                submitPhieunhapkhoAction('reject');
            });

            // Hàm submit action
            function submitPhieunhapkhoAction(action) {
                const pathSegments = window.location.pathname.split('/');
                const area = pathSegments.length > 1 ? pathSegments[1] : '';
                const url = `/${area}/Yeucau/Xuliphieunhapkho`;

                // Tạo form để submit
                const form = $('<form>', {
                    method: 'POST',
                    action: url
                });

                form.append($('<input>', {
                    type: 'hidden',
                    name: 'MaNhapkho',
                    value: selectedManhapkho
                }));

                form.append($('<input>', {
                    type: 'hidden',
                    name: 'submitAction',
                    value: action
                }));

                // Thêm token chống CSRF
                const token = $('#RequestVerificationToken').val() || $('input[name="__RequestVerificationToken"]').val();
                if (token) {
                    form.append($('<input>', {
                        type: 'hidden',
                        name: '__RequestVerificationToken',
                        value: token
                    }));
                }

                $('body').append(form);
                form.submit();
            }

            // Lưu hàm vào global scope để có thể gọi từ phieunhapkho.js
            window.submitPhieunhapkhoAction = submitPhieunhapkhoAction;

            // Ẩn các nút khi trang tải
            $('#btn-duyet').hide();
            $('#btn-tuchoi').hide();
        });
    </script>
</body>
</html>









