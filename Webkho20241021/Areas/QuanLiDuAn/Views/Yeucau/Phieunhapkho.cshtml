
@{
    ViewData["Title"] = "Phieunhapkho";
    Layout = "~/Areas/QuanLiDuAn/Views/Layout/Layout.cshtml";
}
@model Webkho_20241021.Areas.QuanLiDuAn.Data.Phieunhapkhoviewmodel
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Phiếu nhập kho</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>

    <nav class="bodyyeucau">
        <div class="menu-kho">
            <ul class="timkiem">
                <li class="menu-yeucau">
                    <a href="/QuanLiDuAn/Yeucau/Yeucau">Vật tư yêu cầu</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-muahang">
                    <a href="/QuanLiDuAn/Yeucau/Phieumuahang">Vật tư mua hàng</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>

                <li class="menu-nhapkho">
                    <a href="/QuanLiDuAn/Yeucau/Phieunhapkho">Phiếu nhập kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-xuatkho">
                    <a href="/QuanLiDuAn/Yeucau/Phieuxuatkho">Phiếu xuất kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
            </ul>
            <ul>
                <input type="text" id="timkiem" name="Timkiem" placeholder="Tìm kiếm" />
            </ul>
        </div>

        <div class="Tableyeucau">
            <table class="table">
                <thead>
                    <tr>
                        <td>STT</td>
                        <td>Mã nhập kho</td>
                        <td>Mã yêu cầu</td>
                        <td>Mã dự án</td>
                        <td>Người yêu cầu</td>
                        <td>Ngày nhập kho</td>
                        <td>Trạng thái</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int STT = 1;
                    }
                    @foreach (var item in Model.Phieunhapkho)
                    {
                        string ChucvuSession = Context.Session.GetString("Chucvu");
                        string BophanSession = Context.Session.GetString("Bophan");
                        <tr class="clickable-row" data-manhapkho="@item.MaNhapkho" onclick="showVTnhapkho('@item.MaNhapkho')" style="cursor: pointer;">
                            <td>@STT</td>
                            <td>
                                <a href="javascript:void(0);" onclick="showVTnhapkho('@item.MaNhapkho')">
                                    @item.MaNhapkho
                                </a>
                            </td>
                            <td>@item.MaYeucau</td>
                            <td>@item.MaDuan</td>
                            <td>@item.MaNguoidung</td>
                            <td>@item.NgayNhapkho?.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span>@item.TrangThai</span>
                            </td>
                        </tr>
                        STT++;
                    }
                </tbody>
            </table>
        </div>
        <div class="action">
            <ul class="hanhdong">
                <li>
                    <a href="/QuanLiDuAn/Yeucau/ThemPhieunhapkho">Thêm phiếu nhập kho</a>
                </li>
            </ul>
        </div>
    </nav>
    <nav class="bodyyeucau-thietbi">
        <div id="phieunhapkho-header" class="yeucau-info" style="margin-bottom: 10px; padding: 10px; background-color: #f0f0f0; border-radius: 5px; display: none;">
            <strong id="phieunhapkho-header-text"></strong>
        </div>
        <div class="Tableyeucau-thietbi-box">
            <table class="tablethietbi">
                <thead>
                    <tr>
                        <td>STT</td>
                        <td>Tên vật tư</td>
                        <td>Mã vật tư</td>
                        <td>Mã kho</td>
                        <td>Hãng SX</td>
                        <td>Nhà cung cấp</td>
                        <td>Số lượng</td>
                        <td>Đơn vị</td>
                        <td>Trạng thái</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int ST = 1;
                    }
                    @foreach (var item in Model.VTphieunhapkho)
                    {
                        <tr>
                            <td>@ST</td>
                            <td>@item.TenSanpham</td>
                            <td>@item.MaSanpham</td>    
                            <td>@item.Makho</td>
                            <td>@item.HangSX</td>
                            <td>@item.NhaCC</td>
                            <td>@item.SL</td>
                            <td>@item.DonVi</td>
                        </tr>
                        ST++;
                    }
                </tbody>
            </table>
        </div>
        @{
            // Kiểm tra xem người dùng có phải là QLDA không
            var maNguoiDung = Context.Session.GetString("MaNguoidung");
            var isQLDA = false;
            if (Model.Duans != null && Model.Phieunhapkho != null)
            {
                // Kiểm tra xem có phiếu nhập kho nào thuộc dự án mà người dùng là QLDA không
                foreach (var item in Model.Phieunhapkho)
                {
                    if (!string.IsNullOrEmpty(item.MaDuan))
                    {
                        var duan = Model.Duans.FirstOrDefault(d => d.MaDuan == item.MaDuan);
                        if (duan != null && duan.MaNguoiQLDA == maNguoiDung)
                        {
                            isQLDA = true;
                            break;
                        }
                    }
                }
            }
        }
        <div id="approve-buttons-container" style="display: none; text-align: right; margin-top: 20px; padding-right: 20px;" data-is-qlda="@(isQLDA ? "true" : "false")">
            <form asp-action="Xuliphieunhapkho" asp-controller="Yeucau" asp-area="QuanLiDuAn" method="post" id="form-approve-phieunhapkho">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MaNhapkho" id="hidden-manhapkho" value="" />
                <button type="submit" name="action" value="approve" class="btn btn-success" style="margin-right: 10px; padding: 10px 20px; font-size: 16px; background-color: #28a745; border-color: #28a745; color: white;">
                    <i class="bx bxs-check-circle"></i> Duyệt
                </button>
                <button type="submit" name="action" value="reject" class="btn btn-danger" style="padding: 10px 20px; font-size: 16px; background-color: #dc3545; border-color: #dc3545; color: white;">
                    <i class="bx bxs-x-circle"></i> Từ chối
                </button>
            </form>
        </div>
    </nav>
    <script src="~/js/phieunhapkho.js"></script>
    <script>
        $(document).ready(function () {
            getThongbaoData();
        });

        // Hàm để cập nhật hiển thị nút duyệt dựa trên trạng thái
        function updateApproveButtons(manhapkho, trangThai) {
            console.log("[QLDA DEBUG] updateApproveButtons called:", { manhapkho, trangThai });
            
            // Kiểm tra xem người dùng có phải là QLDA không
            var isQLDA = $('#approve-buttons-container').data('is-qlda') === true || $('#approve-buttons-container').data('is-qlda') === 'true';
            console.log("[QLDA DEBUG] isQLDA:", isQLDA);
            
            // Kiểm tra xem phiếu nhập kho có thuộc dự án mà người dùng là QLDA không
            var maDuan = "";
            $('.table tbody tr').each(function () {
                const link = $(this).find('td').eq(1).find('a');
                const linkText = link.length > 0 ? link.text().trim() : $(this).find('td').eq(1).text().trim();
                if (linkText === manhapkho) {
                    maDuan = $(this).find('td').eq(3).text().trim();
                    return false;
                }
            });
            console.log("[QLDA DEBUG] maDuan:", maDuan);
            
            // Chỉ hiển thị nút nếu:
            // 1. Trạng thái là "Chờ quản lý dự án duyệt"
            // 2. Người dùng là QLDA (đã kiểm tra ở server-side)
            // 3. Phiếu có mã dự án (không phải cá nhân)
            var shouldShow = trangThai === "Chờ quản lý dự án duyệt" && isQLDA && maDuan && maDuan.trim() !== "";
            console.log("[QLDA DEBUG] shouldShow:", shouldShow, {
                trangThaiMatch: trangThai === "Chờ quản lý dự án duyệt",
                isQLDA: isQLDA,
                hasMaDuan: maDuan && maDuan.trim() !== ""
            });
            
            if (shouldShow) {
                $('#hidden-manhapkho').val(manhapkho);
                $('#approve-buttons-container').show();
                console.log("[QLDA DEBUG] Buttons shown for:", manhapkho);
            } else {
                $('#approve-buttons-container').hide();
                console.log("[QLDA DEBUG] Buttons hidden");
            }
        }

        // Override hàm showVTnhapkho để cập nhật nút duyệt
        var originalShowVTnhapkho = window.showVTnhapkho;
        window.showVTnhapkho = function(Manhapkho) {
            if (originalShowVTnhapkho) {
                originalShowVTnhapkho(Manhapkho);
            }
            
            // Lấy trạng thái từ hàng được chọn
            var trangThai = "";
            $('.table tbody tr').each(function () {
                const link = $(this).find('td').eq(1).find('a');
                const linkText = link.length > 0 ? link.text().trim() : $(this).find('td').eq(1).text().trim();
                if (linkText === Manhapkho) {
                    const trangThaiCell = $(this).find('td').eq(6);
                    trangThai = trangThaiCell.find('span').text().trim() || trangThaiCell.text().trim();
                    return false;
                }
            });
            
            updateApproveButtons(Manhapkho, trangThai);
        };

        // Thêm event handler cho form submit để debug
        $('#form-approve-phieunhapkho').on('submit', function(e) {
            var manhapkho = $('#hidden-manhapkho').val();
            var action = $('button[type="submit"]:focus').attr('name') === 'action' ? $('button[type="submit"]:focus').val() : 'approve';
            console.log("[QLDA DEBUG] Form submit triggered:", { manhapkho, action });
            console.log("[QLDA DEBUG] Form action URL:", $(this).attr('action'));
            console.log("[QLDA DEBUG] Form method:", $(this).attr('method'));
            
            if (!manhapkho || manhapkho.trim() === '') {
                console.error("[QLDA DEBUG] ERROR: MaNhapkho is empty!");
                alert('Lỗi: Mã nhập kho không được để trống!');
                e.preventDefault();
                return false;
            }
        });
    </script>
</body>
</html>










