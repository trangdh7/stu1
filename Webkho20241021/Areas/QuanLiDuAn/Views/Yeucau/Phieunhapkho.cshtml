
@{
    ViewData["Title"] = "Phieunhapkho";
    Layout = "~/Areas/QuanLiDuAn/Views/Layout/Layout.cshtml";
}
@model Webkho_20241021.Areas.QuanLiDuAn.Data.Phieunhapkhoviewmodel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>yeucau</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>

    <nav class="bodyyeucau">
        <div class="menu-kho">
            <ul class="timkiem">
                <li class="menu-yeucau">
                    <a href="/QuanLiDuAn/Yeucau/Yeucau">Chua duy?t</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-xuatkho">
                    <a href="/QuanLiDuAn/Yeucau/Phieuxuatkho">Phi?u xu?t kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-nhapkho">
                    <a href="/QuanLiDuAn/Yeucau/Phieunhapkho">Phi?u nh?p kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-muahang">
                    <a href="/QuanLiDuAn/Yeucau/Phieumuahang">Phi?u mua hàng</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
            </ul>
            <ul>
                <input type="text" id="timkiem" name="Timkiem" placeholder="Tìm ki?m" />
            </ul>
        </div>

        <div class="Tableyeucau">
            <table class="table">
                <thead>
                    <tr>
                        <td>STT</td>
                        <td>Mã xu?t kho</td>
                        <td>Mã yêu c?u</td>
                        <td>Mã d? án</td>
                        <td>Ngu?i yêu c?u</td>
                        <td>Ngày nh?p kho</td>
                        <td>Tr?ng thái</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int STT = 1;
                    }
                    @foreach (var item in Model.Phieunhapkho)
                    {
                        string ChucvuSession = Context.Session.GetString("Chucvu");
                        string BophanSession = Context.Session.GetString("Bophan");
                        <tr>
                            <td>@STT</td>
                            <td>
                                <a href="javascript:void(0);" onclick="showVTnhapkho('@item.MaNhapkho')">
                                    @item.MaNhapkho
                                </a>
                            </td>
                            <td>@item.MaYeucau</td>
                            <td>@item.MaDuan</td>
                            <td>@item.MaNguoidung</td>
                            <td>@item.NgayNhapkho?.ToString("dd/MM/yyyy")</td>
                            <td>
                                @{
                                    // Hi?n th? tr?ng thái và nút duy?t theo quy?n
                                    var duan = Model.Duans?.FirstOrDefault(d => d.MaDuan == item.MaDuan);
                                    var maQLDA = duan?.MaNguoiQLDA;
                                    var isQLDA = !string.IsNullOrEmpty(maQLDA) && maQLDA == Context.Session.GetString("MaNguoidung");
                                    var isGiamDoc = ChucvuSession == "Giám d?c";
                                    var isKho = BophanSession == "BP kho";
                                }
                                
                                @if (item.TrangThai == "Qu?n lí d? án" && isQLDA)
                                {
                                    @using (Html.BeginForm("Xuliphieunhapkho", "Yeucau", new { area = "QuanLiDuAn" }, FormMethod.Post))
                                    {
                                        <input type="hidden" name="MaNhapkho" value="@item.MaNhapkho" />
                                        <button type="submit" name="action" value="approve" class="btn-icon approve-btn" title="Duy?t">
                                            <i class="bx bxs-check-circle"></i>
                                        </button>
                                        <button type="submit" name="action" value="reject" class="btn-icon reject-btn" title="T? ch?i">
                                            <i class="bx bxs-x-circle"></i>
                                        </button>
                                    }
                                }
                                else if (item.TrangThai == "Giám d?c" && isGiamDoc)
                                {
                                    @using (Html.BeginForm("Xuliphieunhapkho", "Yeucau", new { area = "QuanLiDuAn" }, FormMethod.Post))
                                    {
                                        <input type="hidden" name="MaNhapkho" value="@item.MaNhapkho" />
                                        <button type="submit" name="action" value="approve" class="btn-icon approve-btn" title="Duy?t">
                                            <i class="bx bxs-check-circle"></i>
                                        </button>
                                        <button type="submit" name="action" value="reject" class="btn-icon reject-btn" title="T? ch?i">
                                            <i class="bx bxs-x-circle"></i>
                                        </button>
                                    }
                                }
                                else if (item.TrangThai == "Ch? nh?p kho" && isKho)
                                {
                                    @using (Html.BeginForm("Xuliphieunhapkho", "Yeucau", new { area = "QuanLiDuAn" }, FormMethod.Post))
                                    {
                                        <input type="hidden" name="MaNhapkho" value="@item.MaNhapkho" />
                                        <button type="submit" name="action" value="approve" class="btn-icon approve-btn" title="Xác nh?n nh?p kho">
                                            <i class="bx bxs-check-circle"></i>
                                        </button>
                                    }
                                }
                                else
                                {
                                    <span>@item.TrangThai</span>
                                }
                            </td>
                        </tr>
                        STT++;
                    }
                </tbody>
            </table>
        </div>
        <div class="action">
            <ul class="hanhdong">
                <li>
                    <a href="/QuanLiDuAn/Yeucau/ThemPhieunhapkho">Thêm phi?u nh?p kho</a>
                </li>
            </ul>
        </div>
    </nav>
    <nav class="bodyyeucau-thietbi">
        <div class="Tableyeucau-thietbi-box">
            <table class="tablethietbi">
                <thead>
                    <tr>
                        <td>STT</td>
                        <td>Tên v?t tu</td>
                        <td>Mã v?t tu</td>
                        <td>Mã kho</td>
                        <td>Hãng sx</td>
                        <td>Nhà cung c?p</td>
                        <td>S? lu?ng</td>
                        <td>Ðon v?</td>
                        <td>Tr?ng thái</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int ST = 1;
                    }
                    @foreach (var item in Model.VTphieunhapkho)
                    {
                        <tr>
                            <td>@ST</td>
                            <td>@item.TenSanpham</td>
                            <td>@item.MaSanpham</td>    
                            <td>@item.Makho</td>
                            <td>@item.HangSX</td>
                            <td>@item.NhaCC</td>
                            <td>@item.SL</td>
                            <td>@item.DonVi</td>
                        </tr>
                        ST++;
                    }
                </tbody>
            </table>
        </div>
    </nav>
    <script src="~/js/phieunhapkho.js"></script>
    <script>
        $(document).ready(function () {
            getThongbaoData();
        });
    </script>
</body>
</html>










