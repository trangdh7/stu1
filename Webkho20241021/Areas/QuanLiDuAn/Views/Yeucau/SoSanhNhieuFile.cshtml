@{
    ViewData["Title"] = "So sánh yêu cầu";
    Layout = "~/Areas/QuanLiDuAn/Views/Layout/Layout.cshtml";
    var yeucauList = ViewBag.YeucauList as List<Webkho_20241021.Models.yeucau>;
    var vatTuComparison = ViewBag.VatTuComparison as List<Webkho_20241021.Models.VatTuComparisonViewModel>;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>So sánh yêu cầu</title>

    <!-- CSS tách riêng -->
    <link rel="stylesheet" href="~/css/so-sanh-excel.css" />
</head>
<body>
    <div class="bodyyeucau">
        <a href="@Url.Action("DanhSachFileExcel", "Yeucau", new { area = "QuanLiDuAn" })" class="btn-back">
            ← Quay lại danh sách
        </a>

        <div class="header-section">
            <h2>So sánh yêu cầu</h2>
            
            <div class="header-content">
                <div class="header-stat">
                    <strong>Số yêu cầu được so sánh:</strong>
                    <span>@(yeucauList?.Count ?? 0)</span>
                </div>
            </div>

            <ul class="file-list">
                @foreach (var yeucau in yeucauList ?? new List<Webkho_20241021.Models.yeucau>())
                {
                    <li>
                        <strong>@yeucau.TenYeucau</strong>
                        <div>Mã YC: <strong>@yeucau.MaYeucau</strong> • @(yeucau.NgayYeucau?.ToString("dd/MM/yyyy HH:mm") ?? "")</div>
                    </li>
                }
            </ul>

            <div class="header-note">
                <small>
                    ℹ️ <strong>Ghi chú:</strong> 
                    <br />• <strong>"Đã xuất kho":</strong> Tổng số lượng vật tư đã được xuất kho.
                    <br />• <strong>"Tồn đọng":</strong> Số lượng vật tư còn lại chưa được cấp phát = Tổng SL - Đã xuất kho
                    <br />• <strong>"Dư":</strong> Số lượng dư thừa khi Đã xuất kho nhiều hơn tổng số lượng yêu cầu = Đã xuất kho - Tổng SL
                </small>
            </div>
        </div>

        @if (vatTuComparison != null && vatTuComparison.Any())
        {
            <div class="summary-box">
                <h3>📊 Tóm tắt</h3>
                <div class="summary-grid">
                    <div class="summary-item">
                        <strong>Tổng loại vật tư</strong>
                        <p>@vatTuComparison.Count</p>
                    </div>
                    <div class="summary-item">
                        <strong>Tổng số lượng</strong>
                        <p>@vatTuComparison.Sum(v => v.TongSL)</p>
                    </div>
                    <div class="summary-item">
                        <strong>Tồn đọng</strong>
                        <p>@ViewBag.TotalTonDong</p>
                    </div>
                    <div class="summary-item">
                        <strong>Tổng dư</strong>
                        <p>@ViewBag.TotalDu</p>
                    </div>
                </div>
            </div>

            <div class="table-container">
                <table class="table">
                    <thead>
                        <tr>
                            <th class="vat-tu-column">Mã VT</th>
                            <th class="vat-tu-column">Tên thiết bị/hàng hóa</th>
                            <th class="vat-tu-column">Hãng SX</th>
                            <th class="vat-tu-column">ĐV</th>
                            @foreach (var yeucau in yeucauList ?? new List<Webkho_20241021.Models.yeucau>())
                            {
                                <th class="file-column">
                                    @yeucau.TenYeucau<br />
                                    <small>@(yeucau.NgayYeucau?.ToString("dd/MM/yyyy") ?? "")</small>
                                </th>
                            }
                            <th class="vat-tu-column col-tong-sl">Tổng SL</th>
                            <th class="vat-tu-column col-da-cap-phat">Đã xuất kho</th>
                            <th class="vat-tu-column">Tồn đọng</th>
                            <th class="vat-tu-column">Dư</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var vatTu in vatTuComparison)
                        {
                            <tr>
                                <td class="vat-tu-column">@(vatTu.MaSanpham ?? "-")</td>
                                <td class="vat-tu-column">@(vatTu.TenSanpham ?? "-")</td>
                                <td class="vat-tu-column">@(vatTu.HangSX ?? "-")</td>
                                <td class="vat-tu-column">@(vatTu.DonVi ?? "-")</td>

                                @{
                                    var quantities = new List<int>();
                                    foreach (var yeucau in yeucauList ?? new List<Webkho_20241021.Models.yeucau>())
                                    {
                                        var chiTiet = vatTu.ChiTiet?.FirstOrDefault(c => c.MaYeucau == yeucau.MaYeucau);
                                        var sl = chiTiet != null ? chiTiet.SL : 0;
                                        quantities.Add(sl);
                                    }
                                    var hasDifference = quantities.Distinct().Count() > 1;

                                    foreach (var yeucau in yeucauList ?? new List<Webkho_20241021.Models.yeucau>())
                                    {
                                        var chiTiet = vatTu.ChiTiet?.FirstOrDefault(c => c.MaYeucau == yeucau.MaYeucau);
                                        var sl = chiTiet != null ? chiTiet.SL : 0;

                                        var cellClass = "file-column";
                                        if (sl == 0) cellClass += " zero-value";
                                        else if (hasDifference) cellClass += " diff-highlight";

                                        <td class="@cellClass" style="text-align: center;">@sl</td>
                                    }
                                }

                                <td class="col-tong-sl" style="text-align: center;">@vatTu.TongSL</td>
                                <td class="col-da-cap-phat" style="text-align: center;">@vatTu.CapPhat</td>
                                <td style="text-align: center;">@vatTu.TonDong</td>
                                <td style="text-align: center;">
                                    @vatTu.Du
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <p>✨ Không có dữ liệu để so sánh.</p>
            </div>
        }
    </div>
</body>
</html>
