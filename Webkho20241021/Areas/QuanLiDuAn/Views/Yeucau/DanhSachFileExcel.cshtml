@using System.IO
@using System.Linq
@model List<Webkho_20241021.Models.yeucau>
@{
    ViewData["Title"] = "So sánh yêu cầu";
    Layout = "~/Areas/QuanLiDuAn/Views/Layout/Layout.cshtml";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>So sánh yêu cầu</title>
    <link rel="stylesheet" href="~/css/danhsachfileexcel.css"/>
</head>
<body>
    <div class="bodyyeucau">
        <h2>So sánh yêu cầu</h2>

        @if (TempData["Success"] != null || TempData["Error"] != null)
        {
            <div class="alert @((TempData["Error"] != null) ? "alert-error" : "alert-success")" id="alertMessage">
                @(TempData["Error"] ?? TempData["Success"])
            </div>
        }

        @{
            var selectedMaDuan = ViewBag.MaDuan as string;
            var duanList = ViewBag.DuanList as List<Webkho_20241021.Models.duans>;
        }
        <div class="filter-section">
            <form method="get" action="@Url.Action("DanhSachFileExcel", "Yeucau", new { area = "QuanLiDuAn" })">
                <input type="text" name="q" placeholder="Tìm kiếm..." value="@ViewBag.Q" />
                <select name="maDuan">
                    <option value="" @(string.IsNullOrEmpty(selectedMaDuan) ? "selected" : "")>Tất cả dự án</option>
                    @if (duanList != null)
                    {
                        @foreach (var duan in duanList)
                        {
                            <option value="@duan.MaDuan" @(selectedMaDuan == duan.MaDuan ? "selected" : "")>@duan.MaDuan - @duan.TenDuan</option>
                        }
                    }
                </select>
                <button type="submit">Tìm kiếm</button>
                <a href="@Url.Action("DanhSachFileExcel", "Yeucau", new { area = "QuanLiDuAn" })" style="margin-left: 10px; color: #007bff;">Xóa bộ lọc</a>
            </form>
        </div>

        <div class="action-bar">
            <button type="button" class="select-all" onclick="toggleSelectAll()">Chọn tất cả</button>
            <button type="button" onclick="clearSelection()">Bỏ chọn</button>
            <span class="selected-count" id="selectedCount">Đã chọn: 0 yêu cầu</span>
            <button type="button" id="btnCompare" onclick="compareSelected()" disabled>So sánh các yêu cầu đã chọn</button>
        </div>

        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width: 50px;">
                            <input type="checkbox" id="selectAllCheckbox" onchange="toggleSelectAll()" />
                        </th>
                        <th>STT</th>
                        <th>Mã yêu cầu</th>
                        <th>Tên yêu cầu</th>
                        <th>Mã dự án</th>
                        <th>Người yêu cầu</th>
                        <th>Ngày yêu cầu</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int currentPage = ViewBag.Page ?? 1;
                        int pageSize = 10;
                        int stt = (currentPage - 1) * pageSize + 1;
                    }
                    @foreach (var yeucau in Model)
                    {
                        var duan = duanList?.FirstOrDefault(d => d.MaDuan == yeucau.YCMaDuan);
                        <tr>
                            <td>
                                <input type="checkbox" class="yeucau-checkbox" value="@yeucau.MaYeucau" onchange="updateSelectedCount()" />
                            </td>
                            <td>@stt</td>
                            <td>@yeucau.MaYeucau</td>
                            <td>@yeucau.TenYeucau</td>
                            <td>@(duan != null ? $"{yeucau.YCMaDuan} - {duan.TenDuan}" : yeucau.YCMaDuan)</td>
                            <td>@yeucau.NguoiYeucau</td>
                            <td>@(yeucau.NgayYeucau?.ToString("dd/MM/yyyy HH:mm") ?? "")</td>
                            <td>@yeucau.TrangThai</td>
                        </tr>
                        stt++;
                    }
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="8" style="text-align: center; padding: 20px;">
                                Không có yêu cầu nào được tìm thấy.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (ViewBag.TotalPages > 1)
        {
            <div class="pagination">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <a href="@Url.Action("DanhSachFileExcel", "Yeucau", new { area = "QuanLiDuAn", page = i, q = ViewBag.Q, maDuan = ViewBag.MaDuan })" 
                       class="@(ViewBag.Page == i ? "active" : "")">@i</a>
                }
            </div>
        }
    </div>

    <script>
        function toggleSelectAll() {
            const selectAllCheckbox = document.getElementById('selectAllCheckbox');
            const checkboxes = document.querySelectorAll('.yeucau-checkbox');
            const isChecked = selectAllCheckbox.checked;
            
            checkboxes.forEach(checkbox => {
                checkbox.checked = isChecked;
            });
            
            updateSelectedCount();
        }

        function clearSelection() {
            const checkboxes = document.querySelectorAll('.yeucau-checkbox');
            const selectAllCheckbox = document.getElementById('selectAllCheckbox');
            
            checkboxes.forEach(checkbox => {
                checkbox.checked = false;
            });
            selectAllCheckbox.checked = false;
            
            updateSelectedCount();
        }

        function updateSelectedCount() {
            const checkboxes = document.querySelectorAll('.yeucau-checkbox:checked');
            const count = checkboxes.length;
            const selectedCountEl = document.getElementById('selectedCount');
            const btnCompare = document.getElementById('btnCompare');
            
            selectedCountEl.textContent = `Đã chọn: ${count} yêu cầu`;
            
            if (count >= 2) {
                btnCompare.disabled = false;
            } else {
                btnCompare.disabled = true;
            }

            // Cập nhật checkbox "Chọn tất cả"
            const allCheckboxes = document.querySelectorAll('.yeucau-checkbox');
            const selectAllCheckbox = document.getElementById('selectAllCheckbox');
            if (allCheckboxes.length > 0) {
                selectAllCheckbox.checked = count === allCheckboxes.length;
            }
        }

        function compareSelected() {
            const checkboxes = document.querySelectorAll('.yeucau-checkbox:checked');
            const selectedMaYeucau = Array.from(checkboxes).map(cb => cb.value);
            
            if (selectedMaYeucau.length < 2) {
                alert('Vui lòng chọn ít nhất 2 yêu cầu để so sánh!');
                return;
            }
            
            // Chuyển đến trang so sánh với danh sách mã yêu cầu
            const idsParam = selectedMaYeucau.join(',');
            window.location.href = '@Url.Action("SoSanhNhieuFile", "Yeucau", new { area = "QuanLiDuAn" })?ids=' + encodeURIComponent(idsParam);
        }

        // Tự động ẩn thông báo sau 5 giây
        document.addEventListener('DOMContentLoaded', function() {
            const alertMessage = document.getElementById('alertMessage');
            if (alertMessage) {
                setTimeout(function() {
                    alertMessage.style.transition = 'opacity 0.5s ease';
                    alertMessage.style.opacity = '0';
                    setTimeout(function() {
                        alertMessage.style.display = 'none';
                    }, 500);
                }, 5000); // 5 giây
            }
        });
    </script>
</body>
</html>
