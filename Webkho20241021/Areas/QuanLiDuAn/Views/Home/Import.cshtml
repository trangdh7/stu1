@{
    ViewData["Title"] = "Import";
    Layout = "~/Areas/QuanLiDuAn/Views/Layout/Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Import V?t Tu</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.0/xlsx.full.min.js"></script>
    <script>
        function handleFileUpload(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    const sheetName = workbook.SheetNames[0];
                    const worksheet = workbook.Sheets[sheetName];
                    const jsonData = XLSX.utils.sheet_to_json(worksheet, { header: 1 });
                    populateTable(jsonData);
                };
                reader.readAsArrayBuffer(file);
            }
        }

        function formatExcelDateToDatetimeLocal(dateString) {
            // Ki?m tra n?u chu?i ngày không h?p l? ho?c r?ng
            if (!dateString) return '';

            // Gi? s? chu?i ngày có d?nh d?ng dd/MM/yyyy
            const [day, month, year] = dateString.split('/');

            if (day && month && year && day.length <= 2 && month.length <= 2) {
                // Ð?nh d?ng l?i theo `yyyy-MM-dd` d? dùng trong th? input
                return `${year}-${day.padStart(2, '0')}-${month.padStart(2, '0')}`;
            }

            return ''; // Tr? v? chu?i r?ng n?u không th? d?nh d?ng dúng
        }

        function populateTable(data) {
            const tbody = document.querySelector('.form-table tbody');
            tbody.innerHTML = ''; // Clear existing rows

            for (let i = 1; i < data.length; i++) { // Skip header row
                if (data[i].length <= 1) continue; // Skip rows with 1 or fewer columns

                const formattedNgayBaohanh = formatExcelDateToDatetimeLocal(data[i][7]);
                const formattedThoiGianBH = formatExcelDateToDatetimeLocal(data[i][8]);

                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${i}</td>
                    <td style="width: 20%;"><input type="text" name="TenSanpham" value="${data[i][1] || ''}" placeholder="Tên v?t tu" required /></td>
                    <td><input type="text" name="MaSanpham" value="${data[i][2] || ''}" placeholder="Mã v?t tu" required /></td>
                    <td><input type="text" name="HangSX" value="${data[i][3] || ''}" placeholder="Hãng SX" /></td>
                    <td><input type="text" name="NhaCC" value="${data[i][4] || ''}" placeholder="Nhà cung c?p" /></td>
                    <td><input type="number" name="SL" value="${data[i][5] || ''}" placeholder="S? lu?ng" required /></td>
                    <td><input type="text" name="DonVi" value="${data[i][6] || ''}" placeholder="Ðon v?" required /></td>
                    <td><input type="date" name="NgayBaohanh" value="${formattedNgayBaohanh}" placeholder="Ngày b?o hành" /></td>
                    <td><input type="date" name="ThoiGianBH" value="${formattedThoiGianBH}" placeholder="Th?i gian BH" /></td>
                `;
                tbody.appendChild(row);
            }
        }

    </script>
</head>
<body>
    @using (Html.BeginForm("ImportSQL", "Home", new { area = "QuanLiDuAn" }, FormMethod.Post, false, new { enctype = "multipart/form-data" }))
    {
        <div class="formyeucau">
            <div class="tieude">
                <p>Ch?n file Excel d? import</p>
            </div>
            <div class="row">
                <div class="field">
                    <label for="file">File import</label>
                    <input type="file" id="file" name="file" onchange="handleFileUpload(event)" />
                </div>
            </div>
            <div class="action">
                <button type="button" onclick="handleFileUpload(event)">Import</button>
            </div>
        </div>
        <div class="formtableyeucau">
            <div class="tieude">
                <p>Danh sách v?t tu import</p>
            </div>
            <div class="themyeucau-table">
                <table class="form-table">
                    <thead>
                        <tr>
                            <td>STT</td>
                            <td>Tên v?t tu</td>
                            <td>Mã v?t tu</td>
                            <td>Hãng SX</td>
                            <td>Nhà cung c?p</td>
                            <td>S? lu?ng</td>
                            <td>Ðon v?</td>
                            <td>Ngày b?o hành</td>
                            <td>Th?i gian BH</td>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Rows will be populated here -->
                    </tbody>
                </table>
            </div>
            <div class="action">
                <button type="submit">Thêm v?t tu</button>
            </div>
        </div>
    }
</body>
</html>
