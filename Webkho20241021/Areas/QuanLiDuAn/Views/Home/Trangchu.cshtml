
@{
    ViewData["Title"] = "Trangchu";
    Layout = "~/Areas/QuanLiDuAn/Views/Layout/Layout.cshtml";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css"
          rel="stylesheet" />
    <title>Trang chủ</title>
</head>
<body>
    <nav class="trangchu">
        <nav class="trangchu1">
            <nav class="chucnang">
                <span>Thông tin cá nhân</span>
                <ul class="canhan-icon">
                    <li>
                        <a href="/QuanLiDuAn/Thongtincanhan/Thongtincanhan"><i class='bx bxs-user' style='color:#8843b1'></i></a>
                        <a href="/QuanLiDuAn/Thongtincanhan/Thongtincanhan">Thông tin</a>
                    </li>
                </ul>
            </nav>
            <nav class="chucnang">
                <span>Quản lí kho</span>
                <ul class="canhan-icon">
                    <li>
                        <a href="/QuanLiDuAn/Home/Tongkho"><i class='bx bx-grid' style='color:#0d1348'></i></a>
                        <a href="/QuanLiDuAn/Home/Tongkho">Tổng kho</a>
                    </li>
                    <li>
                        <a href="@Url.Action("ExportTongkho", "Home", new { area = "QuanLiDuAn" })"><i class='bx bx-export' style='color:#712a0e'></i></a>
                        <a href="@Url.Action("ExportTongkho", "Home", new { area = "QuanLiDuAn" })">Export</a>
                    </li>
                </ul>
            </nav>
        </nav>
        <nav class="trangchu2">
            <nav class="chucnang">
                <span>Quản lí dự án</span>
                <ul class="canhan-icon">
                    <li>
                        <a href="/QuanLiDuAn/Duan/Duan"><i class='bx bxs-calendar-alt' style='color:#0e1171'></i></a>
                        <a href="/QuanLiDuAn/Duan/Duan">Danh sách dự án</a>
                    </li>
                    <li>
                        <a href="/QuanLiDuAn/Duan/ThemDuan"><i class='bx bxs-calendar-plus' style='color:#0c6215'></i></a>
                        <a href="/QuanLiDuAn/Duan/ThemDuan">Thêm dự án</a>
                    </li>
                    @* Ẩn link File Excel đã upload *@
                    @* <li>
                        <a href="/QuanLiDuAn/Yeucau/DanhSachFileExcel" title="File Excel đã upload">
                            <i class='bx bxs-file-blank' style='color:#17a2b8'></i>
                        </a>
                        <a href="/QuanLiDuAn/Yeucau/DanhSachFileExcel">File Excel đã upload</a>
                    </li> 
                    <li>
                        <a href="/QuanLiDuAn/Yeucau/SoSanhVatTuTheoNgay"><i class='bx bx-line-chart' style='color:#ff6b6b'></i></a>
                        <a href="/QuanLiDuAn/Yeucau/SoSanhVatTuTheoNgay">So sánh số liệu</a>
                    </li>*@
                    
                </ul>
            </nav>
            <nav class="chucnang">
                <span>Quản lí yêu cầu</span>
                <ul class="canhan-icon">
                    <li class="Danhsachyeucau">
                        <a href="/QuanLiDuAn/Yeucau/Yeucau"><i class='bx bxs-report' style='color:#0f1271'></i></a>
                        <a href="">Danh sách yêu cầu</a>
                        <span class="badge-trangchu">
                            <span class="notification"></span>
                        </span>
                    </li>
                    <li>
                        <a href="/QuanLiDuAn/Yeucau/ThemYeucau"><i class='bx bx-folder-plus' style='color:#0c6215'></i></a>
                        <a href="">Thêm yêu cầu</a>
                    </li>
                    @* Ẩn link Vật tư mới *@
                    @* <li>
                        <a href="/QuanLiDuAn/Home/VatTuMoi"><i class='bx bx-package' style='color:#8b5cf6'></i></a>
                        <a href="/QuanLiDuAn/Home/VatTuMoi">Vật tư mới</a>
                    </li> *@
                </ul>
            </nav>
        </nav>
    </nav>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/trangchu.js"></script>
    <script>
        $(document).ready(function () {
            if (typeof getThongbaoDatatrangchu === 'function') {
                getThongbaoDatatrangchu();
            }
        });
    </script>
</body>
</html>






