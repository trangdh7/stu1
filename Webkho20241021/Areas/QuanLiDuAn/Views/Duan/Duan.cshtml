@model Webkho_20241021.Areas.QuanLiDuAn.Data.Duanviewmodel
@{
    ViewData["Title"] = "Duan";
    Layout = "~/Areas/QuanLiDuAn/Views/Layout/Layout.cshtml";
}
@{
    var currentUserId = ViewBag.CurrentUserId as string;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />
    <title>Qu?n lý d? án</title>
</head>
<body class="bg-gray-50">
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 mx-4 mt-4">
            @TempData["Error"]
        </div>
    }

    <!-- Main Content -->
    <div class="container mx-auto px-4 py-6">
        <!-- Projects Section -->
        <div class="bg-white rounded-lg shadow-md mb-6">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 bg-gradient-to-r from-blue-500 to-blue-600">
                <h2 class="text-lg font-semibold text-white">Danh sách d? án</h2>
                <button class="text-white hover:text-blue-100 transition">
                    <i class="bx bx-search text-xl"></i>
                </button>
            </div>

            <!-- Projects Table -->
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gradient-to-r from-blue-600 to-blue-700 border-b-2 border-blue-800">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">STT</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Tên d? án</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Mã d? án</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Ngu?i qu?n lí</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Khách hàng</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Ngày b?t d?u</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Ngày k?t thúc</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Tr?ng thái</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @{
                            int STT = 1;
                        }
                        @foreach (var item in Model.Duan)
                        {
                            <tr class="hover:bg-blue-50 transition">
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-medium">@STT</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-medium">@item.TenDuan</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <a href="javascript:void(0);"
                                       onclick="showVTDuan('@item.MaDuan')"
                                       class="text-blue-600 hover:text-blue-800 font-semibold hover:underline">
                                        @item.MaDuan
                                    </a>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@item.NguoiQLDA</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@item.KhachHang</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@item.NgayBatdau</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@item.NgayKetthuc</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    @{
                                        var canControl = !string.IsNullOrWhiteSpace(currentUserId) &&
                                        !string.IsNullOrWhiteSpace(item.MaNguoiQLDA) &&
                                        string.Equals(currentUserId.Trim(), item.MaNguoiQLDA.Trim(), System.StringComparison.OrdinalIgnoreCase);
                                    }
                                    @if (canControl)
                                    {
                                        if (item.TrangThai == "Ch?")
                                        {
                                            using (Html.BeginForm("Xuliduan", "Duan", new { area = "QuanLiDuAn" }, FormMethod.Post))
                                            {
                                                <input type="hidden" name="MaDuan" value="@item.MaDuan" />
                                                <button type="submit"
                                                        name="action"
                                                        value="start"
                                                        class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white text-sm font-semibold rounded-lg shadow-md hover:shadow-lg transition-all transform hover:scale-105">
                                                    <i class="bx bx-play-circle mr-1.5 text-lg"></i> B?t d?u
                                                </button>
                                            }
                                        }
                                        else if (item.TrangThai == "Ðang tri?n khai")
                                        {
                                            using (Html.BeginForm("Xuliduan", "Duan", new { area = "QuanLiDuAn" }, FormMethod.Post))
                                            {
                                                <input type="hidden" name="MaDuan" value="@item.MaDuan" />
                                                <button type="submit"
                                                        name="action"
                                                        value="end"
                                                        class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white text-sm font-semibold rounded-lg shadow-md hover:shadow-lg transition-all transform hover:scale-105">
                                                    <i class="bx bxs-x-circle mr-1.5 text-lg"></i> K?t thúc
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-blue-500 to-blue-600 text-white text-sm font-semibold rounded-lg shadow-md">
                                                <i class="bx bx-check-circle mr-1.5"></i>
                                                @(item.TrangThai ?? string.Empty)
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        @if (item.TrangThai == "Ch?")
                                        {
                                            <span class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-yellow-400 to-yellow-500 text-white text-sm font-semibold rounded-lg shadow-md">
                                                <i class="bx bx-time-five mr-1.5"></i>
                                                @(item.TrangThai ?? string.Empty)
                                            </span>
                                        }
                                        else if (item.TrangThai == "Ðang tri?n khai")
                                        {
                                            <span class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-blue-500 to-blue-600 text-white text-sm font-semibold rounded-lg shadow-md">
                                                <i class="bx bx-loader-circle mr-1.5"></i>
                                                @(item.TrangThai ?? string.Empty)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-green-500 to-green-600 text-white text-sm font-semibold rounded-lg shadow-md">
                                                <i class="bx bx-check-circle mr-1.5"></i>
                                                @(item.TrangThai ?? string.Empty)
                                            </span>
                                        }
                                    }
                                </td>
                            </tr>
                            STT++;
                        }
                    </tbody>
                </table>
            </div>

            <!-- Action Button -->
            <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
                <a href="/QuanLiDuAn/Duan/ThemDuan"
                   class="inline-flex items-center px-5 py-2.5 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-semibold rounded-lg shadow-md hover:shadow-lg transition-all transform hover:scale-105">
                    <i class="bx bx-plus mr-2 text-lg"></i>
                    Thêm d? án
                </a>
            </div>
        </div>

        <!-- Materials Section -->
        <div class="bg-white rounded-lg shadow-md">
            <div class="overflow-x-auto">
                <table class="w-full tablethietbi">
                    <thead class="bg-gradient-to-r from-indigo-600 to-indigo-700 border-b-2 border-indigo-800">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Tên v?t tu</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Mã v?t tu</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Mã kho</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Hãng sx</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Nhà cung c?p</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">S? lu?ng</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Ðon v?</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Ngày nh?p kho</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Ngày b?o hành</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Th?i gian BH</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Tr?ng thái</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <tr>
                            <td colspan="11" class="px-6 py-12 text-center text-gray-500">
                                <i class="bx bx-package text-4xl mb-2 block text-gray-300"></i>
                                Vui lòng ch?n m?t d? án d? xem v?t tu dã du?c xu?t kho.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="~/js/duan.js"></script>
</body>
</html>
