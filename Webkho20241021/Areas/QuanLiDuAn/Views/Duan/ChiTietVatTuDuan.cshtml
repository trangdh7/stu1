@model Webkho_20241021.Models.ViewModels.ChiTietVatTuDuanViewModel

@{
    ViewData["Title"] = "Chi tiết vật tư dự án";
    Layout = "~/Areas/QuanLiDuAn/Views/Layout/Layout.cshtml";
    var duan = Model?.Duan;
    var vatTuList = Model?.VatTuList ?? new List<Webkho_20241021.Models.ViewModels.VatTuDuAnItemViewModel>();
    var nguoiNhanSummaries = Model?.NguoiNhanSummaries ?? new List<Webkho_20241021.Models.ViewModels.NguoiNhanVatTuSummary>();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chi tiết vật tư dự án</title>
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />
    <link href="~/css/chitietvattuduan.css" rel="stylesheet" />
</head>
<body>
    <div class="bodyyeucau">
        <a href="@Url.Action("Duan", "Duan", new { area = "QuanLiDuAn" })" class="btn-back">
            <i class='bx bx-arrow-back'></i>
            Quay lại danh sách dự án
        </a>

        @if (duan != null)
        {
            <div class="header-section">
                <h1><i class='bx bxs-package'></i> Vật tư đã cấp phát cho dự án</h1>
                <div class="header-info">
                    <div class="info-item">
                        <div class="info-label">Tên dự án</div>
                        <div class="info-value">@duan.TenDuan</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Mã dự án</div>
                        <div class="info-value">@duan.MaDuan</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Người quản lý</div>
                        <div class="info-value">@duan.NguoiQLDA</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Trạng thái</div>
                        <div class="info-value">@duan.TrangThai</div>
                    </div>
                </div>
            </div>
        }

        @if (vatTuList.Any())
        {
            <div class="summary-box">
                <h3><i class='bx bx-stats'></i> Tóm tắt</h3>
                <div class="summary-stats">
                    <div class="stat-item">
                        <div class="stat-value">@vatTuList.Count</div>
                        <div class="stat-label">Số loại vật tư</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">@vatTuList.Sum(v => (int)(v.SL ?? 0))</div>
                        <div class="stat-label">Tổng số lượng</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">@nguoiNhanSummaries.Count</div>
                        <div class="stat-label">Số người nhận</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">@vatTuList.Select(v => v.MaXuatkho).Distinct().Count()</div>
                        <div class="stat-label">Số phiếu xuất kho</div>
                    </div>
                </div>
            </div>

            @if (nguoiNhanSummaries.Count > 0)
            {
                <div class="summary-box" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); margin-bottom: 20px; color: white;">
                    <div class="summary-header" style="display:flex; justify-content:space-between; align-items:center;">
                        <h3 style="margin:0;"><i class='bx bx-user'></i> Lọc theo người nhận</h3>
                        <div>
                            <a href="@Url.Action("ChiTietVatTuDuan", "Duan", new { area = "QuanLiDuAn", MaDuan = duan?.MaDuan })" class="btn-filter @(string.IsNullOrEmpty(Model?.SelectedMaNguoiNhan) ? "active" : "")">
                                Tất cả
                            </a>
                        </div>
                    </div>
                    <div class="filter-chips">
                        @foreach (var nguoi in nguoiNhanSummaries)
                        {
                            if (string.IsNullOrEmpty(nguoi.MaNguoi))
                            {
                                <span class="filter-chip disabled">
                                    <strong>@nguoi.TenNguoi</strong>
                                    <small>@nguoi.SoLoaiVatTu loại • @nguoi.TongSoLuong chiếc</small>
                                </span>
                            }
                            else
                            {
                                var isActive = !string.IsNullOrEmpty(Model?.SelectedMaNguoiNhan) && string.Equals(Model.SelectedMaNguoiNhan?.Trim(), nguoi.MaNguoi?.Trim(), StringComparison.OrdinalIgnoreCase);
                                <a class="filter-chip @(isActive ? "active" : "")"
                                   href="@Url.Action("ChiTietVatTuDuan", "Duan", new { area = "QuanLiDuAn", MaDuan = duan?.MaDuan, maNguoiNhan = nguoi.MaNguoi })">
                                    <strong>@nguoi.TenNguoi</strong>
                                    <small>@nguoi.SoLoaiVatTu loại • @nguoi.TongSoLuong chiếc</small>
                                </a>
                            }
                        }
                    </div>
                </div>
            }

            <div class="search-section">
                <form method="get" asp-area="QuanLiDuAn" asp-controller="Duan" asp-action="ChiTietVatTuDuan" class="search-form">
                    <input type="hidden" name="MaDuan" value="@duan?.MaDuan" />
                    @if (!string.IsNullOrEmpty(Model?.SelectedMaNguoiNhan))
                    {
                        <input type="hidden" name="maNguoiNhan" value="@Model.SelectedMaNguoiNhan" />
                    }
                    <div class="search-input-wrapper">
                        <i class='bx bx-search'></i>
                        <input type="text" name="keyword" placeholder="Tìm theo tên vật tư, mã, kho, hãng..." value="@Model?.SearchKeyword" />
                    </div>
                    <button type="submit" class="btn-search">Tìm kiếm</button>
                    @if (!string.IsNullOrEmpty(Model?.SearchKeyword))
                    {
                        <a class="btn-clear" href="@Url.Action("ChiTietVatTuDuan", "Duan", new { area = "QuanLiDuAn", MaDuan = duan?.MaDuan, maNguoiNhan = Model.SelectedMaNguoiNhan })">Xóa</a>
                    }
                </form>
            </div>

            @if (!string.IsNullOrEmpty(Model?.SelectedMaNguoiNhan))
            {
                <div class="alert alert-info" style="margin-bottom:20px;">
                    Đang hiển thị vật tư do <strong>@(Model.SelectedTenNguoiNhan ?? Model.SelectedMaNguoiNhan)</strong> nhận.
                    <a href="@Url.Action("ChiTietVatTuDuan", "Duan", new { area = "QuanLiDuAn", MaDuan = duan?.MaDuan })" style="margin-left:10px; text-decoration:underline;">Bỏ lọc</a>
                </div>
            }

            <div class="table-container">
                <table class="table">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Tên thiết bị/hàng hóa</th>
                            <th>Mã VT</th>
                            <th>Mã kho</th>
                            <th>Hãng SX</th>
                            <th>Nhà CC</th>
                            <th>SL</th>
                            <th>ĐV</th>
                            <th>Người nhận</th>
                            <th>Ngày xuất kho</th>
                            <th>TRẠNG THÁI</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int stt = 1;
                            foreach (var vt in vatTuList)
                            {
                                <tr>
                                    <td>@stt</td>
                                    <td>@(vt.TenSanpham ?? "")</td>
                                    <td>@(vt.MaSanpham ?? "")</td>
                                    <td>@(vt.DAMakho ?? "")</td>
                                    <td>@(vt.HangSX ?? "")</td>
                                    <td>@(vt.NhaCC ?? "")</td>
                                    <td style="text-align: center; font-weight: bold; color: #667eea; font-size: 16px;">
                                        <span style="background: #e0e7ff; padding: 4px 8px; border-radius: 6px; display: inline-block;">
                                            @(vt.SL ?? 0)
                                        </span>
                                    </td>
                                    <td>@(vt.DonVi ?? "")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(vt.TenNguoiNhan?.ToString()))
                                        {
                                            <strong style="color: #667eea;">@vt.TenNguoiNhan</strong>
                                            @if (!string.IsNullOrEmpty(vt.MaNguoiNhan?.ToString()) && vt.MaNguoiNhan.ToString() != vt.TenNguoiNhan.ToString())
                                            {
                                                <br/><small style="color: #6b7280;">(@vt.MaNguoiNhan)</small>
                                            }
                                        }
                                        else if (!string.IsNullOrEmpty(vt.MaNguoiNhan?.ToString()))
                                        {
                                            <strong style="color: #667eea;">@vt.MaNguoiNhan</strong>
                                        }
                                        else
                                        {
                                            <span style="color: #9ca3af;">Chưa xác định</span>
                                        }
                                    </td>
                                    <td>@(vt.NgayXuatkho?.ToString("dd/MM/yyyy") ?? "")</td>
                                    <td>@(vt.TrangThai ?? "")</td>
                                </tr>
                                stt++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="text-align: center; padding: 60px; background: white; border-radius: 12px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
                <i class='bx bx-package' style="font-size: 64px; color: #d1d5db; margin-bottom: 20px;"></i>
                <h3 style="color: #6b7280; margin-bottom: 10px;">Chưa có vật tư nào được cấp phát</h3>
                <p style="color: #9ca3af;">Dự án này chưa có vật tư nào được xuất kho.</p>
            </div>
        }
    </div>
</body>
</html>

