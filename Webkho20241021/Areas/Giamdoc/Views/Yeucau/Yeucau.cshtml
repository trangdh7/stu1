@model Webkho_20241021.Areas.Giamdoc.Data.Yeucauviewmodel


@{
    ViewData["Title"] = "Yeucau";
    Layout = "~/Areas/Giamdoc/Views/Layout/Layout.cshtml";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>yeucau</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="~/css/yeucau.css" />
</head>
<body>
    @{
        Func<string, bool> isAwaitingDirectorStatusFunc = status =>
        {
            if (string.IsNullOrWhiteSpace(status))
            {
                return true;
            }

            var normalized = status.Trim();
            return normalized.Equals("Chờ giám đốc duyệt", System.StringComparison.OrdinalIgnoreCase)
                || normalized.Equals("Giám đốc", System.StringComparison.OrdinalIgnoreCase)
                || normalized.StartsWith("Chờ giám đốc", System.StringComparison.OrdinalIgnoreCase)
                || normalized.Contains("chờ giám đốc", System.StringComparison.OrdinalIgnoreCase);
        };

        // Lấy danh sách trạng thái từ bảng Yeucau (yêu cầu chính) - chỉ lấy những trạng thái có trong dữ liệu hiện tại
        var statusOptions = (Model?.Yeucau ?? new List<Webkho_20241021.Models.yeucau>())
            .Select(y => string.IsNullOrWhiteSpace(y.TrangThai) ? "Chờ giám đốc duyệt" : y.TrangThai.Trim())
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .GroupBy(s => s, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .OrderBy(s => s)
            .ToList();
    }
    <nav class="bodyyeucau">
        <div class="menu-kho">
            <ul class="timkiem">
                <li class="menu-yeucau">
                    <a href="/Giamdoc/Yeucau/Yeucau">Yêu cầu vật tư</a>
                    <span class="badge">
                        <span class="notification"></span> 
                    </span>
                </li>
                <li class="menu-muahang">
                    <a href="/Giamdoc/Yeucau/Phieumuahang">Yêu cầu mua hàng</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                
                <li class="menu-nhapkho">
                    <a href="/Giamdoc/Yeucau/Phieunhapkho">Phiếu nhập kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-xuatkho">
                    <a href="/Giamdoc/Yeucau/Phieuxuatkho">Phiếu xuất kho</a>
                </li>
            </ul>
            <ul>
                <input type="text" id="timkiem" name="Timkiem" placeholder="Tìm kiếm" />
            </ul>
        </div>
        <div class="Tableyeucau">
            <div class="table-toolbar">
                <label for="statusFilter">Lọc trạng thái:</label>
                <select id="statusFilter">
                    <option value="">Tất cả</option>
                    @foreach (var status in statusOptions)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>
            <table class="table">
                <thead>
                    <tr>
                        <td>STT</td>
                        <td>Tên yêu cầu</td>
                        <td>Mã yêu cầu</td>
                        <td>Người yêu cầu</td>
                        <td>Bộ phận</td>
                        <td>Mã người YC</td>
                        <td>Mã dự án</td>
                        <td>Ngày yêu cầu</td>
                        <td>Trạng thái</td>
                        <td>Ngày duyệt</td>
                        <td>Tên người duyệt</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int STT = 1;
                        // Sắp xếp: "Chờ giám đốc duyệt" luôn lên đầu, "Đã từ chối" xuống cuối
                        var sortedYeucau = Model.Yeucau
                            .OrderBy(y =>
                            {
                                var trangThai = string.IsNullOrWhiteSpace(y.TrangThai) ? "Chờ giám đốc duyệt" : y.TrangThai.Trim();

                                if (isAwaitingDirectorStatusFunc(trangThai))
                                {
                                    return 0; // Ưu tiên cao nhất
                                }

                                if (trangThai.IndexOf("Đã từ chối", StringComparison.OrdinalIgnoreCase) >= 0)
                                {
                                    return 2; // Đẩy xuống cuối
                                }

                                return 1; // Các trạng thái còn lại
                            })
                            .ThenBy(y => y.NgayYeucau ?? DateTime.MinValue)
                            .ToList();
                    }
                    @foreach (var item in sortedYeucau)
                    {
                        var duan = Model.Duans.FirstOrDefault(d => d.MaDuan == item.YCMaDuan);
                        string maNguoiQLDA = duan?.MaNguoiQLDA;
                        string maNguoidungSession = Context.Session.GetString("MaNguoidung");
                        var trangThaiYeucau = string.IsNullOrWhiteSpace(item.TrangThai) ? "Chờ giám đốc duyệt" : item.TrangThai.Trim();
                        var yeucauAwaiting = isAwaitingDirectorStatusFunc(item.TrangThai);
                        var yeucauRowClass = yeucauAwaiting ? "awaiting-director" : "";
                        
                        // Thêm class màu nền dựa trên trạng thái
                        string statusRowClass = "";
                        if (trangThaiYeucau.IndexOf("Đã từ chối", StringComparison.OrdinalIgnoreCase) >= 0)
                        {
                            statusRowClass = "status-rejected";
                        }
                        else if (trangThaiYeucau.IndexOf("Đang mua hàng", StringComparison.OrdinalIgnoreCase) >= 0)
                        {
                            statusRowClass = "status-purchasing";
                        }
                        else if (trangThaiYeucau.IndexOf("Đã xuất kho", StringComparison.OrdinalIgnoreCase) >= 0)
                        {
                            statusRowClass = "status-dispatched";
                        }
                        
                        var finalRowClass = string.IsNullOrEmpty(yeucauRowClass) ? statusRowClass : 
                                           (string.IsNullOrEmpty(statusRowClass) ? yeucauRowClass : $"{yeucauRowClass} {statusRowClass}");
                        
                        // Tính ngày duyệt sớm nhất từ các vật tư trong yêu cầu
                        var ngayDuyetSomNhat = Model.VTyeucau
                            .Where(vt => vt.VTMaYeucau == item.MaYeucau && vt.NgayDuyet.HasValue)
                            .OrderBy(vt => vt.NgayDuyet)
                            .FirstOrDefault()?.NgayDuyet;
                        <tr class="@finalRowClass" onclick="showVTYeucau('@item.MaYeucau', '@item.NguoiYeucau', '@item.MaYeucau')" style="cursor: pointer;">
                            <td>@STT</td>
                            <td>@item.TenYeucau</td>
                            <td>
                                <a href="javascript:void(0);" onclick="event.stopPropagation(); showVTYeucau('@item.MaYeucau', '@item.NguoiYeucau', '@item.MaYeucau')">
                                    @item.MaYeucau
                                </a>
                            </td>
                            <td>@item.NguoiYeucau</td>
                            <td>@item.Bophan</td>
                            <td>@item.YCMaNguoidung</td>
                            <td>@item.YCMaDuan</td>
                            <td>@item.NgayYeucau?.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>@trangThaiYeucau</td>
                            <td>
                                @if (ngayDuyetSomNhat.HasValue)
                                {
                                    <span>@ngayDuyetSomNhat.Value.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                }
                                else
                                {
                                    <span style="color: #999;">-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.NguoiDuyet))
                                {
                                    <span>@item.NguoiDuyet</span>
                                }
                                else
                                {
                                    <span style="color: #999;">-</span>
                                }
                            </td>
                        </tr>
                        STT++;
                    }
                </tbody>
            </table>
        </div>
        <div id="noYeucauMessage" class="empty-yeucau-message" style="display:none;">
            Không có phiếu yêu cầu nào phù hợp với bộ lọc.
        </div>
        <div class="action">
            <ul class="hanhdong">
                <li>
                    <button type="button" onclick="location.href='/Giamdoc/Yeucau/ThemYeucau'">Thêm yêu cầu</button>
                </li>
            </ul>
        </div>
    </nav>
    <nav class="bodyyeucau-thietbi">
        <div class="yeucau-info" id="yeucauInfo" style="margin-bottom: 10px; padding: 10px; background-color: #f0f0f0; border-radius: 5px; display: none;">
            <strong id="yeucauInfoText"></strong>
        </div>
        <div class="Tableyeucau-thietbi-box">
            <table class="tablethietbi">
                <thead>
                    <tr>
                        <th rowspan="2"><input type="checkbox" id="selectAllVT" /></th>
                        <th rowspan="2">TT</th>
                        <th rowspan="2">Tên thiết bị / hàng hóa</th>
                        <th rowspan="2">Mã VT</th>
                        <th rowspan="2">Hãng SX</th>
                        <th rowspan="2">NCC</th>
                        <th colspan="5" style="text-align: center;">SL</th>
                        <th hidden rowspan="2">SL</th>
                        <th rowspan="2">ĐV</th>
                        <th rowspan="2">Ngày cần</th>
                        <th class="trangthai-column-header" style="display: none;" rowspan="2">Trạng thái</th>
                        <th rowspan="2">Ghi chú</th>
                        <th rowspan="2">Ngày duyệt</th>
                    </tr>
                    <tr>
                        <th>Cũ</th>
                        <th>Mới</th>
                        <th>Thiếu</th>
                        <th>Đã xuất</th>
                        <th>Tồn kho</th>
                    </tr>
                </thead>
                <tbody id="vtYeucauBody">
                    @{
                        int STT2 = 1;
                        var tonKhoByMaSanpham = ViewBag.TonKhoByMaSanpham as Dictionary<string, int>;
                        if (tonKhoByMaSanpham == null) { tonKhoByMaSanpham = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase); }
                        var vtItems = Model.VTyeucau
                            .OrderByDescending(item => isAwaitingDirectorStatusFunc(item.TrangThai))
                            .ThenBy(item => item.MaSanpham)
                            .ToList();
                        var currentArea = Context.Request.RouteValues["area"]?.ToString() ?? "";
                        var userRole = Context.Session.GetString("Chucvu") ?? "";
                        var selectedRole = Context.Session.GetString("SelectedRole") ?? "";
                        // Nếu đang ở area Giamdoc thì chắc chắn là Giám đốc
                        bool canApprove = currentArea == "Giamdoc" || 
                                        userRole.Trim() == "Giám đốc" || 
                                        selectedRole.Trim() == "Giám đốc";
                    }
                    @foreach (var item in vtItems)
                    {
                        var trangThai = string.IsNullOrWhiteSpace(item.TrangThai)
                            ? "Chờ giám đốc duyệt"
                            : item.TrangThai.Trim();
                        // Vật tư đã được duyệt nếu có trạng thái "Đã duyệt" hoặc "Đang mua hàng" (đã qua bước duyệt)
                        var isApproved = trangThai == "Đã duyệt" || 
                                       trangThai == "Đang mua hàng" || 
                                       trangThai == "Chờ xuất kho" ||
                                       trangThai == "Đã xuất kho" || 
                                       trangThai == "Đã nhận hàng";
                        // Vật tư bị từ chối nếu trạng thái chứa "Đã từ chối" (bao gồm "Giám đốc - Đã từ chối")
                        var isRejected = trangThai.IndexOf("từ chối", StringComparison.OrdinalIgnoreCase) >= 0;
                        // Chỉ được phép duyệt hàng loạt nếu đúng bước "Chờ giám đốc duyệt" (bao gồm dữ liệu cũ chưa set trạng thái)
                        var isAwaitingDirector = isAwaitingDirectorStatusFunc(item.TrangThai);
                        var maYeucau = Model.Yeucau.FirstOrDefault()?.MaYeucau ?? "";
                        var canSelectForBulk = canApprove && isAwaitingDirector;
                        // Chỉ hiển thị nút duyệt khi trạng thái là "Chờ giám đốc duyệt"    
                        var canActOnItem = canApprove && isAwaitingDirector && !isApproved && !isRejected;
                        var rowClass = isRejected ? "rejected-row" : "";
                        var slMoi = item.SLMoi ?? item.SL ?? 0;
                        var tonKho = !string.IsNullOrWhiteSpace(item.MaSanpham) && tonKhoByMaSanpham.TryGetValue(item.MaSanpham, out var tk) ? tk : 0;
                        var slThieu = tonKho - slMoi;
                        var isDaXuatKho = (item.TrangThai ?? "").IndexOf("Đã xuất kho", StringComparison.OrdinalIgnoreCase) >= 0;
                        var slDaXuat = isDaXuatKho ? (item.SL ?? item.SLMoi) : (int?)null;
                        <tr data-mavattu="@item.MaSanpham" data-mayeucau="@maYeucau" class="@rowClass">
                            <td>@if (canSelectForBulk) { <input type="checkbox" class="vt-checkbox" value="@item.MaSanpham" data-mayeucau="@maYeucau" data-mavattu="@item.MaSanpham" /> }</td>
                            <td>@STT2</td>
                            <td>@item.TenSanpham</td>
                            <td>@item.MaSanpham</td>
                            <td>@item.HangSX</td>
                            <td>@item.NhaCC</td>
                            <td style="text-align: center;">@(item.SLCu?.ToString() ?? "-")</td>
                            <td style="text-align: center;">@(item.SLMoi?.ToString() ?? "-")</td>
                            <td style="text-align: center;">@slThieu</td>
                            <td style="text-align: center;">@(slDaXuat.HasValue ? slDaXuat.Value.ToString() : "-")</td>
                            <td style="text-align: center;">@tonKho</td>
                            <td hidden style="text-align: center;">@(item.SL?.ToString() ?? item.SLMoi?.ToString() ?? "-")</td>
                            <td>@(item.DonVi ?? "-")</td>
                            <td>@(item.NgayCanHang?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td class="trangthai-vattu trangthai-column" style="display: none;">
                                @{
                                    string trangThaiColor = "";
                                    if (trangThai == "Đang mua hàng")
                                    {
                                        trangThaiColor = "color: #2196f3; font-weight: bold;";
                                    }
                                    else if (trangThai == "Chờ xuất kho")
                                    {
                                        trangThaiColor = "color: #4caf50; font-weight: bold;";
                                    }
                                    else if (trangThai == "Đã xuất kho" || trangThai == "Đã duyệt")
                                    {
                                        trangThaiColor = "color: #4caf50; font-weight: bold;";
                                    }
                                    else if (trangThai.Contains("Đã từ chối") || trangThai.Contains("từ chối"))
                                    {
                                        trangThaiColor = "color: #8b0000; font-weight: bold;";
                                    }
                                }
                                <span style="@trangThaiColor">@trangThai</span>
                            </td>
                            <td class="ghichu-column">
                                @if (canActOnItem)
                                {
                                    <input type="text" class="ghichu-input" data-mavattu="@item.MaSanpham" data-mayeucau="@maYeucau" value="@(item.GhiChu ?? "")" placeholder="Nhập ghi chú..." style="width: 100%; padding: 4px; border: 1px solid #ddd; border-radius: 3px;" />
                                }
                                else
                                {
                                    <span style="color: @(trangThai.Contains("Đã từ chối") || trangThai.Contains("từ chối") ? "#f44336" : "inherit");">@(item.GhiChu ?? "-")</span>
                                }
                            </td>
                            <td>
                                @if (item.NgayDuyet.HasValue)
                                {
                                    <span>@item.NgayDuyet.Value.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                }
                                else
                                {
                                    <span style="color: #999;">-</span>
                                }
                            </td>
                        </tr>
                        STT2++;
                    }
                </tbody>
            </table>
        </div>
        <div class="action-duyet">
            @if (Context.Session.GetString("Chucvu") == "Giám đốc" && Model.VTyeucau.Any())
            {
                <div class="action-duyet-right">
                    <button type="button" id="btnXacNhan" class="btn-xacnhan" style="display:none;" onclick="showConfirmPopup();">Duyệt</button>
                    <button type="button" id="btnCancel" class="btn-cancel" style="display:none;" onclick="clearBulkAction()">Cancel</button>
                </div>
            }
        </div>
    </nav>
    <!-- Popup xác nhận tùy chỉnh -->
    <div id="customConfirmPopup" class="custom-popup-overlay" style="display: none;" onclick="if(event.target === this) closeConfirmPopup();">
        <div class="custom-popup-content" onclick="event.stopPropagation();">
            <div class="custom-popup-header">
                <h3>Xác nhận duyệt</h3>
            </div>
            <div class="custom-popup-body">
                <p id="confirmPopupMessage">Bạn có chắc chắn muốn duyệt các vật tư đã chọn?</p>
            </div>
            <div class="custom-popup-footer">
                <button type="button" class="btn-popup-confirm" onclick="handlePopupConfirm()">Xác nhận</button>
                <button type="button" class="btn-popup-cancel" onclick="closeConfirmPopup()">Cancel</button>
            </div>
        </div>
    </div>
    <div id="rejectAllPopup" class="custom-popup-overlay" style="display: none;" onclick="if(event.target === this) closeRejectAllPopup();">
        <div class="custom-popup-content" onclick="event.stopPropagation();">
            <div class="custom-popup-header">
                <h3>Từ chối vật tư</h3>
            </div>
            <div class="custom-popup-body">
                <label for="rejectAllReason">Nhập lý do từ chối:</label>
                <textarea id="rejectAllReason" style="width:100%; min-height:90px; margin-top:8px; padding:8px; border:1px solid #ddd; border-radius:4px;" placeholder="Nhập lý do từ chối..."></textarea>
            </div>
            <div class="custom-popup-footer">
                <button type="button" class="btn-popup-confirm" onclick="applyRejectReason()">Xong</button>
                <button type="button" class="btn-popup-cancel" onclick="closeRejectAllPopup()">Hủy</button>
            </div>
        </div>
    </div>
    @inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
    @{
        var requestToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    }
    <input type="hidden" id="RequestVerificationToken" name="__RequestVerificationToken" value="@requestToken" />
    <script src="~/js/yeucau.js"></script>
    <script>
        var currentMaYeucau = '';
        var currentNguoiYeucau = '';
        var requestToken = '@requestToken';
        var pendingBulkAction = null;

        function normalizeTrangThai(value) {
            if (!value || !value.trim()) {
                return 'Chờ giám đốc duyệt';
            }
            return value.trim();
        }

        function getTrangThaiWithColor(trangThai) {
            var color = '';
            if (trangThai === 'Đang mua hàng') {
                color = 'color: #2196f3; font-weight: bold;';
            } else if (trangThai === 'Chờ xuất kho') {
                color = 'color: #4caf50; font-weight: bold;';
            } else if (trangThai === 'Đã xuất kho' || trangThai === 'Đã duyệt') {
                color = 'color: #4caf50; font-weight: bold;';
            } else if (trangThai && (trangThai.indexOf('Đã từ chối') !== -1 || trangThai.indexOf('từ chối') !== -1)) {
                color = 'color: #8b0000; font-weight: bold;';
            }
            return '<span style="' + color + '">' + trangThai + '</span>';
        }

        function formatDateOnly(value) {
            if (!value) return '-';
            var date = new Date(value);
            if (isNaN(date)) return '-';
            var day = String(date.getDate()).padStart(2, '0');
            var month = String(date.getMonth() + 1).padStart(2, '0');
            var year = date.getFullYear();
            return `${day}/${month}/${year}`;
        }

        function isAwaitingDirectorStatus(status) {
            if (!status) return true;
            var normalized = status.trim().toLowerCase();
            return normalized === 'chờ giám đốc duyệt'
                || normalized === 'giám đốc'
                || normalized.startsWith('chờ giám đốc')
                || normalized.includes('chờ giám đốc');
        }

        $(document).ready(function () {
            if (typeof getThongbaoData === 'function') {
                getThongbaoData();
            }
            
            // Select all checkbox for VT
            $('#selectAllVT').on('change', function() {
                $('.vt-checkbox').prop('checked', $(this).prop('checked'));
            });

            // Individual checkbox change
            $(document).on('change', '.vt-checkbox', function() {
                var allChecked = $('.vt-checkbox').length === $('.vt-checkbox:checked').length;
                $('#selectAllVT').prop('checked', allChecked);
                updateDuyetTatCaButton();
            });

            updateDuyetTatCaButton();
        });

        function updateDuyetTatCaButton() {
            // Không cần nữa vì đã xóa nút "Từ chối tất cả"
        }

        function showVTYeucau(MaYeucau, NguoiYeucau, MaYeucauFull) {
            currentMaYeucau = MaYeucau;
            currentNguoiYeucau = NguoiYeucau || '';
            
            const pathSegments = window.location.pathname.split('/');
            const area = pathSegments.length > 1 ? pathSegments[1] : ''; 
            const url = `/${area}/Yeucau/GetVTYeucau`;

            $('.bodyyeucau-thietbi').show();
            $('.tablethietbi').show();

            // Hiển thị thông tin yêu cầu
            if (currentNguoiYeucau) {
                $('#yeucauInfo').show();
                $('#yeucauInfoText').text('Yêu cầu vật tư ' + MaYeucau + ' của ' + currentNguoiYeucau);
            } else {
                $('#yeucauInfo').hide();
            }

            $.ajax({
                url: url, 
                method: 'GET',
                data: { MaYeucau: MaYeucau }, 
                success: function (data) {
                    $('#vtYeucauBody').empty();
                    $('#selectAllVT').prop('checked', false);

                    if (data && data.length > 0) {
                        let STT = 1;

                        data.sort(function (a, b) {
                            var aAwait = isAwaitingDirectorStatus(a?.trangThai);
                            var bAwait = isAwaitingDirectorStatus(b?.trangThai);
                            if (aAwait === bAwait) return 0;
                            return aAwait ? -1 : 1;
                        });
                        
                        // Kiểm tra xem có thể duyệt không
                        // Lấy từ session hoặc kiểm tra area hiện tại
                        var userRole = '@Context.Session.GetString("Chucvu")' || '';
                        var selectedRole = '@Context.Session.GetString("SelectedRole")' || '';
                        var currentArea = '@Context.Request.RouteValues["area"]' || '';
                        
                        // Nếu đang ở area Giamdoc thì chắc chắn là Giám đốc
                        var canApproveYeucau = currentArea === 'Giamdoc' || 
                                             userRole.trim() === 'Giám đốc' || 
                                             selectedRole.trim() === 'Giám đốc';
                        
                        // Debug: log để kiểm tra
                        console.log('Current Area:', currentArea);
                        console.log('User Role (Session):', userRole);
                        console.log('Selected Role (Session):', selectedRole);
                        console.log('Can Approve:', canApproveYeucau);
                        console.log('Data length:', data.length);
                        
                        data.forEach(function (item) {
                            var maVatTu = item.maSanpham || '';
                            var trangThai = normalizeTrangThai(item.trangThai || '');
                            // Vật tư đã được duyệt nếu có trạng thái "Đã duyệt" hoặc "Đang mua hàng" (đã qua bước duyệt)
                        var isApproved = trangThai === 'Đã duyệt' || 
                                       trangThai === 'Đang mua hàng' || 
                                       trangThai === 'Chờ xuất kho' ||
                                       trangThai === 'Đã xuất kho' || 
                                       trangThai === 'Đã nhận hàng';
                            // Bị từ chối nếu trạng thái chứa "từ chối" (không phân biệt hoa thường)
                            var isRejected = (trangThai || '').toLowerCase().indexOf('từ chối') !== -1;
                            // Được phép chọn hàng loạt khi đúng bước "Chờ giám đốc duyệt"
                            var isAwaitingDirector = isAwaitingDirectorStatus(trangThai);
                            var canSelectForBulk = canApproveYeucau && isAwaitingDirector;
                            // Chỉ hiển thị nút duyệt khi trạng thái là "Chờ giám đốc duyệt"
                            var canActOnItem = canApproveYeucau && isAwaitingDirector && !isApproved && !isRejected;
                            
                            // Escape single quotes trong mã vật tư để tránh lỗi JavaScript
                            var maVatTuEscaped = maVatTu.replace(/'/g, "\\'");
                            var MaYeucauEscaped = MaYeucau.replace(/'/g, "\\'");

                            var hangSX = item.hangSX ?? item.HangSX ?? '';
                            var nhaCC = item.nhaCC ?? item.NhaCC ?? '';
                            
                            // Chuẩn hoá dữ liệu số lượng từ mọi kiểu đặt tên có thể (camelCase / PascalCase)
                            var slCuVal = item.slCu ?? item.SLCu ?? item.sLCu ?? item.SlCu;
                            var slMoiVal = item.slMoi ?? item.SLMoi ?? item.sLMoi ?? item.SlMoi;
                            var tonKho = item.tonKho ?? item.TonKho ?? 0;
                            var slThieu = item.slThieu ?? item.SlThieu ?? (tonKho - (slMoiVal ?? 0));
                            var slDaXuat = item.slDaXuat ?? item.SlDaXuat;
                            var slGocVal = item.sl ?? item.SL ?? item.sL ?? item.Sl;

                            // Nếu là phiếu nhập kho mà chỉ có SL gốc thì dùng cho cả cột mới để đảm bảo luôn thấy số
                            if ((slMoiVal == null || slMoiVal === undefined) && (slGocVal != null && slGocVal !== undefined)) {
                                slMoiVal = slGocVal;
                            }
                            // Nếu vẫn chưa có thì fallback về SLCu
                            if ((slMoiVal == null || slMoiVal === undefined) && (slCuVal != null && slCuVal !== undefined)) {
                                slMoiVal = slCuVal;
                            }

                            // Giá trị hiển thị ở cột SL tổng (dùng cho yêu cầu nhập kho)
                            var slVal = slGocVal;
                            if (slVal == null || slVal === undefined) {
                                slVal = slMoiVal != null && slMoiVal !== undefined ? slMoiVal : slCuVal;
                            }

                            var donViVal = item.donVi ?? item.DonVi ?? '-';
                            var ngayCanHangVal = item.ngayCanHang ?? item.NgayCanHang;
                            var ngayCanHangDisplay = formatDateOnly(ngayCanHangVal);
                            
                            // Tích checkbox mặc định cho các vật tư đang chờ duyệt (có thể thao tác)
                            var checkboxChecked = canActOnItem ? ' checked' : '';
                            var rowClass = isRejected ? 'rejected-row' : '';
                            var row = `<tr class="${rowClass}" data-mavattu="${maVatTu}" data-mayeucau="${MaYeucau}">
                                <td>${canSelectForBulk ? '<input type="checkbox" class="vt-checkbox" value="' + maVatTuEscaped + '" data-mayeucau="' + MaYeucauEscaped + '" data-mavattu="' + maVatTuEscaped + '"' + checkboxChecked + ' />' : ''}</td>
                                <td>${STT++}</td>
                                <td>${item.tenSanpham || item.TenSanpham || ''}</td>
                                <td>${maVatTu}</td>
                                <td>${hangSX || '-'}</td>
                                <td>${nhaCC || '-'}</td>
                                <td style="text-align: center;">${slCuVal ?? '-'}</td>
                                <td style="text-align: center;">${slMoiVal ?? '-'}</td>
                                <td style="text-align: center;">${slThieu ?? '-'}</td>
                                <td style="text-align: center;">${slDaXuat != null ? slDaXuat : '-'}</td>
                                <td style="text-align: center;">${tonKho ?? '-'}</td>
                                <td hidden style="text-align: center;">${slVal ?? '-'}</td>
                                <td>${donViVal}</td>
                                <td>${ngayCanHangDisplay}</td>`;
                            
                            // Thêm màu sắc cho trạng thái
                            var trangThaiColor = '';
                            if (trangThai === 'Đang mua hàng') {
                                trangThaiColor = 'color: #2196f3; font-weight: bold;';
                            } else if (trangThai === 'Chờ xuất kho') {
                                trangThaiColor = 'color: #4caf50; font-weight: bold;';
                            } else if (trangThai === 'Đã xuất kho' || trangThai === 'Đã duyệt') {
                                trangThaiColor = 'color: #4caf50; font-weight: bold;';
                            } else if (trangThai && (trangThai.indexOf('Đã từ chối') !== -1 || trangThai.indexOf('từ chối') !== -1)) {
                                trangThaiColor = 'color: #8b0000; font-weight: bold;';
                            }
                            row += `<td class="trangthai-vattu trangthai-column" style="display: none;">
                                    <span style="${trangThaiColor}">${trangThai}</span>
                                </td>
                                <td class="ghichu-column">`;
                            
                            // Hiển thị input ghi chú nếu có thể thao tác, ngược lại hiển thị text
                            if (canActOnItem) {
                                var ghiChuValue = (item.ghiChu || '').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
                                row += `<input type="text" class="ghichu-input" data-mavattu="${maVatTuEscaped}" data-mayeucau="${MaYeucauEscaped}" value="${ghiChuValue}" placeholder="Nhập ghi chú..." style="width: 100%; padding: 4px; border: 1px solid #ddd; border-radius: 3px; font-size: 13px;" />`;
                            } else {
                                var ghiChuColor = (trangThai && (trangThai.indexOf('Đã từ chối') !== -1 || trangThai.indexOf('từ chối') !== -1)) ? '#f44336' : 'inherit';
                                row += `<span style="color: ${ghiChuColor};">${item.ghiChu || '-'}</span>`;
                            }
                            
                            row += `</td>
                                <td>`;
                            
                            // Hiển thị ngày duyệt
                            if (item.ngayDuyet) {
                                var ngayDuyetDate = new Date(item.ngayDuyet);
                                var day = String(ngayDuyetDate.getDate()).padStart(2, '0');
                                var month = String(ngayDuyetDate.getMonth() + 1).padStart(2, '0');
                                var year = ngayDuyetDate.getFullYear();
                                var hours = String(ngayDuyetDate.getHours()).padStart(2, '0');
                                var minutes = String(ngayDuyetDate.getMinutes()).padStart(2, '0');
                                var seconds = String(ngayDuyetDate.getSeconds()).padStart(2, '0');
                                var ngayDuyetFormatted = `${day}/${month}/${year} ${hours}:${minutes}:${seconds}`;
                                row += `<span>${ngayDuyetFormatted}</span>`;
                            } else {
                                row += `<span style="color: #999;">-</span>`;
                            }
                            
                            row += `</td></tr>`;
                            $('#vtYeucauBody').append(row);
                        });

                        // Kiểm tra và hiển thị/ẩn cột trạng thái sau khi load dữ liệu
                        checkAndToggleTrangThaiColumn();
                        // Cập nhật nút hành động sau khi load dữ liệu
                        updateActionButtons();
                    } else {
                        $('#vtYeucauBody').append(
                            `<tr><td colspan="15" style="text-align:center;">Không có dữ liệu vật tư.</td></tr>`
                        );
                        // Cập nhật nút hành động khi không có dữ liệu
                        updateActionButtons();
                    }
                    
                    // Highlight hàng tương ứng trong bảng chính
                    let $rowToHighlight = $();
                    $('.table tbody tr').each(function () {
                        var rowMaYeucau = $(this).find('td').eq(2).find('a').text().trim();
                        if (rowMaYeucau === MaYeucau) {
                            $rowToHighlight = $(this);
                            return false;
                        }
                    });
                    applyTableRowHighlight($rowToHighlight);
                },
                error: function (xhr, status, error) {
                    console.error("Lỗi:", error);
                    alert("Không thể lấy dữ liệu vật tư. Lỗi: " + error);
                }
            });
        }

        function checkCanApproveYeucau(maYeucau) {
            // Kiểm tra xem có thể duyệt yêu cầu này không
            // Nếu đang ở area Giamdoc thì chắc chắn là Giám đốc
            var currentArea = '@Context.Request.RouteValues["area"]' || '';
            var userRole = '@Context.Session.GetString("Chucvu")' || '';
            var selectedRole = '@Context.Session.GetString("SelectedRole")' || '';
            
            return currentArea === 'Giamdoc' || 
                   userRole.trim() === 'Giám đốc' || 
                   selectedRole.trim() === 'Giám đốc';
        }

        // Kiểm tra và hiển thị/ẩn cột trạng thái
        // Ẩn khi tất cả vật tư đều chờ duyệt, hiển thị khi có vật tư đã được xử lý
        function checkAndToggleTrangThaiColumn() {
            var hasProcessedItems = false;
            $('.trangthai-vattu').each(function() {
                var trangThai = $(this).text().trim();
                // Nếu trạng thái không phải "Chờ giám đốc duyệt" hoặc rỗng, thì đã được xử lý
                if (trangThai && 
                    trangThai !== 'Chờ giám đốc duyệt' && 
                    trangThai !== 'Giám đốc' &&
                    !trangThai.toLowerCase().includes('chờ giám đốc')) {
                    hasProcessedItems = true;
                    return false; // break loop
                }
            });
            
            if (hasProcessedItems) {
                // Có vật tư đã được xử lý -> hiển thị cột trạng thái
                $('.trangthai-column-header, .trangthai-column').css('display', 'table-cell');
            } else {
                // Tất cả vật tư đều chờ duyệt -> ẩn cột trạng thái
                $('.trangthai-column-header, .trangthai-column').css('display', 'none');
            }
        }
        // Kiểm tra khi trang load xong
        $(document).ready(function() {
            checkAndToggleTrangThaiColumn();
            // Cập nhật nút hành động khi trang load
            setTimeout(function() {
                updateActionButtons();
            }, 100);
        });

        // Xử lý khi checkbox thay đổi - highlight hàng nếu không tích (từ chối)
        $(document).on('change', '.vt-checkbox', function() {
            var $row = $(this).closest('tr');
            if ($(this).is(':checked')) {
                $row.removeClass('rejected-row');
            } else {
                $row.addClass('rejected-row');
            }
        });

        // Kiểm tra và hiển thị/ẩn nút Xác nhận và Cancel
        function updateActionButtons() {
            console.log("[DEBUG YEUCAU] updateActionButtons được gọi");
            var hasCheckboxes = $('.vt-checkbox').length > 0;
            
            console.log("[DEBUG YEUCAU] hasCheckboxes:", hasCheckboxes);
            
           
            if (hasCheckboxes) {
                // Có vật tư đang chờ duyệt -> hiển thị nút Xác nhận và Cancel
                console.log("[DEBUG YEUCAU] ✅ Hiển thị nút Xác nhận và Cancel (có checkbox = có vật tư chờ duyệt)");
                $('#btnXacNhan').show();
                $('#btnCancel').show();
                console.log("[DEBUG YEUCAU] Nút Xác nhận có tồn tại:", $('#btnXacNhan').length > 0);
                console.log("[DEBUG YEUCAU] Nút Xác nhận đang hiển thị:", $('#btnXacNhan').is(':visible'));
            } else {
                // Không có checkbox = không có vật tư chờ duyệt -> ẩn cả 2 nút
                console.log("[DEBUG YEUCAU] ❌ Ẩn nút vì không có checkbox (không có vật tư chờ duyệt)");
                $('#btnXacNhan').hide();
                $('#btnCancel').hide();
            }
        }

        // Xử lý khi checkbox thay đổi - highlight hàng nếu không tích (từ chối)
        $(document).on('change', '.vt-checkbox', function() {
            console.log("[DEBUG YEUCAU] Checkbox thay đổi");
            var $row = $(this).closest('tr');
            if ($(this).is(':checked')) {
                $row.removeClass('rejected-row');
                console.log("[DEBUG YEUCAU] Checkbox được tích");
            } else {
                $row.addClass('rejected-row');
                console.log("[DEBUG YEUCAU] Checkbox bỏ tích");
            }
            // Cập nhật nút hành động
            updateActionButtons();
        });

        // Xử lý checkbox "Chọn tất cả"
        $(document).on('change', '#selectAllVT', function() {
            var isChecked = $(this).is(':checked');
            $('.vt-checkbox').prop('checked', isChecked).trigger('change');
            // Cập nhật nút hành động
            updateActionButtons();
        });

        // Hiển thị popup xác nhận duyệt hoặc từ chối
        function showConfirmPopup() {
            console.log("[DEBUG YEUCAU] showConfirmPopup được gọi");
            
            // Kiểm tra xem có checkbox nào được tích không
            var checkedCount = $('.vt-checkbox:checked').length;
            var totalCount = $('.vt-checkbox').length;
            
            // Nếu không có checkbox nào được tích -> kiểm tra xem đã có lý do từ chối chưa
            if (checkedCount === 0 && totalCount > 0) {
                // Kiểm tra xem còn vật tư bị từ chối nào CHƯA có lý do không
                var conThieuLyDo = false;
                
                $('.vt-checkbox').each(function() {
                    var $checkbox = $(this);
                    var $row = $checkbox.closest('tr');
                    
                    // Kiểm tra từ input ghi chú (ưu tiên)
                    var $ghichuInput = $row.find('.ghichu-input');
                    var ghiChu = '';
                    
                    if ($ghichuInput.length > 0) {
                        // Đọc từ input
                        ghiChu = ($ghichuInput.val() || '').trim();
                    } else {
                        // Nếu không có input, kiểm tra span (fallback)
                        var $noteSpan = $row.find('.ghichu-column span');
                        if ($noteSpan.length > 0) {
                            ghiChu = ($noteSpan.text() || '').trim();
                        }
                    }
                    
                    console.log("[DEBUG YEUCAU] Vật tư:", $checkbox.val(), "ghiChu:", ghiChu);
                    
                    // Nếu không có ghi chú hoặc ghi chú rỗng -> còn thiếu lý do
                    if (!ghiChu || ghiChu === '') {
                        conThieuLyDo = true;
                        console.log("[DEBUG YEUCAU] ❌ Vật tư", $checkbox.val(), "chưa có lý do từ chối");
                        return false; // break loop
                    }
                });
                
                // Nếu còn thiếu lý do -> hiển thị popup từ chối để nhập lý do
                if (conThieuLyDo) {
                    console.log("[DEBUG YEUCAU] ⚠️ Còn thiếu lý do từ chối -> hiển thị popup nhập lý do");
                    $('#rejectAllReason').val('');
                    $('#rejectAllPopup').fadeIn(200);
                    return;
                }
                
                // Nếu tất cả vật tư bị từ chối đã có lý do -> hiển thị popup xác nhận
                console.log("[DEBUG YEUCAU] ✅ Tất cả vật tư đã có lý do -> hiển thị popup xác nhận");
                $('#confirmPopupMessage').text('Bạn có chắc chắn muốn từ chối các vật tư đã chọn?');
                $('#customConfirmPopup').fadeIn(200);
                return;
            }
            
            // Nếu có checkbox được tích -> hiển thị popup xác nhận duyệt
            $('#confirmPopupMessage').text('Bạn có chắc chắn muốn duyệt các vật tư đã chọn?');
            $('#customConfirmPopup').fadeIn(200);
        }

        // Đóng popup xác nhận
        function closeConfirmPopup() {
            console.log("[DEBUG YEUCAU] closeConfirmPopup được gọi");
            $('#customConfirmPopup').fadeOut(200);
            // Khi cancel, chỉ đóng popup, giữ nguyên trạng thái để người dùng có thể chỉnh sửa
            // Người dùng có thể dùng nút Cancel chính để reset nếu muốn
        }

        // Xử lý khi ấn nút Xác nhận trong popup
        function handlePopupConfirm() {
            console.log("[DEBUG YEUCAU] handlePopupConfirm được gọi");
            closeConfirmPopup();
            
            // Gọi trực tiếp hàm xử lý duyệt
            confirmBulkAction();
        }

        function confirmBulkAction() {
            console.log("[DEBUG YEUCAU] confirmBulkAction được gọi");
            console.log("[DEBUG YEUCAU] currentMaYeucau:", currentMaYeucau);
            
            if (!currentMaYeucau) {
                console.error("[DEBUG YEUCAU] ❌ currentMaYeucau rỗng!");
                alert('Vui lòng chọn một yêu cầu để xem chi tiết.');
                return;
            }

            var selectableCount = $('.vt-checkbox').length;
            console.log("[DEBUG YEUCAU] Số lượng checkbox:", selectableCount);
            
            if (selectableCount === 0) {
                console.error("[DEBUG YEUCAU] ❌ Không có checkbox nào!");
                alert('Không có vật tư nào để xử lý.');
                return;
            }

            // Thu thập dữ liệu: checkbox status + ghi chú cho từng vật tư
            var vatTuData = [];
            var hasError = false;
            var errorMessages = [];

            $('.vt-checkbox').each(function() {
                var $checkbox = $(this);
                var maVatTu = $checkbox.val();
                var isApproved = $checkbox.is(':checked'); // Tích = duyệt, không tích = từ chối
                var $row = $checkbox.closest('tr');
                var $ghichuInput = $row.find('.ghichu-input');
                var ghiChu = $ghichuInput.length > 0 ? $ghichuInput.val() : '';

                console.log("[DEBUG YEUCAU] Vật tư:", maVatTu, "isApproved:", isApproved, "ghiChu:", ghiChu);

                // Validation: Nếu từ chối (không tích) thì phải có ghi chú
                if (!isApproved && (!ghiChu || ghiChu.trim() === '')) {
                    hasError = true;
                    errorMessages.push('Vật tư ' + maVatTu + ' bị từ chối nhưng chưa có ghi chú.');
                }

                vatTuData.push({
                    MaSanpham: maVatTu,
                    IsApproved: isApproved,
                    GhiChu: ghiChu.trim()
                });
            });

            console.log("[DEBUG YEUCAU] Tổng số vật tư:", vatTuData.length);
            console.log("[DEBUG YEUCAU] VatTuData:", JSON.stringify(vatTuData));

            if (hasError) {
                console.error("[DEBUG YEUCAU] ❌ Có lỗi validation:", errorMessages);
                alert('Vui lòng điền ghi chú cho các vật tư bị từ chối:\n' + errorMessages.join('\n'));
                return;
            }

            // Gửi dữ liệu lên server
            console.log("[DEBUG YEUCAU] ✅ Gọi submitApprovalVatTuWithCheckbox");
            submitApprovalVatTuWithCheckbox(currentMaYeucau, vatTuData);
        }

        function clearBulkAction() {
            // Bỏ chọn tất cả checkbox
            $('.vt-checkbox').prop('checked', false);
            $('#selectAllVT').prop('checked', false);

            // Xóa ghi chú
            $('.ghichu-input').val('');

            // Bỏ highlight
            $('.tablethietbi tbody tr').removeClass('rejected-row');
            
            // Cập nhật nút hành động
            updateActionButtons();
        }

        function closeRejectAllPopup() {
            $('#rejectAllPopup').fadeOut(200);
        }

        function applyRejectReason() {
            var reason = ($('#rejectAllReason').val() || '').trim();
            if (!reason) {
                alert('Vui lòng nhập lý do từ chối.');
                return;
            }

            console.log("[DEBUG YEUCAU] applyRejectReason - Lý do:", reason);

            // Điền lý do từ chối vào các vật tư không được tích (bị từ chối)
            $('.vt-checkbox').each(function () {
                var $checkbox = $(this);
                var $row = $checkbox.closest('tr');
                
                // Nếu checkbox không được tích, đó là vật tư bị từ chối
                if (!$checkbox.is(':checked')) {
                    $row.addClass('rejected-row');
                    var $noteInput = $row.find('.ghichu-input');
                    if ($noteInput.length) {
                        // Fill vào input và trigger change event để đảm bảo UI cập nhật
                        $noteInput.val(reason).trigger('change');
                        console.log("[DEBUG YEUCAU] Đã fill lý do vào input cho vật tư:", $checkbox.val());
                    } else {
                        // Fallback: fill vào span nếu không có input
                        var $noteSpan = $row.find('.ghichu-column span');
                        if ($noteSpan.length) {
                            $noteSpan.text(reason).css('color', '#f44336');
                            console.log("[DEBUG YEUCAU] Đã fill lý do vào span cho vật tư:", $checkbox.val());
                        }
                    }
                }
            });

            console.log("[DEBUG YEUCAU] ✅ Đã fill xong lý do từ chối cho tất cả vật tư");
            
            // Ẩn popup sau khi điền dữ liệu
            closeRejectAllPopup();
        }

        function submitApprovalVatTuWithCheckbox(maYeucau, vatTuData) {
            console.log("[DEBUG YEUCAU] submitApprovalVatTuWithCheckbox được gọi");
            console.log("[DEBUG YEUCAU] maYeucau:", maYeucau);
            console.log("[DEBUG YEUCAU] vatTuData:", vatTuData);
            
            const pathSegments = window.location.pathname.split('/');
            const area = pathSegments.length > 1 ? pathSegments[1] : '';
            const url = `/${area}/Yeucau/XuLyVatTuYeucauWithCheckbox`;
            
            console.log("[DEBUG YEUCAU] URL:", url);
            console.log("[DEBUG YEUCAU] Area:", area);
            console.log("[DEBUG YEUCAU] requestToken:", requestToken ? "Có" : "Không có");
            
            $.ajax({
                url: url,
                method: 'POST',
                data: {
                    MaYeucau: maYeucau,
                    VatTuData: JSON.stringify(vatTuData),
                    __RequestVerificationToken: requestToken
                },
                success: function(response) {
                    console.log("[DEBUG YEUCAU] ✅ Response thành công:", response);
                    if (response.success) {
                        // Hiển thị cột trạng thái trước khi reload
                        $('.trangthai-column-header, .trangthai-column').css('display', 'table-cell');
                        alert(response.message || 'Đã xử lý thành công.');
                        // Reload lại trang để cập nhật trạng thái
                        location.reload();
                    } else {
                        console.error("[DEBUG YEUCAU] ❌ Response không thành công:", response);
                        alert(response.message || 'Có lỗi xảy ra.');
                    }
                },
                error: function(xhr, status, error) {
                    console.error("[DEBUG YEUCAU] ❌ Lỗi AJAX:");
                    console.error("[DEBUG YEUCAU] Status:", status);
                    console.error("[DEBUG YEUCAU] Error:", error);
                    console.error("[DEBUG YEUCAU] ResponseText:", xhr.responseText);
                    console.error("[DEBUG YEUCAU] Status Code:", xhr.status);
                    alert('Có lỗi xảy ra khi xử lý: ' + error + '\nChi tiết: ' + xhr.responseText);
                }
            });
        }
    </script>
