@{
    ViewData["Title"] = "Phieuxuatkho";
    Layout = "~/Areas/Giamdoc/Views/Layout/Layout.cshtml";
}
@model Webkho_20241021.Areas.Giamdoc.Data.Phieumuahangviewmodel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>yeucau</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
    <body>
        <nav class="bodyyeucau">
        <div class="menu-kho">
            <ul class="timkiem">
                <li class="menu-yeucau">
                    <a href="/Giamdoc/Yeucau/Yeucau">Vật tư yêu cầu</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-muahang">
                    <a href="/Giamdoc/Yeucau/Phieumuahang">Vật tư mua hàng</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                
                <li class="menu-nhapkho">
                    <a href="/Giamdoc/Yeucau/Phieunhapkho">Phiếu nhập kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-xuatkho">
                    <a href="/Giamdoc/Yeucau/Phieuxuatkho">Phiếu xuất kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
            </ul>
            <ul>
                <input type="text" id="timkiem" name="Timkiem" placeholder="Tìm kiếm" />
            </ul>
        </div>

            <div class="Tableyeucau">
                <table class="table">
                    <thead>
                        <tr>
                            <td>STT</td>
                            <td>Mã mua hàng</td>
                            <td>Mã yêu cầu</td>
                            <td>Mã dự án</td>
                            <td>Người yêu cầu</td>
                            <td>Ngày mua hàng</td>
                            <td>Trạng thái</td>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int STT = 1;
                        }
                        @foreach (var item in Model.Phieumuahang)
                        {
                            string ChucvuSession = Context.Session.GetString("Chucvu");
                            string BophanSession = Context.Session.GetString("Bophan");
                            <tr class="clickable-row" data-mamuahang="@item.MaMuahang" onclick="showVTmuahang('@item.MaMuahang', '@item.TrangThai')" style="cursor: pointer;">
                                <td>@STT</td>
                                <td>
                                    <a href="javascript:void(0);" onclick="event.stopPropagation(); showVTmuahang('@item.MaMuahang', '@item.TrangThai')" data-trangthai="@item.TrangThai">
                                        @item.MaMuahang
                                    </a>
                                </td>
                                <td>@item.MaYeucau</td>
                                <td>@item.MaDuan</td>
                                <td>@(string.IsNullOrEmpty(item.TenNguoiyeucau) ? item.MaNguoidung : item.TenNguoiyeucau)</td>
                                <td>@item.NgayMuahang?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @item.TrangThai
                                </td>
                            </tr>
                            STT++;
                        }
                    </tbody>
                </table>
            </div>
        </nav>

        <nav class="bodyyeucau-thietbi">
            <!-- This part is for the "Thietbi" section, using the MaMuahang from the current context -->
            <input type="hidden" id="selectedMamuahang" name="MaMuahang" value="@Model.Phieumuahang.FirstOrDefault()?.MaMuahang" />
            <div id="phieumuahang-header" class="yeucau-info" style="margin-bottom: 10px; padding: 10px; background-color: #f0f0f0; border-radius: 5px; display: none;">
                <strong id="phieumuahang-header-text"></strong>
            </div>
            <div class="Tableyeucau-thietbi-box">
                <table class="tablethietbi">
                    <thead>
                        <tr>
                            <td>STT</td>
                            <td>Tên vật tư</td>
                            <td>Mã vật tư</td>
                            <td>Mã kho</td>
                            <td>Hãng sx</td>
                            <td>Nhà cung cấp</td>
                            <td>Số lượng</td>
                            <td>Đơn vị</td>
                            <td>Đơn giá</td>
                            <td>Thành tiền</td>
                            <td>Trạng thái</td>
                        </tr>
                    </thead>
                    <tbody>                      
                    </tbody>
                </table>
            </div>
            <div class="action" style="justify-content: flex-end; display: none;" id="action-buttons">
                @if (Context.Session.GetString("Bophan") == "BP mua hàng")
                {
                    <button type="button" id="submitPhieumuahang">Gửi báo giá</button>
                }
                @* Chỉ hiển thị nút duyệt/từ chối cho Giám đốc - chỉ trong area Giamdoc *@
                @{
                    var currentArea = Context.Request.RouteValues["area"]?.ToString() ?? "";
                }
                @if (Context.Session.GetString("Chucvu") == "Giám đốc" && currentArea == "Giamdoc")
                {
                    <button type="button" id="approvePhieumuahang" class="btn-icon approve-btn" style="margin-left: 10px; display: none;">
                        <i class="bx bxs-check-circle"></i> Duyệt
                    </button>
                    <button type="button" id="rejectPhieumuahang" class="btn-icon reject-btn" style="margin-left: 10px; display: none;">
                        <i class="bx bxs-x-circle"></i> Từ chối
                    </button>
                }
            </div>
        </nav>
        <script src="~/js/phieumuahang.js"></script>
        <script>
            $(document).ready(function () {
                getThongbaoData();
                
                // Chức năng tìm kiếm
                $('#timkiem').on('keyup', function() {
                    var value = $(this).val().toLowerCase();
                    $('.table tbody tr').filter(function() {
                        var match = false;
                        $(this).find('td').each(function() {
                            var text = $(this).text().toLowerCase();
                            if (text.indexOf(value) > -1) {
                                match = true;
                                return false; // break loop
                            }
                        });
                        $(this).toggle(match);
                    });
                });
            });
        </script>
    </body>

</html>
