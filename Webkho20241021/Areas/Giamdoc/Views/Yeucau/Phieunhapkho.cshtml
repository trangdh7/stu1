
@{
    ViewData["Title"] = "Phieunhapkho";
    Layout = "~/Areas/Giamdoc/Views/Layout/Layout.cshtml";
}
@model Webkho_20241021.Areas.Giamdoc.Data.Phieunhapkhoviewmodel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>yeucau</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>

    <nav class="bodyyeucau">
        <div class="menu-kho">
            <ul class="timkiem">
                <li class="menu-yeucau">
                    <a href="/Giamdoc/Yeucau/Yeucau">Vật tư yêu cầu</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-muahang">
                    <a href="/Giamdoc/Yeucau/Phieumuahang">Vật tư mua hàng</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>

                <li class="menu-nhapkho">
                    <a href="/Giamdoc/Yeucau/Phieunhapkho">Phiếu nhập kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-xuatkho">
                    <a href="/Giamdoc/Yeucau/Phieuxuatkho">Phiếu xuất kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
            </ul>
            <ul>
                <input type="text" id="timkiem" name="Timkiem" placeholder="Tìm kiếm" />
            </ul>
        </div>

        <div class="Tableyeucau">
            <table class="table">
                <thead>
                    <tr>
                        <td>STT</td>
                        <td>Mã nhập kho</td>
                        <td>Mã yêu cầu</td>
                        <td>Mã dự án</td>
                        <td>Người yêu cầu</td>
                        <td>Ngày nhập kho</td>
                        <td>Trạng thái</td>
                        <td>Thao tác</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int STT = 1;
                    }
                    @foreach (var item in Model.Phieunhapkho)
                    {
                        string ChucvuSession = Context.Session.GetString("Chucvu");
                        string BophanSession = Context.Session.GetString("Bophan");
                        <tr class="clickable-row" data-manhapkho="@item.MaNhapkho" onclick="showVTnhapkho('@item.MaNhapkho')" style="cursor: pointer;">
                            <td>@STT</td>
                            <td>
                                <a href="javascript:void(0);" onclick="event.stopPropagation(); showVTnhapkho('@item.MaNhapkho')">
                                    @item.MaNhapkho
                                </a>
                            </td>
                            <td>@item.MaYeucau</td>
                            <td>@item.MaDuan</td>
                            <td>@item.MaNguoidung</td>
                            <td>@item.NgayNhapkho?.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span>@item.TrangThai</span>
                            </td>
                            <td>
                                @if (item.TrangThai == "Đã nhập kho")
                                {
                                    <a href="@Url.Action("InPhietrahang", "Yeucau", new { area = "Giamdoc", MaNhapkho = item.MaNhapkho })" 
                                       target="_blank" 
                                       class="btn-icon" 
                                       title="In phiếu"
                                       onclick="event.stopPropagation();">
                                        <i class="bx bx-printer"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                        STT++;
                    }
                </tbody>
            </table>
        </div>
        <div class="action">
            <ul class="hanhdong">
                <li>
                    <a href="/Giamdoc/Yeucau/ThemPhieunhapkho">Thêm phiếu nhập kho</a>
                </li>
            </ul>
        </div>
    </nav>
    <nav class="bodyyeucau-thietbi">
        <div id="phieunhapkho-header" class="yeucau-info" style="margin-bottom: 10px; padding: 10px; background-color: #f0f0f0; border-radius: 5px; display: none;">
            <strong id="phieunhapkho-header-text"></strong>
        </div>
        <div class="Tableyeucau-thietbi-box">
            <table class="tablethietbi">
                <thead>
                    <tr>
                        <td>STT</td>
                        <td>Tên vật tư</td>
                        <td>Mã vật tư</td>
                        <td>Mã kho</td>
                        <td>Hãng sx</td>
                        <td>Nhà cung cấp</td>
                        <td>Số lượng</td>
                        <td>Đơn vị</td>
                        <td>Trạng thái</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int ST = 1;
                    }
                    @foreach (var item in Model.VTphieunhapkho)
                    {
                        <tr>
                            <td>@ST</td>
                            <td>@item.TenSanpham</td>
                            <td>@item.MaSanpham</td>    
                            <td>@item.Makho</td>
                            <td>@item.HangSX</td>
                            <td>@item.NhaCC</td>
                            <td>@item.SL</td>
                            <td>@item.DonVi</td>
                        </tr>
                        ST++;
                    }
                </tbody>
            </table>
        </div>
        <div style="text-align: right; padding: 20px 20px 0 0;">
            <button id="btn-duyet" type="button" style="background-color: #336600; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; font-weight: bold; display: none; margin-left: 10px;">
                Duyệt
            </button>
            <button id="btn-tuchoi" type="button" style="background-color: #336600; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; font-weight: bold; display: none; margin-left: 10px;">
                Từ chối
            </button>
        </div>
    </nav>
    @inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
    @{
        var requestToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    }
    <input type="hidden" id="RequestVerificationToken" name="__RequestVerificationToken" value="@requestToken" />
    <script src="~/js/phieunhapkho.js"></script>
    <script>
        $(document).ready(function () {
            getThongbaoData();
            
            // Chức năng tìm kiếm
            $('#timkiem').on('keyup', function() {
                var value = $(this).val().toLowerCase();
                $('.table tbody tr').filter(function() {
                    var match = false;
                    $(this).find('td').each(function() {
                        var text = $(this).text().toLowerCase();
                        if (text.indexOf(value) > -1) {
                            match = true;
                            return false; // break loop
                        }
                    });
                    $(this).toggle(match);
                });
            });

            // Xử lý nút Duyệt
            $('#btn-duyet').on('click', function() {
                if (!selectedManhapkho) {
                    alert("Vui lòng chọn phiếu nhập kho trước.");
                    return;
                }
                
                if (!confirm("Bạn có chắc chắn muốn duyệt phiếu nhập kho " + selectedManhapkho + "?")) {
                    return;
                }
                
                submitPhieunhapkhoAction('approve');
            });

            // Xử lý nút Từ chối
            $('#btn-tuchoi').on('click', function() {
                if (!selectedManhapkho) {
                    alert("Vui lòng chọn phiếu nhập kho trước.");
                    return;
                }
                
                if (!confirm("Bạn có chắc chắn muốn từ chối phiếu nhập kho " + selectedManhapkho + "?")) {
                    return;
                }
                
                submitPhieunhapkhoAction('reject');
            });

            // Hàm submit action
            function submitPhieunhapkhoAction(action) {
                const pathSegments = window.location.pathname.split('/');
                const area = pathSegments.length > 1 ? pathSegments[1] : '';
                const url = `/${area}/Yeucau/Xuliphieunhapkho`;
                
                // Tạo form để submit
                const form = $('<form>', {
                    method: 'POST',
                    action: url
                });
                
                form.append($('<input>', {
                    type: 'hidden',
                    name: 'MaNhapkho',
                    value: selectedManhapkho
                }));
                
                form.append($('<input>', {
                    type: 'hidden',
                    name: 'submitAction',
                    value: action
                }));
                
                // Thêm token chống CSRF
                const token = $('#RequestVerificationToken').val() || $('input[name="__RequestVerificationToken"]').val();
                if (token) {
                    form.append($('<input>', {
                        type: 'hidden',
                        name: '__RequestVerificationToken',
                        value: token
                    }));
                }
                
                $('body').append(form);
                form.submit();
            }

            // Lưu hàm vào global scope để có thể gọi từ phieunhapkho.js
            window.submitPhieunhapkhoAction = submitPhieunhapkhoAction;

            // Ẩn các nút khi trang tải
            $('#btn-duyet').hide();
            $('#btn-tuchoi').hide();
        });
    </script>
</body>
</html>










