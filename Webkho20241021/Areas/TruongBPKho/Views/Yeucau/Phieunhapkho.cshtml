@{
    ViewData["Title"] = "Phieunhapkho";
    Layout = "~/Areas/TruongBPKho/Views/Layout/Layout.cshtml";
}
@model Webkho_20241021.Areas.TruongBPKho.Data.Phieunhapkhoviewmodel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>yeucau</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>

    @if (TempData["Success"] != null)
    {
        @* <div class="alert alert-success" style="margin: 10px; padding: 15px; background-color: #d4edda; border: 1px solid #c3e6cb; border-radius: 5px; color: #155724;">
            <strong>Thành công!</strong> @TempData["Success"]
        </div> *@
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning" style="margin: 10px; padding: 15px; background-color: #fff3cd; border: 1px solid #ffeaa7; border-radius: 5px; color: #856404;">
            <strong>Cảnh báo!</strong> @TempData["Warning"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="margin: 10px; padding: 15px; background-color: #f8d7da; border: 1px solid #f5c6cb; border-radius: 5px; color: #721c24;">
            <strong>Lỗi!</strong> @TempData["Error"]
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info" style="margin: 10px; padding: 15px; background-color: #d1ecf1; border: 1px solid #bee5eb; border-radius: 5px; color: #0c5460;">
            <strong>Thông tin!</strong> @TempData["Info"]
        </div>
    }
    <nav class="bodyyeucau">
        <div class="menu-kho">
            <ul class="timkiem">
                <li class="menu-yeucau">
                    <a href="/TruongBPKho/Yeucau/Yeucau">Yêu cầu vật tư</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-muahang">
                    <a href="/TruongBPKho/Yeucau/Phieumuahang">Yêu cầu mua hàng</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>

                <li class="menu-nhapkho">
                    <a href="/TruongBPKho/Yeucau/Phieunhapkho">Phiếu nhập kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-xuatkho">
                    <a href="/TruongBPKho/Yeucau/Phieuxuatkho">Phiếu xuất kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
            </ul>
            <ul>
                <input type="text" id="timkiem" name="Timkiem" placeholder="Tìm kiếm" />
            </ul>
        </div>

        <div class="Tableyeucau">
            <table class="table">
                <thead>
                    <tr>
                        <td>STT</td>
                        <td>Mã nhập kho</td>
                        <td>Mã yêu cầu</td>
                        <td>Mã dự án</td>
                        <td>Người yêu cầu</td>
                        <td>Ngày nhập kho</td>
                        <td>Trạng thái</td>
                        <td>Thao tác</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int STT = 1;
                    }
                    @foreach (var item in Model.Phieunhapkho)
                    {
                        string ChucvuSession = Context.Session.GetString("Chucvu");
                        string BophanSession = Context.Session.GetString("Bophan");
                        <tr class="clickable-row" data-manhapkho="@item.MaNhapkho" style="cursor: pointer;">
                            <td>@STT</td>
                            <td>
                                <a href="/TruongBPKho/Yeucau/XemPhieunhapkho?MaNhapkho=@item.MaNhapkho" 
                                   title="Click để xem vật tư, Double-click để xem chi tiết phiếu nhập kho" 
                                   class="manhapkho-link"
                                   data-manhapkho="@item.MaNhapkho"
                                   onclick="event.stopPropagation();">
                                    @item.MaNhapkho
                                </a>
                            </td>
                            <td>@item.MaYeucau</td>
                            <td>@item.MaDuan</td>
                            <td>@item.MaNguoidung</td>
                            <td>@item.NgayNhapkho?.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span>@item.TrangThai</span>
                            </td>
                            <td>
                                @if (item.TrangThai == "Đã nhập kho")
                                {
                                    @* Kiểm tra xem có phải phiếu nhập kho hoàn trả không (NHAPKHO_DUAN, NHAPKHO_CANHAN) *@
                                    bool isNhapKhoDuanOrCaNhan = !string.IsNullOrEmpty(item.MaYeucau) && 
                                                                 (item.MaYeucau.StartsWith("NHAPKHO_DUAN_", StringComparison.OrdinalIgnoreCase) || 
                                                                  item.MaYeucau.StartsWith("NHAPKHO_CANHAN_", StringComparison.OrdinalIgnoreCase));
                                    
                                    if (isNhapKhoDuanOrCaNhan)
                                    {
                                        @* Phiếu nhập kho hoàn trả → In phiếu trả hàng *@
                                        <a href="@Url.Action("InPhietrahang", "Yeucau", new { area = "TruongBPKho", MaNhapkho = item.MaNhapkho })" 
                                           target="_blank" 
                                           class="btn-icon" 
                                           title="In phiếu trả hàng"
                                           onclick="event.stopPropagation();">
                                            <i class="bx bx-printer"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        @* Phiếu nhập kho thông thường (mua hàng về) → In phiếu nhập kho *@
                                        <a href="@Url.Action("InPhieunhapkho", "Yeucau", new { area = "TruongBPKho", MaNhapkho = item.MaNhapkho })" 
                                           target="_blank" 
                                           class="btn-icon" 
                                           title="In phiếu nhập kho"
                                           onclick="event.stopPropagation();">
                                            <i class="bx bx-printer"></i>
                                        </a>
                                    }
                                }
                            </td>
                        </tr>
                        STT++;
                    }
                </tbody>
            </table>
        </div>
        <div class="action">
            <ul class="hanhdong">
                <li>
                    <a href="/TruongBPKho/Yeucau/ThemPhieunhapkho">Thêm phiếu nhập kho</a>
                </li>
            </ul>
        </div>
        <div id="phieunhapkho-header" class="yeucau-info" style="margin-bottom: 10px; padding: 10px; background-color: #f0f0f0; border-radius: 5px; display: none;">
            <span id="phieunhapkho-header-text"></span>
        </div>
    </nav>
    <nav class="bodyyeucau-thietbi">
        <div class="Tableyeucau-thietbi-box">
            <table class="tablethietbi">
                <thead>
                    <tr>
                        <td>STT</td>
                        <td>Tên vật tư</td>
                        <td>Mã vật tư</td>
                        <td>Mã kho</td>
                        <td>Hãng sx</td>
                        <td>Nhà cung cấp</td>
                        <td>Số lượng</td>
                        <td>Đơn vị</td>
                        <td>Trạng thái</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int ST = 1;
                    }
                    @if (Model.VTphieunhapkho != null && Model.VTphieunhapkho.Any())
                    {
                        @foreach (var item in Model.VTphieunhapkho)
                        {
                            <tr>
                                <td>@ST</td>
                                <td>@item.TenSanpham</td>
                                <td>@item.MaSanpham</td>
                                <td>@item.Makho</td>
                                <td>@item.HangSX</td>
                                <td>@item.NhaCC</td>
                                <td>@item.SL</td>
                                <td>@item.DonVi</td>
                                <td>@item.TrangThai</td>
                            </tr>
                            ST++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" style="text-align:center;">Không có dữ liệu vật tư.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div style="text-align: right; margin-top: 15px; padding-right: 0;">
            <button id="btn-nhapkho" type="button" style="background-color: #336600; color: white; border: none; padding: 10px 20px; cursor: pointer; font-size: 14px; font-weight: bold; display: none; float: right; margin-right: 20px;">
                Nhập kho
            </button>
        </div>
        <div style="clear: both;"></div>
    </nav>
    <script src="~/js/phieunhapkho.js"></script>
    <script>
        $(document).ready(function () {
            if (typeof getThongbaoData === 'function') {
            getThongbaoData();
            }
        });
    </script>
</body>
</html>










