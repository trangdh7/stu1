        }
        .duyet-column .reject-btn {
            color: #f44336;
        }
        .duyet-column .reject-btn:hover {
            color: #da190b;
        }
        .action-duyet {
            margin-top: 15px;
            padding: 10px 0;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 16px;
        }
        .action-duyet-left,
        .action-duyet-right {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .btn-duyet-tatca,
        .btn-tuchoi-tatca,
        .btn-xacnhan,
        .btn-xoa-tatca {
            padding: 8px 14px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            border: none;
            min-width: 110px;
        }
        .btn-duyet-tatca {
            background-color: #4caf50;
            color: #fff;
        }
        .btn-duyet-tatca:hover {
            background-color: #45a049;
        }
        .btn-tuchoi-tatca {
            background-color: #f44336;
            color: #fff;
        }
        .btn-tuchoi-tatca:hover {
            background-color: #d32f2f;
        }
        .btn-xacnhan {
            background-color: #1976d2;
            color: #fff;
        }
        .btn-xacnhan:hover {
            background-color: #1565c0;
        }
        .btn-xoa-tatca {
            background-color: #9e9e9e;
            color: #fff;
        }
        .btn-xoa-tatca:hover {
            background-color: #757575;
        }
        .vt-checkbox {
            cursor: pointer;
        }
        .pending-approval {
            background-color: #fff9c4 !important;
