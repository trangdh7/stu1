        }
        .btn-popup-cancel:hover {
            background: #d32f2f;
        }
        @@keyframes popupFadeIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }
    </style>
</body>
