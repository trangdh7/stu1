@{
    ViewData["Title"] = "Phieuxuatkho";
    Layout = "~/Areas/TruongBPKho/Views/Layout/Layout.cshtml";
}
@model Webkho_20241021.Areas.TruongBPKho.Data.Phieuxuatkhoviewmodel
@using System.Text.Json
@{
    var errorMessage = TempData["Error"] as string;
    var infoMessage = TempData["Info"] as string;
    var successMessage = TempData["Success"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>yeucau</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>

    <nav class="bodyyeucau">
        <div class="menu-kho">
            <ul class="timkiem">
                <li class="menu-yeucau">
                    <a href="/TruongBPKho/Yeucau/Yeucau">Yêu cầu vật tư</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-muahang">
                    <a href="/TruongBPKho/Yeucau/Phieumuahang">Yêu cầu mua hàng</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>

                <li class="menu-nhapkho">
                    <a href="/TruongBPKho/Yeucau/Phieunhapkho">Phiếu nhập kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-xuatkho">
                    <a href="/TruongBPKho/Yeucau/Phieuxuatkho">Phiếu xuất kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
            </ul>
            <ul>
                <input type="text" id="timkiem" name="Timkiem" placeholder="Tìm kiếm" />
            </ul>
        </div>

        <div class="Tableyeucau">
            <table class="table">
                <thead>
                    <tr>
                        <td>STT</td>
                        <td>Mã xuất kho</td>
                        <td>Mã yêu cầu</td>
                        <td>Mã dự án</td>
                        <td>Người yêu cầu</td>
                        <td>Ngày xuất kho</td>
                        <td>Trạng thái</td>
                        <td>In phiếu</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int STT = 1;
                    }
                    @foreach (var item in Model.Phieuxuatkho)
                    {
                        string ChucvuSession = Context.Session.GetString("Chucvu");
                        string BophanSession = Context.Session.GetString("Bophan");
                        <tr class="clickable-row" data-maxuatkho="@item.MaXuatkho" data-trangthai="@item.TrangThai" data-bophan="@BophanSession" style="cursor: pointer;">
                            <td>@STT</td>
                            <td>
                                <a href="javascript:void(0);" onclick="event.stopPropagation(); showVTxuatkho('@item.MaXuatkho')">
                                    @item.MaXuatkho
                                </a>
                            </td>
                            <td>@item.MaYeucau</td>
                            <td>@item.MaDuan</td>
                            <td>@item.MaNguoidung</td>
                            <td>
                                @{
                                    var trangThaiXuat = item.TrangThai ?? "";
                                    var daXuatKho = trangThaiXuat == "Đã lấy hàng"
                                        || trangThaiXuat == "Đã xuất kho"
                                        || trangThaiXuat == "Chờ người yêu cầu xác nhận"
                                        || trangThaiXuat == "Chờ xác nhận nhận hàng"
                                        || trangThaiXuat == "Đã xác nhận nhận hàng"
                                        || trangThaiXuat == "Hoàn thành";
                                }
                                @if (daXuatKho && item.NgayXuatkho.HasValue)
                                {
                                    @item.NgayXuatkho.Value.ToString("dd/MM/yyyy")
                                }
                            </td>
                            <td>
                                @if (item.TrangThai == "Chờ xác nhận" && BophanSession == "BP kho")
                                {
                                    <span data-has-button="true" data-ma-xuatkho="@item.MaXuatkho" data-action="approve">@item.TrangThai</span>
                                }
                                else if (item.TrangThai == "Đang chuẩn bị hàng" && BophanSession == "BP kho")
                                {
                                    <span data-has-button="true" data-ma-xuatkho="@item.MaXuatkho" data-action="approve">@item.TrangThai</span>
                                }
                                else if (item.TrangThai == "Chờ lấy hàng" && BophanSession == "BP kho")
                                {
                                    <span data-has-button="true" data-ma-xuatkho="@item.MaXuatkho" data-action="approve">@item.TrangThai</span>
                                }
                                else if (item.TrangThai == "Chờ xác nhận nhận hàng" && BophanSession == "BP kho")
                                {
                                    <span class="status-waiting" style="color: #ffc107; font-weight: bold;">
                                        Chờ người yêu cầu xác nhận
                                    </span>
                                }
                                else if (item.TrangThai == "Đã xác nhận nhận hàng")
                                {
                                    <span class="status-waiting" style="color: #28a745; font-weight: bold;">
                                        Đã xác nhận nhận hàng
                                    </span>
                                }
                                else if (item.TrangThai == "Đã lấy hàng" && BophanSession == "BP kho")
                                {
                                    <span data-has-button="true" data-ma-xuatkho="@item.MaXuatkho" data-action="approve">@item.TrangThai</span>
                                }
                                else if ((item.TrangThai == "Thiếu hàng - Chờ tạo phiếu mua" || item.TrangThai == "Thiếu hàng - Đã tạo phiếu mua") && BophanSession == "BP kho")
                                {
                                    <span data-has-button-muahang="true" data-ma-xuatkho="@item.MaXuatkho" data-action="taophieumuahang" style="color: #dc3545; font-weight: bold;">@item.TrangThai</span>
                                }
                                else
                                {
                                    @item.TrangThai
                                }
                            </td>
                            <td>
                                <a class="btn-icon" target="_blank" href='@Url.Action("InPhieuxuatkho", "Yeucau", new { area = "TruongBPKho", MaXuatkho = item.MaXuatkho })' title="In phiếu xuất kho">
                                    <i class="bx bx-printer"></i>
                                </a>
                            </td>
                        </tr>
                        STT++;
                    }
                </tbody>
            </table>
        </div>
        <div id="phieuxuatkho-header" class="yeucau-info" style="margin-bottom: 10px; padding: 10px; background-color: #f0f0f0; border-radius: 5px; display: none;">
            <span id="phieuxuatkho-header-text"></span>
        </div>
    </nav>
    <nav class="bodyyeucau-thietbi">
        <div class="Tableyeucau-thietbi-box">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" style="margin-bottom:10px; padding: 15px; border-radius: 5px; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb;">
                    <strong>Lỗi:</strong> @errorMessage
                </div>
            }
            @if (!string.IsNullOrEmpty(infoMessage))
            {
                <div class="alert alert-info" style="margin-bottom:10px; padding: 15px; border-radius: 5px; background-color: #d1ecf1; color: #0c5460; border: 1px solid #bee5eb;">
                    <strong>Thông báo:</strong> @infoMessage
                </div>
            }
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success" style="margin-bottom:10px; padding: 15px; border-radius: 5px; background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb;">
                    <strong>Thành công:</strong> @successMessage
                </div>
            }
            <style>
                /* (Dùng CSS theo class ở `wwwroot/css/yeucau.css` để áp dụng cho mọi area) */

                /* Cột Thao tác đủ rộng để nút Xuất Kho hiển thị đẹp */
                .tablethietbi thead tr td:last-child,
                .tablethietbi tbody tr td:last-child { min-width: 200px; width: 200px; padding: 8px; }
                .tablethietbi .btn-xuatkho-item { white-space: nowrap; min-height: 40px; width: 100%; max-width: 100%; box-sizing: border-box; justify-content: center; }
            </style>
            <table class="tablethietbi">
                <thead>
                    <tr>
                        <td>TT</td>
                        <td>Tên thiết bị/hàng hóa</td>
                        <td>Mã VT</td>
                        <td>Mã kho</td>
                        <td>Hãng SX</td>
                        <td>NCC</td>
                        <td>SL</td>
                        <td>Đã xuất</td>
                        <td>Cần xuất</td>
                        <td>SL tồn kho</td>
                        <td>ĐV</td>
                        <td>Trạng thái</td>
                        <td>Thao tác</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int ST = 1;
                    }
                    @foreach (var item in Model.VTphieuxuatkho)
                    {
                        <tr>
                            <td>@ST</td>
                            <td>@item.TenSanpham</td>
                            <td>@item.MaSanpham</td>
                            <td>@item.Makho</td>
                            <td>@item.HangSX</td>
                            <td>@item.NhaCC</td>
                            <td>@item.SL</td>
                            <td>@item.DonVi</td>
                        </tr>
                        ST++;
                    }
                </tbody>
            </table>
        </div>
        <div id="xuatkho-button-container" style="margin-top: 20px; text-align: right; padding-right: 20px; display: none;">
            <div id="xuatkho-button-content"></div>
        </div>
    </nav>
    <script src="~/js/phieuxuatkho.js"></script>
    <script>
        $(document).ready(function () {
            // Đảm bảo popup luôn ẩn khi load trang
            $('#popupTaoPhieuMuaHang').removeClass('show').hide();
            
            if (typeof getThongbaoData === 'function') {
                getThongbaoData();
            }
        });
    </script>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <script>
            console.error('Xuất kho (Trưởng BP Kho) lỗi:', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMessage)));
        </script>
    }

    <!-- Popup Tạo Phiếu Mua Hàng -->
    <div id="popupTaoPhieuMuaHang" class="popup-overlay" style="display: none;">
        <div class="popup-content" style="max-width: 800px; max-height: 90vh; overflow-y: auto;">
            <div class="popup-header" style="background-color: #dc3545; color: white; padding: 15px; border-radius: 5px 5px 0 0;">
                <h3 style="margin: 0;">Tạo Phiếu Mua Hàng</h3>
            </div>
            <div class="popup-body" style="padding: 20px;">
                <p style="margin-bottom: 15px; color: #dc3545; font-weight: bold;">Phiếu xuất kho thiếu hàng. Vui lòng xem chi tiết các vật tư thiếu bên dưới:</p>
                <table class="table" style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                    <thead>
                        <tr style="background-color: #343a40;">
                            <th style="padding: 10px; border: 1px solid #dee2e6; text-align: left; color: white; font-weight: bold;">STT</th>
                            <th style="padding: 10px; border: 1px solid #dee2e6; text-align: left; color: white; font-weight: bold;">Tên vật tư</th>
                            <th style="padding: 10px; border: 1px solid #dee2e6; text-align: left; color: white; font-weight: bold;">Mã vật tư</th>
                            <th style="padding: 10px; border: 1px solid #dee2e6; text-align: right; color: white; font-weight: bold;">Số lượng thiếu</th>
                            <th style="padding: 10px; border: 1px solid #dee2e6; text-align: left; color: white; font-weight: bold;">Đơn vị</th>
                            <th style="padding: 10px; border: 1px solid #dee2e6; text-align: right; color: white; font-weight: bold;">Tồn kho</th>
                        </tr>
                    </thead>
                    <tbody id="thieuHangTableBody">
                        <!-- Dữ liệu sẽ được điền bằng JavaScript -->
                    </tbody>
                </table>
            </div>
            <div class="popup-footer" style="padding: 15px; background-color: #f8f9fa; border-radius: 0 0 5px 5px; text-align: right;">
                <form id="formTaoPhieuMuaHang" method="post" style="display: inline-block;">
                    <input type="hidden" id="hiddenMaXuatkho" name="MaXuatkho" />
                    <button type="submit" class="btn btn-primary" style="padding: 10px 20px; background-color: #007bff; color: white; border: none; border-radius: 5px; cursor: pointer; margin-right: 10px; font-weight: bold;">
                        <i class="bx bx-cart-add"></i> Tạo Phiếu Mua Hàng
                    </button>
                </form>
                <button type="button" id="btnHuyPopup" class="btn btn-secondary" style="padding: 10px 20px; background-color: #6c757d; color: white; border: none; border-radius: 5px; cursor: pointer;">
                    <i class="bx bx-x"></i> Hủy
                </button>
            </div>
        </div>
    </div>

    <style>
        .popup-overlay {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            height: 100% !important;
            background-color: rgba(0, 0, 0, 0.5) !important;
            z-index: 99999 !important;
            display: none !important; /* Mặc định ẩn */
            justify-content: center !important;
            align-items: center !important;
        }
        .popup-overlay.show {
            display: flex !important; /* Chỉ hiển thị khi có class 'show' */
        }
        .popup-content {
            background-color: white !important;
            border-radius: 5px !important;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1) !important;
            position: relative !important;
            z-index: 100000 !important;
        }
        .popup-header {
            margin: 0 !important;
        }
        .popup-body {
            max-height: 60vh;
            overflow-y: auto;
        }
    </style>

</body>
</html>










