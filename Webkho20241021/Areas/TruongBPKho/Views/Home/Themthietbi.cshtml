@{
    ViewData["Title"] = "Themyeucau";
    Layout = "~/Areas/TruongBPKho/Views/Layout/Layout.cshtml";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thêm Yêu Cầu Vật Tư</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

    <link href="~/css/themvattu.css" rel="stylesheet" />
</head>

<body class="bg-gradient-to-br from-gray-50 to-gray-100 min-h-screen">

<div class="max-w-5xl mx-auto px-4">

    <!-- Header Card -->
    <div class="bg-white rounded-2xl card-shadow p-8 mb-8">
        <div class="flex items-center gap-5">
            <div class="icon-box">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
            </div>
            <div>
                <h2 class="text-3xl font-bold bg-gradient-to-r from-purple-600 to-indigo-600 bg-clip-text text-transparent">
                    Thêm Yêu Cầu Vật Tư
                </h2>
                <p class="text-gray-500 mt-1">Danh sách vật tư cần yêu cầu từ kho</p>
            </div>
        </div>
    </div>

    @using (Html.BeginForm("ThemvattuSQL", "Home", new { area = "TruongBPKho" }, FormMethod.Post, false, new { @enctype = "multipart/form-data" }))
    {
        <div id="items-container">

            <!-- Card 1 -->
            <div class="item-card">
                <div class="item-number">1</div>

                <button type="button" class="btn-delete-card" onclick="deleteCard(this)">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                    Xóa
                </button>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mt-4">

                    <div class="lg:col-span-2">
                        <label class="label-modern">Tên vật tư<span class="required-star">*</span></label>
                        <input type="text" name="TenSanpham[]" placeholder="Nhập tên vật tư" required class="input-modern" />
                    </div>

                    <div>
                        <label class="label-modern">Mã vật tư<span class="required-star">*</span></label>
                        <input type="text" name="MaSanpham[]" placeholder="VD: VT001" required class="input-modern" />
                    </div>

                    <div>
                        <label class="label-modern">Hãng SX</label>
                        <input type="text" name="HangSX[]" placeholder="Hãng sản xuất" class="input-modern" />
                    </div>

                    <div>
                        <label class="label-modern">Nhà cung cấp</label>
                        <input type="text" name="NhaCC[]" placeholder="Nhà cung cấp" class="input-modern" />
                    </div>

                    <div>
                        <label class="label-modern">Số lượng<span class="required-star">*</span></label>
                        <input type="number" name="SL[]" required min="0" step="1" placeholder="0" class="input-modern" oninput="this.value = Math.max(0, parseInt(this.value) || 0)" />
                    </div>

                    <div>
                        <label class="label-modern">Đơn vị<span class="required-star">*</span></label>
                        <input type="text" name="DonVi[]" required placeholder="Cái, Hộp..." class="input-modern" />
                    </div>

                    <div>
                        <label class="label-modern">Ngày bảo hành</label>
                        <input type="date" name="NgayBaohanh[]" class="input-modern" />
                    </div>

                    <div>
                        <label class="label-modern">Hết hạn bảo hành</label>
                        <input type="date" name="ThoiGianBH[]" class="input-modern" />
                    </div>

                </div>
            </div>

        </div>

        <!-- Add Button -->
        <div class="mb-8">
            <button type="button" class="btn-add-row" onclick="addNewCard()">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                Thêm vật tư mới
            </button>
        </div>

        <!-- Submit section -->
        <div class="bg-white rounded-2xl card-shadow p-6">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3 text-gray-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <div>
                        <div class="font-semibold">Tổng số vật tư: <span id="total-count" class="text-indigo-600">1</span></div>
                        <div class="text-sm text-gray-500">Kiểm tra kỹ thông tin trước khi gửi yêu cầu</div>
                    </div>
                </div>

                <button type="submit" class="btn-submit">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    Gửi Yêu Cầu
                </button>
            </div>
        </div>
    }

</div>

<script>
    function addNewCard() {
        var container = document.getElementById('items-container');
        var lastCard = container.querySelector('.item-card:last-child');
        var newCard = lastCard.cloneNode(true);

        newCard.querySelectorAll('input').forEach(i => i.value = "");
        newCard.querySelector('.item-number').textContent = container.querySelectorAll('.item-card').length + 1;

        container.appendChild(newCard);
        updateTotalCount();
        
        // Add validation to newly added quantity input
        var quantityInput = newCard.querySelector('input[name="SL[]"]');
        if (quantityInput) {
            quantityInput.addEventListener('input', function() {
                if (this.value < 0) {
                    this.value = 0;
                }
            });
            quantityInput.addEventListener('keydown', function(e) {
                if (e.key === '-' || e.key === 'e' || e.key === 'E' || e.key === '+') {
                    e.preventDefault();
                }
            });
        }
        
        newCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function deleteCard(btn) {
        var container = document.getElementById('items-container');
        if (container.querySelectorAll('.item-card').length > 1) {
            btn.closest('.item-card').remove();
            updateCardNumbers();
            updateTotalCount();
        } else {
            alert("Phải có ít nhất một vật tư yêu cầu!");
        }
    }

    function updateCardNumbers() {
        document.querySelectorAll('.item-card').forEach((card, i) => {
            card.querySelector('.item-number').textContent = i + 1;
        });
    }

    function updateTotalCount() {
        document.getElementById('total-count').textContent = document.querySelectorAll('.item-card').length;
    }
    
    // Prevent negative numbers in quantity fields
    document.addEventListener('DOMContentLoaded', function() {
        var container = document.getElementById('items-container');
        if (container) {
            // Add event listeners to existing quantity inputs
            container.querySelectorAll('input[name="SL[]"]').forEach(function(input) {
                input.addEventListener('input', function() {
                    if (this.value < 0) {
                        this.value = 0;
                    }
                });
                input.addEventListener('keydown', function(e) {
                    // Prevent minus key, e, E, +
                    if (e.key === '-' || e.key === 'e' || e.key === 'E' || e.key === '+') {
                        e.preventDefault();
                    }
                });
            });
        }
    });
    
    // Form validation before submit
    document.addEventListener('DOMContentLoaded', function() {
        var form = document.querySelector('form');
        if (form) {
            form.addEventListener('submit', function(e) {
                var quantityInputs = document.querySelectorAll('input[name="SL[]"]');
                var hasNegative = false;
                quantityInputs.forEach(function(input) {
                    if (parseFloat(input.value) < 0) {
                        hasNegative = true;
                        input.value = 0;
                    }
                });
                if (hasNegative) {
                    alert('⚠️ Số lượng không được âm. Đã tự động điều chỉnh về 0.');
                }
            });
        }
    });
</script>

</body>
</html>
