@{
    ViewData["Title"] = "Đổi Mật Khẩu";
    Layout = "~/Areas/Admin/Views/Layout/Layout.cshtml";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đổi Mật Khẩu</title>

    <!-- Dùng lại CSS của trang tạo tài khoản -->
    <link href="~/css/taotaikhoan.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>

<div class="page-wrapper">
    <div class="form-card">

        <!-- HEADER -->
        <div class="form-header">
            <h1>Đổi Mật Khẩu</h1>
            <p>Cập nhật mật khẩu mới cho tài khoản người dùng</p>
        </div>

        <!-- FORM CONTENT -->
        <div class="form-content">
            @using (Html.BeginForm("DoiMatKhau", "User", new { area = "Admin", id = ViewBag.UserId }, FormMethod.Post))
            {
                <div class="form-section">
                    <div class="section-title">🔐 Nhập mật khẩu mới</div>

                    <div class="form-group">
                        <label>Mật khẩu mới <span class="required">*</span></label>
                        <input type="password" name="NewPassword" required minlength="6"
                               class="form-control" placeholder="Nhập mật khẩu mới" />
                    </div>

                    <div class="form-group">
                        <label>Xác nhận mật khẩu mới <span class="required">*</span></label>
                        <input type="password" name="ConfirmPassword" required minlength="6"
                               class="form-control" placeholder="Nhập lại mật khẩu" />
                    </div>
                </div>

                <!-- ACTION -->
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
                    <a href="/Admin/User/DanhSachUser" class="btn btn-secondary">Hủy</a>
                </div>

                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p>@error.ErrorMessage</p>
                        }
                    </div>
                }
            }
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
