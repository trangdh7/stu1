@model Webkho_20241021.Models.User

@{
    ViewData["Title"] = "Sửa User";
    Layout = "~/Areas/Admin/Views/Layout/Layout.cshtml";
}

@section Styles {
    <link href="~/css/taotaikhoan.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
}

<div class="page-wrapper">
    <div class="form-card">

        <div class="form-header">
            <h1>Sửa Thông Tin User</h1>
            <p>Cập nhật thông tin người dùng trong hệ thống</p>
        </div>

        <div class="form-content">
            @using (Html.BeginForm("SuaUser", "User", new { area = "Admin", id = Model.Id }, FormMethod.Post))
            {
                <div class="form-section">
                    <div class="section-title">👤 Thông tin cá nhân</div>

                    <div class="form-group">
                        <label>Username (không thể sửa)</label>
                        <input type="text" class="form-control" value="@Model.UserName" readonly />
                    </div>

                    <div class="form-group">
                        <label>Tên người dùng <span class="required">*</span></label>
                        <input type="text" name="Name" value="@Model.Name" required class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" name="Email" value="@Model.Email" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Số điện thoại</label>
                        <input type="text" name="PhoneNumber" value="@Model.PhoneNumber" class="form-control" />
                    </div>
                </div>

                <div class="form-section">
                    <div class="section-title">💼 Thông tin công việc</div>

                    <div class="form-group">
                        <label>Mã nhân viên <span class="required">*</span></label>
                        <input type="text" name="MaNV" value="@Model.manv" required class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Chức vụ <span class="required">*</span></label>
                        <select name="Chucvu" required class="form-select">
                            <option value="" disabled @(string.IsNullOrEmpty(Model.Chucvu) ? "selected" : null)>Chọn chức vụ</option>
                            <option value="Giám đốc" @(Model.Chucvu == "Giám đốc" ? "selected" : null)>Giám đốc</option>
                            <option value="Nhân viên" @(Model.Chucvu == "Nhân viên" ? "selected" : null)>Nhân viên</option>
                            <option value="Trưởng BP" @(Model.Chucvu == "Trưởng BP" ? "selected" : null)>Trưởng bộ phận</option>
                            <option value="Quản lí dự án" @(Model.Chucvu == "Quản lí dự án" ? "selected" : null)>Quản lí dự án</option>
                            <option value="Admin" @(Model.Chucvu == "Admin" ? "selected" : null)>Admin</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Bộ phận <span class="required">*</span></label>
                        <select name="Bophan" required class="form-select">
                            <option value="" disabled @(string.IsNullOrEmpty(Model.Bophan) ? "selected" : null)>Chọn bộ phận</option>
                            <option value="BP kỹ thuật" @(Model.Bophan == "BP kỹ thuật" ? "selected" : null)>BP kỹ thuật</option>
                            <option value="BP kho" @(Model.Bophan == "BP kho" ? "selected" : null)>BP kho</option>
                            <option value="BP mua hàng" @(Model.Bophan == "BP mua hàng" ? "selected" : null)>BP mua hàng</option>
                            <option value="BP kế toán" @(Model.Bophan == "BP kế toán" ? "selected" : null)>BP kế toán</option>
                            <option value="BP dự án" @(Model.Bophan == "BP dự án" ? "selected" : null)>BP dự án</option>
                            <option value="Admin" @(Model.Bophan == "Admin" ? "selected" : null)>Admin</option>
                        </select>
                    </div>
                </div>

                @* <div class="form-section">
                    <div class="section-title">🎯 Vai trò</div>

                    <label>Chọn Roles (Vai trò) - Có thể chọn nhiều</label>

                    <div class="checkbox-group">
                        @if (ViewBag.AllRoles != null)
                        {
                            var userRoles = ViewBag.UserRoles as IList<string> ?? new List<string>();
                            foreach (string role in ViewBag.AllRoles)
                            {
                                <div class="checkbox-item">
                                    <input type="checkbox"
                                           name="SelectedRoles"
                                           value="@role"
                                           id="role_@role"
                                           @(userRoles.Contains(role) ? "checked" : "") />

                                    <label for="role_@role">@role</label>
                                </div>
                            }
                        }
                    </div>

                    <span class="form-text">
                        Nếu không chọn role, hệ thống sẽ tự động gán role dựa trên Chức vụ và Bộ phận.
                    </span>
                </div> *@

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Cập nhật</button>
                    <a href="/Admin/User/DanhSachUser" class="btn btn-secondary">Hủy</a>
                </div>

                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p>@error.ErrorMessage</p>
                        }
                    </div>
                }
            }
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}
