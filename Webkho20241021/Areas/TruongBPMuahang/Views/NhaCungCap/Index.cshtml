@model List<Webkho_20241021.Models.NhaCungCap>
@{
    ViewData["Title"] = "Quản lý nhà cung cấp";
    Layout = "~/Areas/TruongBPMuahang/Views/Layout/Layout.cshtml";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />
    <style>
        .ncc-container { max-width: 900px; margin: 20px auto; padding: 0 20px; }
        .ncc-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 10px; }
        .ncc-title { font-size: 1.5rem; font-weight: 600; color: #1e3a5f; }
        .btn-add { padding: 8px 16px; background: #0c6215; color: white; border: none; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
        .btn-add:hover { background: #0a5012; color: white; }
        .ncc-table { width: 100%; border-collapse: collapse; background: white; box-shadow: 0 2px 8px rgba(0,0,0,0.08); border-radius: 8px; overflow: hidden; }
        .ncc-table th, .ncc-table td { padding: 12px 16px; text-align: left; border-bottom: 1px solid #eee; }
        .ncc-table th { background: #0d1348; color: white; font-weight: 600; }
        .ncc-table tr:hover { background: #f8f9fa; }
        .btn-edit { padding: 6px 12px; background: #1565c0; color: white; border: none; border-radius: 4px; text-decoration: none; font-size: 0.9rem; }
        .btn-edit:hover { background: #0d47a1; color: white; }
        .btn-delete { padding: 6px 12px; background: #c62828; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 0.9rem; }
        .btn-delete:hover { background: #b71c1c; }
        .alert-success { padding: 12px 16px; background: #e8f5e9; color: #2e7d32; border-radius: 6px; margin-bottom: 16px; }
    </style>
</head>
<body>
    <div class="ncc-container">
        @if (TempData["Message"] != null)
        {
            <div class="alert-success">@TempData["Message"]</div>
        }

        <div class="ncc-header">
            <h1 class="ncc-title">Quản lý nhà cung cấp</h1>
            <a href="/TruongBPMuahang/NhaCungCap/Create" class="btn-add">
                <i class='bx bx-plus'></i> Thêm nhà cung cấp
            </a>
        </div>

        <table class="ncc-table">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Tên nhà cung cấp</th>
                    <th>Ghi chú</th>
                    <th style="width: 140px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @{ int stt = 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@stt</td>
                        <td>@item.TenNhaCC</td>
                        <td>@(item.GhiChu ?? "-")</td>
                        <td>
                            <a href="/TruongBPMuahang/NhaCungCap/Edit/@item.ID" class="btn-edit">Sửa</a>
                            <form method="post" action="/TruongBPMuahang/NhaCungCap/Delete/@item.ID" style="display:inline;" onsubmit="return confirm('Bạn có chắc muốn xóa nhà cung cấp này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-delete">Xóa</button>
                            </form>
                        </td>
                    </tr>
                    stt++;
                }
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="4" style="text-align: center; padding: 24px; color: #666;">Chưa có nhà cung cấp nào. Nhấn "Thêm nhà cung cấp" để thêm mới.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
