@{
    ViewData["Title"] = "Phieuxuatkho";
    Layout = "~/Areas/TruongBPMuahang/Views/Layout/Layout.cshtml";
}
@model Webkho_20241021.Areas.TruongBPMuahang.Data.Phieumuahangviewmodel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>yeucau</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>

    <body>
        <nav class="bodyyeucau">
            <div class="menu-kho">
                <ul class="timkiem">
                <li class="menu-yeucau">
                    <a href="/TruongBPMuahang/Yeucau/Yeucau">Yêu cầu vật tư</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-muahang">
                    <a href="/TruongBPMuahang/Yeucau/Phieumuahang">Yêu cầu mua hàng</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-xuatkho">
                    <a href="/TruongBPMuahang/Yeucau/Phieuxuatkho">Phiếu xuất kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-nhapkho">
                    <a href="/TruongBPMuahang/Yeucau/Phieunhapkho">Phiếu nhập kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>

            </ul>
                <ul>
                    <input type="text" id="timkiem" name="Timkiem" placeholder="Tìm kiếm" />
                </ul>
            </div>

            <div class="Tableyeucau">
                <table class="table">
                    <thead>
                        <tr>
                            <td>STT</td>
                            <td>Mã mua hàng</td>
                            <td>Mã yêu cầu</td>
                            <td>Mã dự án</td>
                            <td>Người yêu cầu</td>
                            <td>Ngày mua hàng</td>
                            <td>Trạng thái</td>
                            <td>Hành động</td>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int STT = 1;
                        }
                        @foreach (var item in Model.Phieumuahang)
                        {
                            string ChucvuSession = Context.Session.GetString("Chucvu");
                            string BophanSession = Context.Session.GetString("Bophan");
                            <tr onclick="showVTmuahang('@item.MaMuahang', '@item.TrangThai')" style="cursor: pointer;">
                                <td>@STT</td>
                                <td>
                                    <a href="javascript:void(0);" onclick="event.stopPropagation(); showVTmuahang('@item.MaMuahang', '@item.TrangThai')" data-trangthai="@item.TrangThai">
                                        @item.MaMuahang
                                    </a>
                                </td>
                                <td>@item.MaYeucau</td>
                                <td>@item.MaDuan</td>
                                <td>@(string.IsNullOrEmpty(item.TenNguoiyeucau) ? item.MaNguoidung : item.TenNguoiyeucau)</td>
                                <td>@item.NgayMuahang?.ToString("dd/MM/yyyy")</td>
                                <td>@item.TrangThai</td>
                                <td>
                                    <a href="@Url.Action("InPhieumuahang", "Yeucau", new { area = "TruongBPMuahang", MaMuahang = item.MaMuahang })" 
                                       target="_blank" 
                                       class="btn-icon" 
                                       title="In phiếu"
                                       onclick="event.stopPropagation();">
                                        <i class="bx bx-printer"></i>
                                    </a>
                                </td>
                            </tr>
                            STT++;
                        }
                    </tbody>
                </table>
            </div>
        </nav>

        <nav class="bodyyeucau-thietbi">
            <!-- This part is for the "Thietbi" section, using the MaMuahang from the current context -->
            <input type="hidden" id="selectedMamuahang" name="MaMuahang" value="@Model.Phieumuahang.FirstOrDefault()?.MaMuahang" />
            <div id="phieumuahang-header" style="margin-top: 10px; margin-right: 10px; margin-bottom: 15px; font-size: 18px; font-weight: bold; display: none;">
            </div>
            <div class="Tableyeucau-thietbi-box">
                <table class="tablethietbi">
                    <thead>
                        <tr>
                            <td>STT</td>
                            <td>Tên vật tư</td>
                            <td>Mã vật tư</td>
                            <td>Mã kho</td>
                            <td>Hãng sx</td>
                            <td>Nhà cung cấp</td>
                            <td>Số lượng</td>
                            <td>Đơn vị</td>
                            <td>Đơn giá</td>
                            <td>Thành tiền</td>
                            <td>Trạng thái</td>
                        </tr>
                    </thead>
                    <tbody>                      
                    </tbody>
                </table>
            </div>
            <div class="action" id="action-buttons" style="justify-content: flex-end;">
                <button type="button" id="submitPhieumuahang">Gửi báo giá</button>
                <button type="button" id="approvePhieumuahang" style="display: none; margin-left: 10px; background-color: #336600; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer;">
                    <i class='bx bxs-check-circle'></i> Duyệt
                </button>
                <button type="button" id="rejectPhieumuahang" style="display: none; margin-left: 10px; background-color: #336600; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer;">
                    <i class='bx bxs-x-circle'></i> Từ chối
                </button>
            </div>
        </nav>
        <script src="~/js/phieumuahang.js"></script>
        <script>
            $(document).ready(function () {
                getThongbaoData();
            });
        </script>
    </body>

</html>
