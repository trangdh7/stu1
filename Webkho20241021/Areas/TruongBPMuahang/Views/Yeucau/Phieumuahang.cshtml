@{
    ViewData["Title"] = "Yêu cầu mua hàng";
    Layout = "~/Areas/TruongBPMuahang/Views/Layout/Layout.cshtml";
}
@model Webkho_20241021.Areas.TruongBPMuahang.Data.Phieumuahangviewmodel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>yeucau</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Flatpickr CSS và JS cho date picker -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/vn.js"></script>
</head>

    <body>
        <nav class="bodyyeucau">
            <div class="menu-kho">
                <ul class="timkiem">
                <li class="menu-yeucau">
                    <a href="/TruongBPMuahang/Yeucau/Yeucau">Yêu cầu vật tư</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-muahang">
                    <a href="/TruongBPMuahang/Yeucau/Phieumuahang">Yêu cầu mua hàng</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-nhapkho">
                    <a href="/TruongBPMuahang/Yeucau/Phieunhapkho">Phiếu nhập kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-xuatkho">
                    <a href="/TruongBPMuahang/Yeucau/Phieuxuatkho">Phiếu xuất kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>

            </ul>
                <ul>
                    <input type="text" id="timkiem" name="Timkiem" placeholder="Tìm kiếm" />
                </ul>
            </div>

            <div class="Tableyeucau">
                <table class="table">
                    <thead>
                        <tr>
                            <td style="width: 42px;"><input type="checkbox" id="chkAllPhieumuahang" title="Chọn tất cả" /></td>
                            <td>STT</td>
                            <td>Mã mua hàng</td>
                            <td>Mã yêu cầu</td>
                            <td>Mã dự án</td>
                            <td>Người yêu cầu</td>
                            <td>Ngày yêu cầu</td>
                            <td>Ngày mua hàng</td>
                            <td>Ngày cần</td>
                            <td>Trạng thái</td>
                            <td>Hành động</td>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int STT = 1;
                        }
                        @foreach (var item in Model.Phieumuahang)
                        {
                            string ChucvuSession = Context.Session.GetString("Chucvu");
                            string BophanSession = Context.Session.GetString("Bophan");
                            <tr class="clickable-row" data-mamuahang="@item.MaMuahang" onclick="showVTmuahang('@item.MaMuahang', '@item.TrangThai')" style="cursor: pointer;">
                                <td onclick="event.stopPropagation();"><input type="checkbox" class="chk-phieumuahang" value="@item.MaMuahang" data-mayeucau="@item.MaYeucau" data-maduan="@(item.MaDuan ?? "")" /></td>
                                <td>@STT</td>
                                <td>
                                    <a href="javascript:void(0);" onclick="event.stopPropagation(); showVTmuahang('@item.MaMuahang', '@item.TrangThai')" data-trangthai="@item.TrangThai">
                                        @item.MaMuahang
                                    </a>
                                </td>
                                <td>@item.MaYeucau</td>
                                <td>@item.MaDuan</td>
                                <td>@(string.IsNullOrEmpty(item.TenNguoiyeucau) ? item.MaNguoidung : item.TenNguoiyeucau)</td>
                                <td>@(item.NgayYeucau?.ToString("dd/MM/yyyy HH:mm") ?? "  ")</td>
                                <td>@item.NgayMuahang?.ToString("dd/MM/yyyy")</td>
                                <td>@(item.NgayCanHang?.ToString("dd/MM/yyyy") ?? "  ")</td>
                                <td>@item.TrangThai</td>
                                <td>
                                    <a href="@Url.Action("ExportPhieumuahangExcel", "Yeucau", new { area = "TruongBPMuahang", MaMuahang = item.MaMuahang })" 
                                       class="btn-icon" 
                                       title="Tải Excel"
                                       onclick="event.stopPropagation();">
                                        <i class="bx bx-download"></i>
                                    </a>
                                    <a href="@Url.Action("InPhieumuahang", "Yeucau", new { area = "TruongBPMuahang", MaMuahang = item.MaMuahang })" 
                                       target="_blank" 
                                       class="btn-icon" 
                                       title="In phiếu"
                                       onclick="event.stopPropagation();">
                                        <i class="bx bx-printer"></i>
                                    </a>
                                </td>
                            </tr>
                            STT++;
                        }
                    </tbody>
                </table>
            </div>
            <div class="toolbar-phieumuahang" style="margin-top: 10px; margin-bottom: 10px; display: flex; flex-direction: column; align-items: flex-end; gap: 6px;">
                <button type="button" id="btnXemChiTietSoSanh" class="btn-so-sanh" title="Chọn các yêu cầu cùng dự án rồi xem chi tiết gộp để mua hàng">
                    <i class='bx bx-list-check'></i> Xem chi tiết (đã chọn)
                </button>
                <span id="soSanhCount" style="color: #666; font-size: 13px;">Chọn ít nhất 1 yêu cầu</span>
            </div>
        </nav>

        <nav class="bodyyeucau-thietbi" id="bodyYeucauThietbi">
            <input type="hidden" id="selectedMamuahang" name="MaMuahang" value="@Model.Phieumuahang.FirstOrDefault()?.MaMuahang" />
            <div id="phieumuahang-header" class="yeucau-info-bar" style="margin-bottom: 10px; padding: 10px; background-color: #f0f0f0; border-radius: 5px; display: none;">
                <span class="yeucau-info"><strong id="phieumuahang-header-text"></strong></span>
                <div class="yeucau-table-actions">
                    <button type="button" class="btn-table-icon btn-minimize-table" title="Thu nhỏ" aria-label="Thu nhỏ"><svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><rect x="2" y="7" width="12" height="2" rx="0.5"/></svg></button>
                    <button type="button" class="btn-table-icon btn-maximize-table" title="Phóng to" aria-label="Phóng to"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="12" height="12" rx="0.5"/></svg></button>
                    <button type="button" class="btn-table-icon btn-restore-table" title="Thu nhỏ lại" aria-label="Thu nhỏ lại" style="display: none;"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="6" width="8" height="8" rx="0.5"/><rect x="6" y="2" width="8" height="8" rx="0.5" stroke-dasharray="1,1"/></svg></button>
                </div>
            </div>
            <div class="Tableyeucau-thietbi-box" id="TableyeucauThietbiBox">
                <table class="tablethietbi">
                    <thead>
                        <tr>
                            <td>TT</td>
                            <td>Tên thiết bị/hàng hóa</td>
                            <td>Mã VT</td>
                            @* <td>Mã kho</td> *@
                            <td>Hãng SX</td>
                            <td>NCC</td>
                            <td>SL</td>
                            <td>ĐV</td>
                            <td>Đơn giá</td>
                            <td>Thành tiền</td>
                            <td class="header-clickable" data-field="ngaythanhtoan" style="cursor: pointer; user-select: none;">Ngày Thanh Toán</td>
                            <td class="header-clickable" data-field="ngaycohang" style="cursor: pointer; user-select: none;">Ngày có hàng</td>
                            <td class="header-clickable" data-field="ghichu" style="cursor: pointer; user-select: none;">Ghi chú</td>
                            <td>Trạng thái</td>
                        </tr>
                    </thead>
                    <tbody>                      
                    </tbody>
                </table>
            </div>
            <div class="action" id="action-buttons" style="justify-content: flex-end;">
                <button type="button" id="submitPhieumuahang">Gửi báo giá</button>
                <button type="button" id="approvePhieumuahang" style="display: none; margin-left: 10px; background-color: #336600; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer;">
                    <i class='bx bxs-check-circle'></i> Duyệt
                </button>
                <button type="button" id="rejectPhieumuahang" style="display: none; margin-left: 10px; background-color: #336600; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer;">
                    <i class='bx bxs-x-circle'></i> Từ chối
                </button>
            </div>
        </nav>
        
        <!-- Popup nhập Ngày Thanh Toán -->
        <div id="popupNgayThanhToan" class="custom-popup-overlay" style="display: none;" onclick="if(event.target === this) closePopupNgayThanhToan();">
            <div class="custom-popup-content" onclick="event.stopPropagation();">
                <div class="custom-popup-header">
                    <h3>Nhập Ngày Thanh Toán</h3>
                </div>
                <div class="custom-popup-body">
                    <label for="inputNgayThanhToan">Nhập ngày thanh toán (dd/MM/yyyy):</label>
                    <!-- Dùng input text + flatpickr để chủ động định dạng dd/MM/yyyy -->
                    <input type="text"
                           id="inputNgayThanhToan"
                           placeholder="dd/MM/yyyy"
                           style="width:100%; margin-top:8px; padding:8px; border:1px solid #ddd; border-radius:4px;" />
                </div>
                <div class="custom-popup-footer">
                    <button type="button" class="btn-popup-confirm" onclick="applyNgayThanhToan()">Xong</button>
                    <button type="button" class="btn-popup-cancel" onclick="closePopupNgayThanhToan()">Hủy</button>
                </div>
            </div>
        </div>
        
        <!-- Popup nhập Ngày có hàng -->
        <div id="popupNgayCoHang" class="custom-popup-overlay" style="display: none;" onclick="if(event.target === this) closePopupNgayCoHang();">
            <div class="custom-popup-content" onclick="event.stopPropagation();">
                <div class="custom-popup-header">
                    <h3>Nhập Ngày có hàng</h3>
                </div>
                <div class="custom-popup-body">
                    <label for="inputNgayCoHang">Nhập ngày có hàng (dd/MM/yyyy):</label>
                    <!-- Dùng input text + flatpickr để chủ động định dạng dd/MM/yyyy -->
                    <input type="text"
                           id="inputNgayCoHang"
                           placeholder="dd/MM/yyyy"
                           style="width:100%; margin-top:8px; padding:8px; border:1px solid #ddd; border-radius:4px;" />
                </div>
                <div class="custom-popup-footer">
                    <button type="button" class="btn-popup-confirm" onclick="applyNgayCoHang()">Xong</button>
                    <button type="button" class="btn-popup-cancel" onclick="closePopupNgayCoHang()">Hủy</button>
                </div>
            </div>
        </div>
        
        <!-- Popup nhập Ghi chú -->
        <div id="popupGhiChu" class="custom-popup-overlay" style="display: none;" onclick="if(event.target === this) closePopupGhiChu();">
            <div class="custom-popup-content" onclick="event.stopPropagation();">
                <div class="custom-popup-header">
                    <h3>Nhập Ghi chú</h3>
                </div>
                <div class="custom-popup-body">
                    <label for="inputGhiChu">Nhập ghi chú:</label>
                    <textarea id="inputGhiChu" style="width:100%; min-height:90px; margin-top:8px; padding:8px; border:1px solid #ddd; border-radius:4px;" placeholder="Nhập ghi chú..."></textarea>
                </div>
                <div class="custom-popup-footer">
                    <button type="button" class="btn-popup-confirm" onclick="applyGhiChu()">Xong</button>
                    <button type="button" class="btn-popup-cancel" onclick="closePopupGhiChu()">Hủy</button>
                </div>
            </div>
        </div>
        
        <style>
        /* Popup xác nhận tùy chỉnh */
        .custom-popup-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 10000;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .custom-popup-content {
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
            min-width: 400px;
            max-width: 500px;
            overflow: hidden;
        }
        .custom-popup-header {
            background-color: #1976d2;
            color: white;
            padding: 15px 20px;
        }
        .custom-popup-header h3 {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
        }
        .custom-popup-body {
            padding: 20px;
            font-size: 15px;
            color: #333;
        }
        .custom-popup-footer {
            padding: 15px 20px;
            background-color: #f5f5f5;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }
        .btn-popup-confirm {
            padding: 8px 20px;
            background-color: #1976d2;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
        }
        .btn-popup-confirm:hover {
            background-color: #1565c0;
        }
        .btn-popup-cancel {
            padding: 8px 20px;
            background-color: #9e9e9e;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
        }
        .btn-popup-cancel:hover {
            background-color: #757575;
        }
        .header-clickable {
            background-color: #4a26ab !important;
            color: #ffffff !important;
            font-weight: 600;
        }
        .header-clickable:hover {
            background-color: #ffe0b2 !important;
            color: #bf360c !important;
        }

        /* Split (chia lô) rows */
        .vt-split-row td {
            background: #fafafa;
        }
        .btn-split-add, .btn-split-remove {
            border: 1px solid #ccc;
            background: #fff;
            padding: 4px 8px;
            cursor: pointer;
            border-radius: 4px;
            font-size: 13px;
        }
        .btn-split-add:hover, .btn-split-remove:hover {
            background: #f0f7ff;
        }
        .btn-split-add-inline {
            margin-left: 6px;
            padding: 2px 6px;
            font-size: 12px;
            line-height: 1;
            vertical-align: middle;
        }
        .split-hint {
            font-size: 11px;
            color: #666;
            display: block;
            margin-top: 2px;
        }
        /* Nút Xem chi tiết (đã chọn) - dưới bảng, bên phải */
        .btn-so-sanh {
            padding: 8px 16px;
            background-color: #1976d2;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-so-sanh:hover {
            background-color: #1565c0;
            color: white;
        }
        .btn-so-sanh:active {
            background-color: #0d47a1;
            color: white;
        }
        </style>
        
        <!-- Thêm query string để tránh cache, đảm bảo luôn lấy file js mới -->
        <script src="~/js/phieumuahang.js?v=20260206"></script>
        <script src="~/js/yeucau-table-actions.js"></script>
        <script>
            $(document).ready(function () {
                if (typeof getThongbaoData === 'function') {
                    getThongbaoData();
                }
                
                // Chọn/bỏ chọn tất cả phiếu mua hàng
                $('#chkAllPhieumuahang').on('change', function () {
                    var checked = $(this).prop('checked');
                    $('.chk-phieumuahang').prop('checked', checked);
                    updateSoSanhCount();
                });
                $('.chk-phieumuahang').on('change', function () { updateSoSanhCount(); });
                function updateSoSanhCount() {
                    var n = $('.chk-phieumuahang:checked').length;
                    $('#soSanhCount').text(n === 0 ? 'Chọn ít nhất 1 yêu cầu' : 'Đã chọn ' + n + ' yêu cầu');
                }
                updateSoSanhCount();

                // Xem chi tiết so sánh: mở tab mới với các mã đã chọn
                $('#btnXemChiTietSoSanh').on('click', function (e) {
                    e.preventDefault();
                    var ids = $('.chk-phieumuahang:checked').map(function () { return $(this).val(); }).get();
                    if (!ids || ids.length === 0) {
                        alert('Vui lòng chọn ít nhất một yêu cầu mua hàng.');
                        return;
                    }
                    var url = '/TruongBPMuahang/Yeucau/SoSanhPhieumuahang?ids=' + encodeURIComponent(ids.join(','));
                    window.open(url, '_blank', 'noopener,noreferrer');
                });
                
                // Khởi tạo Flatpickr cho popup input ngày thanh toán / ngày có hàng
                if (typeof flatpickr !== 'undefined') {
                    flatpickr("#inputNgayThanhToan", {
                        dateFormat: "d/m/Y",   // hiển thị dd/MM/yyyy
                        locale: flatpickr.l10ns.vn || "vn",
                        allowInput: true,
                        clickOpens: true
                    });
                    
                    flatpickr("#inputNgayCoHang", {
                        dateFormat: "d/m/Y",   // hiển thị dd/MM/yyyy
                        locale: flatpickr.l10ns.vn || "vn",
                        allowInput: true,
                        clickOpens: true
                    });
                }
            });
        </script>
    </body>

</html>
