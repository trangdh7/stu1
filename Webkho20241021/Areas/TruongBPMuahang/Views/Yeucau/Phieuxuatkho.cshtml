
@{
    ViewData["Title"] = "Phieuxuatkho";
    Layout = "~/Areas/TruongBPMuahang/Views/Layout/Layout.cshtml";
}
@model Webkho_20241021.Areas.TruongBPMuahang.Data.Phieuxuatkhoviewmodel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>yeucau</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>

    <nav class="bodyyeucau">
        <div class="menu-kho">
            <ul class="timkiem">
                <li class="menu-yeucau">
                    <a href="/TruongBPMuahang/Yeucau/Yeucau">Yêu cầu vật tư</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-muahang">
                    <a href="/TruongBPMuahang/Yeucau/Phieumuahang">Yêu cầu mua hàng</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-xuatkho">
                    <a href="/TruongBPMuahang/Yeucau/Phieuxuatkho">Phiếu xuất kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-nhapkho">
                    <a href="/TruongBPMuahang/Yeucau/Phieunhapkho">Phiếu nhập kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>

            </ul>
            <ul>
                <input type="text" id="timkiem" name="Timkiem" placeholder="Tìm kiếm" />
            </ul>
        </div>

        <div class="Tableyeucau">
            <table class="table">
                <thead>
                    <tr>
                        <td>STT</td>
                        <td>Mã xuất kho</td>
                        <td>Mã yêu cầu</td>
                        <td>Mã dự án</td>
                        <td>Người yêu cầu</td>
                        <td>Ngày xuất kho</td>
                        <td>Trạng thái</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int STT = 1;
                    }
                    @foreach (var item in Model.Phieuxuatkho)
                    {
                        string ChucvuSession = Context.Session.GetString("Chucvu");
                        string BophanSession = Context.Session.GetString("Bophan");
                        <tr class="clickable-row" data-maxuatkho="@item.MaXuatkho" onclick="showVTxuatkho('@item.MaXuatkho')" style="cursor: pointer;">
                            <td>@STT</td>
                            <td>
                                <a href="javascript:void(0);" onclick="event.stopPropagation(); showVTxuatkho('@item.MaXuatkho')">
                                    @item.MaXuatkho
                                </a>
                            </td>
                            <td>@item.MaYeucau</td>
                            <td>@item.MaDuan</td>
                            <td>@item.MaNguoidung</td>
                            <td>@item.NgayXuatkho?.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.TrangThai == "Đang chuẩn bị hàng" && BophanSession == "BP kho")
                                {
                                    @using (Html.BeginForm("Xuliphieuxuatkho", "Yeucau", new { area = "TruongBPMuahang" }, FormMethod.Post))
                                    {
                                        <input type="hidden" name="MaXuatkho" value="@item.MaXuatkho" />
                                        <button type="submit" name="action" value="approve" class="btn-icon approve-btn">
                                            <i class="bx bxs-check-circle"></i>
                                        </button>
                                    }
                                }
                                else if (item.TrangThai == "Chờ lấy hàng" && BophanSession == "BP kho")
                                {
                                    @using (Html.BeginForm("Xuliphieuxuatkho", "Yeucau", new { area = "TruongBPMuahang" }, FormMethod.Post))
                                    {
                                        <input type="hidden" name="MaXuatkho" value="@item.MaXuatkho" />
                                        <button type="submit" name="action" value="approve" class="btn-icon approve-btn">
                                            <i class="bx bxs-check-circle"></i>
                                        </button>
                                    }
                                }
                                else if (item.TrangThai == "Đã lấy hàng" && BophanSession == "BP kho")
                                {
                                    @using (Html.BeginForm("Xuliphieuxuatkho", "Yeucau", new { area = "TruongBPMuahang" }, FormMethod.Post))
                                    {
                                        <input type="hidden" name="MaXuatkho" value="@item.MaXuatkho" />
                                        <button type="submit" name="action" value="approve" class="btn-icon approve-btn">
                                            <i class="bx bxs-check-circle"></i>
                                        </button>
                                    }
                                }
                                else
                                {
                                    @item.TrangThai;                                   
                                }
                            </td>
                        </tr>
                        STT++;
                    }
                </tbody>
            </table>
        </div>
    </nav>
    <nav class="bodyyeucau-thietbi" id="bodyYeucauThietbi">
        <div id="phieuxuatkho-header" class="yeucau-info-bar" style="margin-bottom: 10px; padding: 10px; background-color: #f0f0f0; border-radius: 5px; display: none;">
            <span class="yeucau-info"><strong id="phieuxuatkho-header-text"></strong></span>
            <div class="yeucau-table-actions">
                <button type="button" class="btn-table-icon btn-minimize-table" title="Thu nhỏ" aria-label="Thu nhỏ"><svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><rect x="2" y="7" width="12" height="2" rx="0.5"/></svg></button>
                <button type="button" class="btn-table-icon btn-maximize-table" title="Phóng to" aria-label="Phóng to"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="12" height="12" rx="0.5"/></svg></button>
                <button type="button" class="btn-table-icon btn-restore-table" title="Thu nhỏ lại" aria-label="Thu nhỏ lại" style="display: none;"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="6" width="8" height="8" rx="0.5"/><rect x="6" y="2" width="8" height="8" rx="0.5" stroke-dasharray="1,1"/></svg></button>
            </div>
        </div>
        <div class="Tableyeucau-thietbi-box" id="TableyeucauThietbiBox">
            <table class="tablethietbi">
                <thead>
                    <tr>
                        <td>TT</td>
                        <td>Tên thiết bị/hàng hóa</td>
                        <td>Mã VT</td>
                        <td>Mã kho</td>
                        <td>Hãng SX</td>
                        <td>NCC</td>
                        <td>SL</td>
                        <td>Đã xuất</td>
                        <td>Cần xuất</td>
                        <td>SL tồn kho</td>
                        <td>ĐV</td>
                        <td>Trạng thái</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int ST = 1;
                    }
                    @foreach (var item in Model.VTphieuxuatkho)
                    {
                        <tr>
                            <td>@ST</td>
                            <td>@item.TenSanpham</td>
                            <td>@item.MaSanpham</td>    
                            <td>@item.Makho</td>
                            <td>@item.HangSX</td>
                            <td>@item.NhaCC</td>
                            <td>@item.SL</td>
                            <td>@item.DonVi</td>
                        </tr>
                        ST++;
                    }
                </tbody>
            </table>
        </div>
    </nav>
    <script src="~/js/phieuxuatkho.js"></script>
    <script src="~/js/yeucau-table-actions.js"></script>
    <script>
        $(document).ready(function () {
            if (typeof getThongbaoData === 'function') {
            getThongbaoData();
            }
        });
    </script>
</body>
</html>










