@model Webkho_20241021.Areas.NhanvienKetoan.Data.Yeucauviewmodel


@{
    ViewData["Title"] = "Yeucau";
    Layout = "~/Areas/NhanvienKetoan/Views/Layout/Layout.cshtml";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>yeucau</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>

    <nav class="bodyyeucau">
        <div class="menu-kho">
            <ul class="timkiem">
                <li class="menu-yeucau">
                    <a href="/NhanvienKetoan/Yeucau/Yeucau">Yêu cầu vật tư</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-muahang">
                    <a href="/NhanvienKetoan/Yeucau/Phieumuahang">Yêu cầu mua hàng</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                
                <li class="menu-nhapkho">
                    <a href="/NhanvienKetoan/Yeucau/Phieunhapkho">Phiếu nhập kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-xuatkho">
                    <a href="/NhanvienKetoan/Yeucau/Phieuxuatkho">Phiếu xuất kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
            </ul>
            <ul>
                <input type="text" id="timkiem" name="Timkiem" placeholder="Tìm kiếm" />
            </ul>
        </div>

        <div class="Tableyeucau">
            <table class="table">
                <thead>
                    <tr>
                        <td>STT</td>
                        <td>Tên yêu cầu</td>
                        <td>Mã yêu cầu</td>
                        <td>Người yêu cầu</td>
                        <td>Bộ phận</td>
                        <td>Mã người YC</td>
                        <td>Mã dự án</td>
                        <td>Ngày yêu cầu</td>
                        <td>Trạng thái</td>
                        <td>Ngày duyệt</td>
                        <td>Tên người duyệt</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int STT = 1;
                    }
                    @foreach (var item in Model.Yeucau)
                    {
                        var duan = Model.Duans.FirstOrDefault(d => d.MaDuan == item.YCMaDuan);
                        string maNguoiQLDA = duan?.MaNguoiQLDA;
                        string maNguoidungSession = Context.Session.GetString("MaNguoidung");
                        // Tính ngày duyệt sớm nhất từ các vật tư trong yêu cầu
                        var ngayDuyetSomNhat = Model.VTyeucau
                            .Where(vt => vt.VTMaYeucau == item.MaYeucau && vt.NgayDuyet.HasValue)
                            .OrderBy(vt => vt.NgayDuyet)
                            .FirstOrDefault()?.NgayDuyet;
                        <tr onclick="showVTYeucau('@item.MaYeucau', '@item.NguoiYeucau')" style="cursor: pointer;">
                            <td>@STT</td>
                            <td>@item.TenYeucau</td>
                            <td>
                                <a href="javascript:void(0);" onclick="event.stopPropagation(); showVTYeucau('@item.MaYeucau', '@item.NguoiYeucau')">
                                    @item.MaYeucau
                                </a>
                            </td>
                            <td>@item.NguoiYeucau</td>
                            <td>@item.Bophan</td>
                            <td>@item.YCMaNguoidung</td>
                            <td>@item.YCMaDuan</td>
                            <td>@item.NgayYeucau?.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>
                                @if (item.TrangThai == "Quản lí dự án" && maNguoiQLDA == maNguoidungSession)
                                {
                                    @using (Html.BeginForm("XuLyYeucau", "Yeucau", new { area = "NhanvienKetoan" }, FormMethod.Post))
                                    {
                                        <input type="hidden" name="MaYeucau" value="@item.MaYeucau" />
                                        <button type="submit" name="action" value="approve" class="btn-icon approve-btn">
                                            <i class="bx bxs-check-circle"></i>
                                        </button>
                                        <button type="submit" name="action" value="reject" class="btn-icon reject-btn">
                                            <i class="bx bxs-x-circle"></i>
                                        </button>
                                    }
                                }
                                else if (item.TrangThai == $"{Context.Session.GetString("Chucvu")}-{Context.Session.GetString("Bophan")}")
                                {
                                    @using (Html.BeginForm("XuLyYeucau", "Yeucau", new { area = "NhanvienKetoan" }, FormMethod.Post))
                                    {
                                        <input type="hidden" name="MaYeucau" value="@item.MaYeucau" />
                                        <button type="submit" name="action" value="approve" class="btn-icon approve-btn">
                                            <i class="bx bxs-check-circle"></i>
                                        </button>
                                        <button type="submit" name="action" value="reject" class="btn-icon reject-btn">
                                            <i class="bx bxs-x-circle"></i>
                                        </button>
                                    }
                                }
                                else if (item.TrangThai == Context.Session.GetString("Chucvu") && Context.Session.GetString("Chucvu") == "Giám đốc")
                                {
                                    @using (Html.BeginForm("XuLyYeucau", "Yeucau", new { area = "NhanvienKetoan" }, FormMethod.Post))
                                    {
                                        <input type="hidden" name="MaYeucau" value="@item.MaYeucau" />
                                        <button type="submit" name="action" value="approve" class="btn-icon approve-btn">
                                            <i class="bx bxs-check-circle"></i>
                                        </button>
                                        <button type="submit" name="action" value="reject" class="btn-icon reject-btn">
                                            <i class="bx bxs-x-circle"></i>
                                        </button>
                                    }
                                }
                                else
                                {
                                    @item.TrangThai
                                    ;
                                }
                            </td>
                            <td>
                                @if (ngayDuyetSomNhat.HasValue)
                                {
                                    <span>@ngayDuyetSomNhat.Value.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                }
                                else
                                {
                                    <span style="color: #999;">-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.NguoiDuyet))
                                {
                                    <span>@item.NguoiDuyet</span>
                                }
                                else
                                {
                                    <span style="color: #999;">-</span>
                                }
                            </td>
                        </tr>
                        STT++;
                    }
                </tbody>
            </table>
        </div>
        <div class="action">
            <ul class="hanhdong">
                <li>
                    <button type="button" onclick="location.href='/NhanvienKetoan/Yeucau/ThemYeucau'">Thêm yêu cầu</button>
                </li>
            </ul>
        </div>
    </nav>
    <nav class="bodyyeucau-thietbi">
        <div class="yeucau-info" id="yeucauInfo" style="margin-bottom: 10px; padding: 10px; background-color: #f0f0f0; border-radius: 5px; display: none;">
            <strong id="yeucauInfoText"></strong>
        </div>
        <div class="Tableyeucau-thietbi-box">
            <table class="tablethietbi">
                <thead>
                    <tr>
                        <th rowspan="2">STT</th>
                        <th rowspan="2">Tên thiết bị / hàng hóa</th>
                        <th rowspan="2">Mã VT</th>
                        <th rowspan="2">Hãng SX</th>
                        <th rowspan="2">NCC</th>
                        <th colspan="5" style="text-align: center;">SL</th>
                        <th hidden rowspan="2">SL</th>
                        <th rowspan="2">ĐV</th>
                        <th rowspan="2">Ngày cần</th>
                        <th rowspan="2">Trạng thái</th>
                        <th rowspan="2">Ghi chú</th>
                        <th rowspan="2">Ngày duyệt</th>
                    </tr>
                    <tr>
                        <th>Cũ</th>
                        <th>Mới</th>
                        <th>Thiếu</th>
                        <th>Đã xuất</th>
                        <th>Tồn kho</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int STT2 = 1;
                        var tonKhoByMaSanpham = ViewBag.TonKhoByMaSanpham as Dictionary<string, int>;
                        if (tonKhoByMaSanpham == null) { tonKhoByMaSanpham = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase); }
                    }
                    @foreach (var item in Model.VTyeucau)
                    {
                        var slMoi = item.SLMoi ?? item.SL ?? 0;
                        var tonKho = !string.IsNullOrWhiteSpace(item.MaSanpham) && tonKhoByMaSanpham.TryGetValue(item.MaSanpham, out var tk) ? tk : 0;
                        var slThieu = tonKho - slMoi;
                        var isDaXuatKho = (item.TrangThai ?? "").IndexOf("Đã xuất kho", StringComparison.OrdinalIgnoreCase) >= 0;
                        var slDaXuat = isDaXuatKho ? (item.SL ?? item.SLMoi) : (int?)null;
                        <tr>
                            <td>@STT2</td>
                            <td>@item.TenSanpham</td>
                            <td>@item.MaSanpham</td>
                            <td>@item.HangSX</td>
                            <td>@item.NhaCC</td>
                            <td style="text-align: center;">@(item.SLCu?.ToString() ?? "-")</td>
                            <td style="text-align: center;">@((item.SLMoi ?? item.SL)?.ToString() ?? "-")</td>
                            <td style="text-align: center;">@slThieu</td>
                            <td style="text-align: center;">@(slDaXuat.HasValue ? slDaXuat.Value.ToString() : "-")</td>
                            <td style="text-align: center;">@tonKho</td>
                            <td hidden style="text-align: center;">@(item.SL?.ToString() ?? item.SLMoi?.ToString() ?? "-")</td>
                            <td>@(item.DonVi ?? "-")</td>
                            <td>@(item.NgayCanHang?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>@(item.TrangThai ?? "")</td>
                            <td style="color: @(item.TrangThai?.Contains("Đã từ chối") == true ? "#f44336" : "inherit");">
                                @(item.GhiChu ?? "-")
                            </td>
                            <td>@(item.NgayDuyet?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                        </tr>
                        STT2++;
                    }
                </tbody>
            </table>
        </div>
    </nav>
    <script src="~/js/yeucau.js"></script>
    <script>
        $(document).ready(function () {
            if (typeof getThongbaoData === 'function') {
                getThongbaoData();
            }
        });
    </script>
</body>
</html>





