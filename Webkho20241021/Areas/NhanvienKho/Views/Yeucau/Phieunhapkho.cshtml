
@{
    ViewData["Title"] = "Phieunhapkho";
    Layout = "~/Areas/NhanvienKho/Views/Layout/Layout.cshtml";
}
@model Webkho_20241021.Areas.NhanvienKho.Data.Phieunhapkhoviewmodel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>yeucau</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>

    <nav class="bodyyeucau">
        <div class="menu-kho">
            <ul class="timkiem">
                <li class="menu-yeucau">
                    <a href="/NhanvienKho/Yeucau/Yeucau">Yêu cầu vật tư</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-muahang">
                    <a href="/NhanvienKho/Yeucau/Phieumuahang">Yêu cầu mua hàng</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-nhapkho">
                    <a href="/NhanvienKho/Yeucau/Phieunhapkho">Phiếu nhập kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-xuatkho">
                    <a href="/NhanvienKho/Yeucau/Phieuxuatkho">Phiếu xuất kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-muahang">
                    <a href="/NhanvienKho/Yeucau/Phieumuahang">Phiếu mua hàng</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
            </ul>
            <ul>
                <form method="get" action="@Url.Action("Phieunhapkho", "Yeucau", new { area = "NhanvienKho" })" style="display: inline;">
                    <input type="text" id="timkiem" name="search" placeholder="Tìm kiếm" value="@ViewBag.Search" />
                    <button type="submit" style="display: none;">Tìm</button>
                </form>
            </ul>
        </div>

        <div class="Tableyeucau">
            <table class="table">
                <thead>
                    <tr>
                        <td>STT</td>
                        <td>Mã nhập kho</td>
                        <td>Mã yêu cầu</td>
                        <td>Mã dự án</td>
                        <td>Người yêu cầu</td>
                        <td>Ngày nhập kho</td>
                        <td>Trạng thái</td>
                        <td>Thao tác</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int STT = 1;
                    }
                    @foreach (var item in Model.Phieunhapkho)
                    {
                        string ChucvuSession = Context.Session.GetString("Chucvu");
                        string BophanSession = Context.Session.GetString("Bophan");
                        <tr class="clickable-row" data-manhapkho="@item.MaNhapkho" style="cursor: pointer;">
                            <td>@STT</td>
                            <td>
                                <a href="/NhanvienKho/Yeucau/XemPhieunhapkho?MaNhapkho=@item.MaNhapkho" 
                                   title="Click để xem vật tư, Double-click để xem chi tiết phiếu nhập kho" 
                                   class="manhapkho-link"
                                   data-manhapkho="@item.MaNhapkho">
                                    @item.MaNhapkho
                                </a>
                            </td>
                            <td>@item.MaYeucau</td>
                            <td>@item.MaDuan</td>
                            <td>@item.MaNguoidung</td>
                            <td>@(item.TrangThai == "Đã nhập kho" ? item.NgayNhapkho?.ToString("dd/MM/yyyy") : "")</td>
                            <td>
                                <span>@item.TrangThai</span>
                            </td>
                            <td>
                                @{
                                    bool isKhoUser = string.Equals(BophanSession, "BP kho", StringComparison.OrdinalIgnoreCase);
                                }
                                @if (isKhoUser && item.TrangThai == "Chờ nhập kho")
                                {
                                    @using (Html.BeginForm("Xuliphieunhapkho", "Yeucau", new { area = "NhanvienKho" }, FormMethod.Post))
                                    {
                                        <input type="hidden" name="MaNhapkho" value="@item.MaNhapkho" />
                                        <button type="submit" name="action" value="approve" class="btn-icon approve-btn" title="Duyệt nhập kho">
                                            <i class="bx bxs-check-circle"></i>
                                        </button>
                                    }
                                }

                                @if (item.TrangThai == "Đã nhập kho")
                                {
                                    <a href="@Url.Action("InPhietrahang", "Yeucau", new { area = "NhanvienKho", MaNhapkho = item.MaNhapkho })"
                                       target="_blank"
                                       class="btn-icon"
                                       title="In phiếu trả hàng">
                                        <i class="bx bx-printer"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                        STT++;
                    }
                </tbody>
            </table>
        </div>
        <div class="action">
            <ul class="hanhdong">
                <li>
                    <a href="/NhanvienKho/Yeucau/ThemPhieunhapkho">Thêm phiếu nhập kho</a>
                </li>
            </ul>
        </div>
    </nav>
    <nav class="bodyyeucau-thietbi">
        <div id="phieunhapkho-header" class="yeucau-info" style="margin-bottom: 10px; padding: 10px; background-color: #f0f0f0; border-radius: 5px; display: none;">
            <strong id="phieunhapkho-header-text"></strong>
        </div>
        <div class="Tableyeucau-thietbi-box">
            <table class="tablethietbi">
                <thead>
                    <tr>
                        <td>TT</td>
                        <td>Tên thiết bị/hàng hóa</td>
                        <td>Mã VT</td>
                        <td>Mã kho</td>
                        <td>Hãng SX</td>
                        <td>NCC</td>
                        <td>SL</td>
                        <td>ĐV</td>
                        <td>Trạng thái</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int ST = 1;
                    }
                    @if (Model.VTphieunhapkho != null && Model.VTphieunhapkho.Any())
                    {
                        @foreach (var item in Model.VTphieunhapkho)
                        {
                            <tr>
                                <td>@ST</td>
                                <td>@item.TenSanpham</td>
                                <td>@item.MaSanpham</td>    
                                <td>@item.Makho</td>
                                <td>@item.HangSX</td>
                                <td>@item.NhaCC</td>
                                <td>@item.SL</td>
                                <td>@item.DonVi</td>
                                <td>@item.TrangThai</td>
                            </tr>
                            ST++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" style="text-align:center;">Không có dữ liệu vật tư.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </nav>
    <script src="~/js/phieunhapkho.js"></script>
    <script>
        $(document).ready(function () {
            if (typeof getThongbaoData === 'function') {
                getThongbaoData();
            }
        });
    </script>
</body>
</html>










