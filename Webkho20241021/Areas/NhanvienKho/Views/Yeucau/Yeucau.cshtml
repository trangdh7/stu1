@model Webkho_20241021.Areas.NhanvienKho.Data.Yeucauviewmodel


@{
    ViewData["Title"] = "Yeucau";
    Layout = "~/Areas/NhanvienKho/Views/Layout/Layout.cshtml";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>yeucau</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>

    <nav class="bodyyeucau">
        <div class="menu-kho">
            <ul class="timkiem">
                <li class="menu-yeucau">
                    <a href="/NhanvienKho/Yeucau/Yeucau">Yêu cầu vật tư</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-muahang">
                    <a href="/NhanvienKho/Yeucau/Phieumuahang">Vật tư mua hàng</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-nhapkho">
                    <a href="/NhanvienKho/Yeucau/Phieunhapkho">Phiếu nhập kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>           
                <li class="menu-xuatkho">
                    <a href="/NhanvienKho/Yeucau/Phieuxuatkho">Phiếu xuất kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
            </ul>
            <ul>
                <form method="get" action="@Url.Action("Yeucau", "Yeucau", new { area = "NhanvienKho" })" style="display: inline;">
                    <input type="text" id="timkiem" name="search" placeholder="Tìm kiếm" value="@ViewBag.Search" />
                    <button type="submit" style="display: none;">Tìm</button>
                </form>
            </ul>
        </div>

        <div class="Tableyeucau">
            <table class="table">
                <thead>
                    <tr>
                        <td>STT</td>
                        <td>Tên yêu cầu</td>
                        <td>Mã yêu cầu</td>
                        <td>Người yêu cầu</td>
                        <td>Bộ phận</td>
                        <td>Mã người YC</td>
                        <td>Mã dự án</td>
                        <td>Ngày yêu cầu</td>
                        <td>Trạng thái</td>
                        <td>Ngày duyệt</td>
                        <td>Tên người duyệt</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int STT = 1;
                    }
                    @foreach (var item in Model.Yeucau)
                    {
                        var duan = Model.Duans.FirstOrDefault(d => d.MaDuan == item.YCMaDuan);
                        string maNguoiQLDA = duan?.MaNguoiQLDA;
                        string maNguoidungSession = Context.Session.GetString("MaNguoidung");
                        // Tính ngày duyệt sớm nhất từ các vật tư trong yêu cầu
                        var ngayDuyetSomNhat = Model.VTyeucau
                            .Where(vt => vt.VTMaYeucau == item.MaYeucau && vt.NgayDuyet.HasValue)
                            .OrderBy(vt => vt.NgayDuyet)
                            .FirstOrDefault()?.NgayDuyet;
                        <tr onclick="showVTYeucau('@item.MaYeucau')" style="cursor: pointer;">
                            <td>@STT</td>
                            <td>@item.TenYeucau</td>
                            <td>
                                <a href="javascript:void(0);" onclick="event.stopPropagation(); showVTYeucau('@item.MaYeucau')">
                                    @item.MaYeucau
                                </a>
                            </td>
                            <td>@item.NguoiYeucau</td>
                            <td>@item.Bophan</td>
                            <td>@item.YCMaNguoidung</td>
                            <td>@item.YCMaDuan</td>
                            <td>@item.NgayYeucau?.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>
                                @if (item.TrangThai == "Quản lí dự án" && maNguoiQLDA == maNguoidungSession)
                                {
                                    @using (Html.BeginForm("XuLyYeucau", "Yeucau", new { area = "NhanvienKho" }, FormMethod.Post))
                                    {
                                        <input type="hidden" name="MaYeucau" value="@item.MaYeucau" />
                                        <button type="submit" name="action" value="approve" class="btn-icon approve-btn">
                                            <i class="bx bxs-check-circle"></i>
                                        </button>
                                        <button type="submit" name="action" value="reject" class="btn-icon reject-btn">
                                            <i class="bx bxs-x-circle"></i>
                                        </button>
                                    }
                                }
                                else if (item.TrangThai == $"{Context.Session.GetString("Chucvu")}-{Context.Session.GetString("Bophan")}")
                                {
                                    @using (Html.BeginForm("XuLyYeucau", "Yeucau", new { area = "NhanvienKho" }, FormMethod.Post))
                                    {
                                        <input type="hidden" name="MaYeucau" value="@item.MaYeucau" />
                                        <button type="submit" name="action" value="approve" class="btn-icon approve-btn">
                                            <i class="bx bxs-check-circle"></i>
                                        </button>
                                        <button type="submit" name="action" value="reject" class="btn-icon reject-btn">
                                            <i class="bx bxs-x-circle"></i>
                                        </button>
                                    }
                                }
                                else if (item.TrangThai == Context.Session.GetString("Chucvu") && Context.Session.GetString("Chucvu") == "Giám đốc")
                                {
                                    @using (Html.BeginForm("XuLyYeucau", "Yeucau", new { area = "NhanvienKho" }, FormMethod.Post))
                                    {
                                        <input type="hidden" name="MaYeucau" value="@item.MaYeucau" />
                                        <button type="submit" name="action" value="approve" class="btn-icon approve-btn">
                                            <i class="bx bxs-check-circle"></i>
                                        </button>
                                        <button type="submit" name="action" value="reject" class="btn-icon reject-btn">
                                            <i class="bx bxs-x-circle"></i>
                                        </button>
                                    }
                                }
                                else
                                {
                                    @item.TrangThai
                                    ;
                                }
                            </td>
                            <td>
                                @if (ngayDuyetSomNhat.HasValue)
                                {
                                    <span>@ngayDuyetSomNhat.Value.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                }
                                else
                                {
                                    <span style="color: #999;">-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.NguoiDuyet))
                                {
                                    <span>@item.NguoiDuyet</span>
                                }
                                else
                                {
                                    <span style="color: #999;">-</span>
                                }
                            </td>
                        </tr>
                        STT++;
                    }
                </tbody>
            </table>
        </div>
        <div class="action">
            <ul class="hanhdong">
                <li>
                    <a href="/NhanvienKho/Yeucau/ThemYeucau">Thêm yêu cầu</a>
                </li>
            </ul>
        </div>
    </nav>
    <nav class="bodyyeucau-thietbi">
        <div class="Tableyeucau-thietbi-box">
            <table class="tablethietbi">
                <thead>
                    <tr>
                        <td>STT</td>
                        <td>Tên thiết bị/hàng hóa</td>
                        <td>Mã VT</td>
                        <td>Hãng SX</td>
                        <td>NCC</td>
                        <td>SL Cũ</td>
                        <td>SL Mới</td>
                        <td hidden>SL</td>
                        <td>ĐV</td>
                        <td>Ngày cần</td>
                        <td>Trạng thái</td>
                        <td>Ghi chú</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int STT2 = 1;
                    }
                    @foreach (var item in Model.VTyeucau)
                    {
                        <tr>
                            <td>@STT2</td>
                            <td>@item.TenSanpham</td>
                            <td>@item.MaSanpham</td>
                            <td>@item.HangSX</td>
                            <td>@item.NhaCC</td>
                            <td style="text-align: center;">@(item.SLCu?.ToString() ?? "-")</td>
                            <td style="text-align: center;">@(item.SLMoi?.ToString() ?? "-")</td>
                            <td hidden  style="text-align: center;">@(item.SL?.ToString() ?? item.SLMoi?.ToString() ?? "-")</td>
                            <td>@(item.DonVi ?? "-")</td>
                            <td>@(item.NgayCanHang?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>@(item.TrangThai ?? "")</td>
                            <td style="color: @(item.TrangThai?.Contains("Đã từ chối") == true ? "#f44336" : "inherit");">
                                @(item.GhiChu ?? "-")
                            </td>
                        </tr>
                        STT2++;
                    }
                </tbody>
            </table>
        </div>
    </nav>
    <script src="~/js/yeucau.js"></script>
    <script>
        $(document).ready(function () {
            if (typeof getThongbaoData === 'function') {
                getThongbaoData();
            }
        });
    </script>
</body>
</html>





