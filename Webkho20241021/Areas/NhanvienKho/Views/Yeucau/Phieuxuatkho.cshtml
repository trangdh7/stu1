
@{
    ViewData["Title"] = "Phieuxuatkho";
    Layout = "~/Areas/NhanvienKho/Views/Layout/Layout.cshtml";
}
@model Webkho_20241021.Areas.NhanvienKho.Data.Phieuxuatkhoviewmodel
@using System.Text.Json
@{
    var errorMessage = TempData["Error"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>yeucau</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>

    <nav class="bodyyeucau">
        <div class="menu-kho">
            <ul class="timkiem">
                <li class="menu-yeucau">
                    <a href="/NhanvienKho/Yeucau/Yeucau">Yêu cầu vật tư</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-muahang">
                    <a href="/NhanvienKho/Yeucau/Phieumuahang">Yêu cầu mua hàng</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-nhapkho">
                    <a href="/NhanvienKho/Yeucau/Phieunhapkho">Phiếu nhập kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-xuatkho">
                    <a href="/NhanvienKho/Yeucau/Phieuxuatkho">Phiếu xuất kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-muahang">
                    <a href="/NhanvienKho/Yeucau/Phieumuahang">Phiếu mua hàng</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
            </ul>
            <ul>
                <form method="get" action="@Url.Action("Phieuxuatkho", "Yeucau", new { area = "NhanvienKho" })" style="display: inline;">
                    <input type="text" id="timkiem" name="search" placeholder="Tìm kiếm" value="@ViewBag.Search" />
                    <button type="submit" style="display: none;">Tìm</button>
                </form>
            </ul>
        </div>

        <div class="Tableyeucau">
            <table class="table">
                <thead>
                    <tr>
                        <td>STT</td>
                        <td>Mã xuất kho</td>
                        <td>Mã yêu cầu</td>
                        <td>Mã dự án</td>
                        <td>Người yêu cầu</td>
                        <td>Ngày xuất kho</td>
                        <td>Trạng thái</td>
                        <td>In phiếu</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int STT = 1;
                    }
                    @foreach (var item in Model.Phieuxuatkho)
                    {
                        string ChucvuSession = Context.Session.GetString("Chucvu");
                        string BophanSession = Context.Session.GetString("Bophan");
                        <tr class="clickable-row" data-maxuatkho="@item.MaXuatkho" style="cursor: pointer;">
                            <td>@STT</td>
                            <td>
                                <a href="javascript:void(0);" onclick="showVTxuatkho('@item.MaXuatkho')">
                                    @item.MaXuatkho
                                </a>
                            </td>
                            <td>@item.MaYeucau</td>
                            <td>@item.MaDuan</td>
                            <td>@item.MaNguoidung</td>
                            <td>@item.NgayXuatkho?.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.TrangThai == "Chờ xác nhận" && BophanSession == "BP kho")
                                {
                                    @using (Html.BeginForm("Xuliphieuxuatkho", "Yeucau", new { area = "NhanvienKho" }, FormMethod.Post))
                                    {
                                        <input type="hidden" name="MaXuatkho" value="@item.MaXuatkho" />
                                        <button type="submit" name="action" value="approve" class="btn-icon approve-btn" title="Duyệt xuất kho">
                                            <i class="bx bxs-check-circle"></i>
                                        </button>
                                    }
                                }
                                else if (item.TrangThai == "Đang chuẩn bị hàng" && BophanSession == "BP kho")
                                {
                                    @using (Html.BeginForm("Xuliphieuxuatkho", "Yeucau", new { area = "NhanvienKho" }, FormMethod.Post))
                                    {
                                        <input type="hidden" name="MaXuatkho" value="@item.MaXuatkho" />
                                        <button type="submit" name="action" value="approve" class="btn-icon approve-btn">
                                            <i class="bx bxs-check-circle"></i>
                                        </button>
                                    }
                                }
                                else if (item.TrangThai == "Chờ lấy hàng" && BophanSession == "BP kho")
                                {
                                    @using (Html.BeginForm("Xuliphieuxuatkho", "Yeucau", new { area = "NhanvienKho" }, FormMethod.Post))
                                    {
                                        <input type="hidden" name="MaXuatkho" value="@item.MaXuatkho" />
                                        <button type="submit" name="action" value="approve" class="btn-icon approve-btn">
                                            <i class="bx bxs-check-circle"></i>
                                        </button>
                                    }
                                }
                                else if (item.TrangThai == "Đã lấy hàng" && BophanSession == "BP kho")
                                {
                                    @using (Html.BeginForm("Xuliphieuxuatkho", "Yeucau", new { area = "NhanvienKho" }, FormMethod.Post))
                                    {
                                        <input type="hidden" name="MaXuatkho" value="@item.MaXuatkho" />
                                        <button type="submit" name="action" value="approve" class="btn-icon approve-btn">
                                            <i class="bx bxs-check-circle"></i>
                                        </button>
                                    }
                                }
                                else
                                {
                                    @item.TrangThai;                                   
                                }
                            </td>
                        </tr>
                        STT++;
                    }
                </tbody>
            </table>
        </div>
    </nav>
    <nav class="bodyyeucau-thietbi">
        <div id="phieuxuatkho-header" class="yeucau-info" style="margin-bottom: 10px; padding: 10px; background-color: #f0f0f0; border-radius: 5px; display: none;">
            <strong id="phieuxuatkho-header-text"></strong>
        </div>
        <div class="Tableyeucau-thietbi-box">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" style="margin-bottom:10px;">
                    @errorMessage
                </div>
            }
            <style>
                /* (Dùng CSS theo class ở `wwwroot/css/yeucau.css` để áp dụng cho mọi area) */

                .tablethietbi thead tr td:last-child,
                .tablethietbi tbody tr td:last-child { min-width: 140px; width: 140px; padding: 8px; }
                .tablethietbi .btn-xuatkho-item { white-space: nowrap; min-height: 40px; }
            </style>
            <table class="tablethietbi">
                <thead>
                    <tr>
                        <td>TT</td>
                        <td>Tên thiết bị/hàng hóa</td>
                        <td>Mã VT</td>
                        <td>Mã kho</td>
                        <td>Hãng SX</td>
                        <td>NCC</td>
                        <td>SL</td>
                        <td>Đã xuất</td>
                        <td>Cần xuất</td>
                        <td>SL tồn kho</td>
                        <td>ĐV</td>
                        <td>Trạng thái</td>
                        <td>Thao tác</td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int ST = 1;
                    }
                    @foreach (var item in Model.VTphieuxuatkho)
                    {
                        <tr>
                            <td>@ST</td>
                            <td>@item.TenSanpham</td>
                            <td>@item.MaSanpham</td>    
                            <td>@item.Makho</td>
                            <td>@item.HangSX</td>
                            <td>@item.NhaCC</td>
                            <td>@item.SL</td>
                            <td>@item.DonVi</td>
                            <td></td>
                            <td></td>
                        </tr>
                        ST++;
                    }
                </tbody>
            </table>
        </div>
        <div id="xuatkho-button-container" style="margin-top: 20px; text-align: right; padding-right: 20px; display: none;">
            <div id="xuatkho-button-content"></div>
        </div>
    </nav>
    <script src="~/js/phieuxuatkho.js"></script>
    <script>
        $(document).ready(function () {
            if (typeof getThongbaoData === 'function') {
                getThongbaoData();
            }
        });
    </script>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <script>
            console.error('Xuất kho (Nhân viên kho) lỗi:', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMessage)));
        </script>
    }
</body>
</html>










