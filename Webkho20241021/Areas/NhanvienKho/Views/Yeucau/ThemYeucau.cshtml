@model Webkho_20241021.Models.yeucau
@{
    ViewData["Title"] = "ThemYeucau";
    Layout = "~/Areas/NhanvienKho/Views/Layout/Layout.cshtml";
}

@using (Html.BeginForm("ThemYeucauSQL", "Yeucau", new { area = "NhanvienKho" }, FormMethod.Post, true, new { enctype = "multipart/form-data" }))
{
        <div class="formyeucau">
            <div class="tieude">
                <p>Thông tin yêu cầu</p>
            </div>
            <div class="row">
                <div class="field">
                    <label for="ten">Tên</label>
                    <input type="text" id="ten" name="NguoiYeucau" placeholder="Tên"
                           value="@Context.Session.GetString("TenNguoidung")" required readonly />
                </div>
                <div class="field">
                    <label for="manv">Mã NV</label>
                    <input type="text" id="manv" name="YCMaNguoidung" placeholder="Mã nhân viên"
                           value="@Context.Session.GetString("MaNguoidung")" required readonly />
                </div>
                <div class="field">
                    <label for="bophan">Bộ phận</label>
                    <input type="text" id="bophan" name="Bophan" placeholder="Bộ phận"
                           value="@Context.Session.GetString("Bophan")" required readonly />
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="tenyeucau">Tên yêu cầu</label>
                    <select id="tenyeucau" name="TenYeucau" required>
                        <option value="" disabled selected>Chọn yêu cầu</option>
                        <option value="Yêu cầu vật tư">Yêu cầu vật tư</option>
                        <option value="Yêu cầu nhập kho">Yêu cầu nhập kho</option>
                        <option value="Yêu cầu xuất kho">Yêu cầu xuất kho</option>
                    </select>
                </div>
                <div class="field">
                    <label for="maduan">Mã dự án</label>
                    <select id="maduan" name="YCMaDuan" required>
                        <option value="">Chọn mã dự án</option>
                        <option value="">Không</option>
                        @foreach (var n in ViewBag.Duanlist)
                        {
                            <option value="@n.MaDuan">@n.MaDuan</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="ngaycanhang">Ngày cần hàng</label>
                    <input type="date" id="ngaycanhang" name="NgayCanHang" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
            </div>
        </div>
        <div class="formtableyeucau">
            <div class="tieude">
                <p>Danh sách vật tư yêu cầu</p>
            </div>
            <div class="upload-excel">
                <label for="excel-upload">Tải tệp Excel</label>
                <input type="file" id="excel-upload" name="excel-upload" accept=".xlsx, .xls" />
                <p class="text-sm text-gray-600 leading-tight">
                    Vui lòng sử dụng tệp có các cột:
                    <b>Tên</b>, <b>Mã vật tư</b>, <b>Hãng sản xuất</b>,
                    <b>Đơn vị</b>, <b>Số lượng</b>, <b>Nhà cung cấp</b>, <b>Ngày cần hàng</b>.
                </p>

            </div>
            <div id="excel-feedback"
                 class="mt-3 min-h-[40px] p-3 rounded-lg text-sm bg-gray-50 border-l-4 border-transparent">
            </div>

            <div class="themyeucau-table">
                <table class="form-table">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Tên thiết bị/hàng hóa</th>
                            <th>Mã VT</th>
                            <th>Hãng SX</th>
                            <th>ĐV</th>
                            <th>SL (Cũ)</th>
                            <th>SL (Mới)</th>
                            <th>Ngày cần</th>
                            <th>NCC</th>
                            <th>Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody id="table-body"></tbody>
                </table>
                @* Tạm thời ẩn chức năng nhập tay sản phẩm theo yêu cầu *@
            </div>
            <div id="excel-hidden-inputs" style="display:none;"></div>
            <div class="action">
                <button type="submit">Gửi</button>
            </div>
        </div>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js" integrity="sha512-pJW25KcTnYxSNhKp1FeLnii52PPiVUPwsh2n5WAnvptuP9HNy0T0VEgfi+c8xPmjOZ+NaAhhQBWQS421qY4mZQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="~/js/themyeucau.js"></script>
}
