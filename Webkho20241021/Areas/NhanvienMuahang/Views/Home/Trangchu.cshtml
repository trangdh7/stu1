
@{
    ViewData["Title"] = "Trangchu";
    Layout = "~/Areas/NhanvienMuahang/Views/Layout/Layout.cshtml";
}

<nav class="trangchu">
        <nav class="trangchu1">
            <nav class="chucnang">
                <span>Thông tin cá nhân</span>
                <ul class="canhan-icon">
                    <li>
                        <a href="@Url.Action("Thongtincanhan", "Thongtincanhan", new { area = "NhanvienMuahang" })"><i class='bx bxs-user' style='color:#8843b1'></i></a>
                        <a href="@Url.Action("Thongtincanhan", "Thongtincanhan", new { area = "NhanvienMuahang" })">Thông tin cá nhân</a>
                    </li>
                </ul>
            </nav>
            <nav class="chucnang">
                <span>Quản lí kho</span>
                <ul class="canhan-icon">
                    <li>
                        <a href="@Url.Action("Tongkho", "Home", new { area = "NhanvienMuahang" })"><i class='bx bx-grid' style='color:#0d1348'></i></a>
                        <a href="@Url.Action("Tongkho", "Home", new { area = "NhanvienMuahang" })">Tổng kho</a>
                    </li>
                    <li>
                        <a href="@Url.Action("ExportTongkho", "Home", new { area = "NhanvienMuahang" })"><i class='bx bx-export' style='color:#712a0e'></i></a>
                        <a href="@Url.Action("ExportTongkho", "Home", new { area = "NhanvienMuahang" })">Export</a>
                    </li>
                </ul>
            </nav>
        </nav>
        <nav class="trangchu2">
            <nav class="chucnang">
                <span>Quản lí dự án</span>
                <ul class="canhan-icon">
                    <li>
                        <a href="@Url.Action("Duan", "Duan", new { area = "NhanvienMuahang" })"><i class='bx bxs-calendar-alt' style='color:#0e1171'></i></a>
                        <a href="@Url.Action("Duan", "Duan", new { area = "NhanvienMuahang" })">Danh sách dự án</a>
                    </li>
                </ul>
            </nav>
            <nav class="chucnang">
                <span>Quản lí yêu cầu</span>
                <ul class="canhan-icon">
                    <li class="Danhsachyeucau">
                        <a href="@Url.Action("Yeucau", "Yeucau", new { area = "NhanvienMuahang" })"><i class='bx bxs-report' style='color:#0f1271'></i></a>
                        <a href="@Url.Action("Yeucau", "Yeucau", new { area = "NhanvienMuahang" })">Danh sách yêu cầu</a>
                        <span class="badge-trangchu">
                            <span class="notification"></span>
                        </span>
                    </li>
                    <li>
                        <a href="@Url.Action("ThemYeucau", "Yeucau", new { area = "NhanvienMuahang" })"><i class='bx bx-folder-plus' style='color:#0c6215'></i></a>
                        <a href="@Url.Action("ThemYeucau", "Yeucau", new { area = "NhanvienMuahang" })">Thêm yêu cầu</a>
                    </li>
                    <li>
                        <a href="@Url.Action("VatTuMoi", "Home", new { area = "NhanvienMuahang" })"><i class='bx bx-package' style='color:#8b5cf6'></i></a>
                        <a href="@Url.Action("VatTuMoi", "Home", new { area = "NhanvienMuahang" })">Vật tư mới</a>
                    </li>
                </ul>
            </nav>
        </nav>
    </nav>
@section Scripts {
    <script src="~/js/trangchu.js"></script>
    <script>
        $(document).ready(function () {
            if (typeof getThongbaoDatatrangchu === 'function') {
                getThongbaoDatatrangchu();
            }
        });
    </script>
}
