@{
    ViewData["Title"] = "Yêu cầu mua hàng";
    Layout = "~/Areas/NhanvienMuahang/Views/Layout/Layout.cshtml";
}
@model Webkho_20241021.Areas.NhanvienMuahang.Data.Phieumuahangviewmodel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>yeucau</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>

    <body>
        <nav class="bodyyeucau">
            <div class="menu-kho">
                <ul class="timkiem">
                <li class="menu-yeucau">
                    <a href="/NhanvienMuahang/Yeucau/Yeucau">Yêu cầu vật tư</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-muahang">
                    <a href="/NhanvienMuahang/Yeucau/Phieumuahang">Yêu cầu mua hàng</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-nhapkho">
                    <a href="/NhanvienMuahang/Yeucau/Phieunhapkho">Phiếu nhập kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-xuatkho">
                    <a href="/NhanvienMuahang/Yeucau/Phieuxuatkho">Phiếu xuất kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                </ul>
                <ul>
                    <input type="text" id="timkiem" name="Timkiem" placeholder="Tìm kiếm" />
                </ul>
            </div>

            <div class="Tableyeucau">
                <table class="table">
                    <thead>
                        <tr>
                            <td>STT</td>
                            <td>Mã mua hàng</td>
                            <td>Mã yêu cầu</td>
                            <td>Mã dự án</td>
                            <td>Người yêu cầu</td>
                            <td>Ngày mua hàng</td>
                            <td>Ngày cần</td>
                            <td>Trạng thái</td>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int STT = 1;
                        }
                        @foreach (var item in Model.Phieumuahang)
                        {
                            string ChucvuSession = Context.Session.GetString("Chucvu");
                            string BophanSession = Context.Session.GetString("Bophan");
                            <tr class="clickable-row" data-mamuahang="@item.MaMuahang" onclick="showVTmuahang('@item.MaMuahang', '@item.TrangThai')" style="cursor: pointer;">
                                <td>@STT</td>
                                <td>
                                    <a href="javascript:void(0);" onclick="showVTmuahang('@item.MaMuahang', '@item.TrangThai')" data-trangthai="@item.TrangThai">
                                        @item.MaMuahang
                                    </a>
                                </td>
                                <td>@item.MaYeucau</td>
                                <td>@item.MaDuan</td>
                                <td>@(string.IsNullOrEmpty(item.TenNguoiyeucau) ? item.MaNguoidung : item.TenNguoiyeucau)</td>
                                <td>@item.NgayMuahang?.ToString("dd/MM/yyyy")</td>
                                <td>@(item.NgayCanHang?.ToString("dd/MM/yyyy") ?? "  ")</td>
                                <td>
                                    @if ((item.TrangThai == "Đã báo giá" && ChucvuSession == "Giám đốc") ||
                                          (item.TrangThai == "Chờ thanh toán" && (BophanSession == "BP kế toán" || BophanSession == "BP mua hàng")))
                                    {
                                        @using (Html.BeginForm("XuLyPhieumuahang", "Yeucau", new { area = "NhanvienMuahang" }, FormMethod.Post))
                                        {
                                            <input type="hidden" name="MaMuahang" value="@item.MaMuahang" />
                                            <button type="submit" name="action" value="approve" class="btn-icon approve-btn">
                                                <i class="bx bxs-check-circle"></i>
                                            </button>
                                            <button type="submit" name="action" value="reject" class="btn-icon reject-btn">
                                                <i class="bx bxs-x-circle"></i>
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        @item.TrangThai;
                                    }
                                </td>
                            </tr>
                            STT++;
                        }
                    </tbody>
                </table>
            </div>
        </nav>

        <nav class="bodyyeucau-thietbi">
            <!-- This part is for the "Thietbi" section, using the MaMuahang from the current context -->
            <input type="hidden" id="selectedMamuahang" name="MaMuahang" value="@Model.Phieumuahang.FirstOrDefault()?.MaMuahang" />
            <div id="phieumuahang-header" style="margin-top: 10px; margin-right: 10px; margin-bottom: 15px; font-size: 18px; font-weight: bold; display: none;">
                <strong id="phieumuahang-header-text"></strong>
            </div>
            <div class="Tableyeucau-thietbi-box">
                <table class="tablethietbi">
                    <thead>
                        <tr>
                            <td>TT</td>
                            <td>Tên thiết bị/hàng hóa</td>
                            <td>Mã VT</td>
                            @* <td>Mã kho</td> *@
                            <td>Hãng SX</td>
                            <td>NCC</td>
                            <td>SL</td>
                            <td>ĐV</td>
                            <td>Đơn giá</td>
                            <td>Thành tiền</td>
                            <td>Ngày Thanh Toán</td>
                            <td>Ngày có hàng</td>
                            <td>Ghi chú</td>
                            <td>Trạng thái</td>
                        </tr>   
                    </thead>
                    <tbody>                      
                    </tbody>
                </table>
            </div>
            <div class="action" style="justify-content: flex-end;">
                @if (Context.Session.GetString("Bophan") == "BP mua hàng")
                {
                    <button type="button" id="submitPhieumuahang">Gửi báo giá</button>
                    <button type="button" id="btnInPhieu" onclick="inPhieuMuaHang()" style="margin-left: 10px;">
                        <i class='bx bx-printer'></i> In phiếu mua hàng
                    </button>
                }
            </div>
        </nav>
        <script src="~/js/phieumuahang.js?v=20260206"></script>
        <script>
            $(document).ready(function () {
                if (typeof getThongbaoData === 'function') {
                    getThongbaoData();
                }
            });
        </script>
    </body>

</html>
