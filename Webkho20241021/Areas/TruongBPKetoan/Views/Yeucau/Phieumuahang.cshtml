@{
    ViewData["Title"] = "Phieuxuatkho";
    Layout = "~/Areas/TruongBPKetoan/Views/Layout/Layout.cshtml";
}
@model Webkho_20241021.Areas.TruongBPKetoan.Data.Phieumuahangviewmodel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>yeucau</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>

    <body>
        <nav class="bodyyeucau">
            <div class="menu-kho">
                <ul class="timkiem">
                <li class="menu-yeucau">
                    <a href="/TruongBPKetoan/Yeucau/Yeucau">Yêu cầu vật tư</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-muahang">
                    <a href="/TruongBPKetoan/Yeucau/Phieumuahang">Yêu cầu mua hàng</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-nhapkho">
                    <a href="/TruongBPKetoan/Yeucau/Phieunhapkho">Phiếu nhập kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                <li class="menu-xuatkho">
                    <a href="/TruongBPKetoan/Yeucau/Phieuxuatkho">Phiếu xuất kho</a>
                    <span class="badge">
                        <span class="notification"></span>
                    </span>
                </li>
                </ul>
                <ul>
                    <input type="text" id="timkiem" name="Timkiem" placeholder="Tìm kiếm" />
                </ul>
            </div>

            <div class="Tableyeucau">
                <table class="table">
                    <thead>
                        <tr>
                            <td>STT</td>
                            <td>Mã mua hàng</td>
                            <td>Mã yêu cầu</td>
                            <td>Mã dự án</td>
                            <td>Người yêu cầu</td>
                            <td>Ngày mua hàng</td>
                            <td>Trạng thái</td>
                            <td>Hành động</td>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int STT = 1;
                        }
                        @foreach (var item in Model.Phieumuahang)
                        {
                            <tr onclick="showVTmuahang('@item.MaMuahang', '@item.TrangThai')" style="cursor: pointer;">
                                <td>@STT</td>
                                <td>
                                    <a href="javascript:void(0);" onclick="event.stopPropagation(); showVTmuahang('@item.MaMuahang', '@item.TrangThai')" data-trangthai="@item.TrangThai">
                                        @item.MaMuahang
                                    </a>
                                </td>
                                <td>@item.MaYeucau</td>
                                <td>@item.MaDuan</td>
                                <td>@item.MaNguoidung</td>
                                <td>@item.NgayMuahang?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @item.TrangThai
                                </td>
                                <td>
                                    <a href="@Url.Action("InPhieumuahang", "Yeucau", new { area = "TruongBPKetoan", MaMuahang = item.MaMuahang })" 
                                       target="_blank" 
                                       class="btn-icon" 
                                       title="In phiếu"
                                       onclick="event.stopPropagation();">
                                        <i class="bx bx-printer"></i>
                                    </a>
                                </td>
                            </tr>
                            STT++;
                        }
                    </tbody>
                </table>
            </div>
        </nav>

        <nav class="bodyyeucau-thietbi">
            <!-- This part is for the "Thietbi" section, using the MaMuahang from the current context -->
            <input type="hidden" id="selectedMamuahang" name="MaMuahang" value="@Model.Phieumuahang.FirstOrDefault()?.MaMuahang" />
            <div class="phieumuahang-info" id="phieumuahang-header" style="margin-bottom: 10px; padding: 10px; background-color: #f0f0f0; border-radius: 5px; display: none;">
                <strong></strong>
            </div>
            <div class="Tableyeucau-thietbi-box">
                <table class="tablethietbi">
                    <thead>
                        <tr>
                            <td>STT</td>
                            <td>Tên vật tư</td>
                            <td>Mã vật tư</td>
                            <td>Mã kho</td>
                            <td>Hãng sx</td>
                            <td>Nhà cung cấp</td>
                            <td>Số lượng</td>
                            <td>Đơn vị</td>
                            <td>Đơn giá</td>
                            <td>Thành tiền</td>
                            <td>Trạng thái</td>
                        </tr>
                    </thead>
                    <tbody>                      
                    </tbody>
                </table>
            </div>
            <div class="action" style="margin-top: 15px; display: flex; justify-content: flex-end;">
                @{
                    string ChucvuSession = Context.Session.GetString("Chucvu");
                    string BophanSession = Context.Session.GetString("Bophan");
                }
                <div id="approveRejectButtons" style="display: none; gap: 10px;">
                    <form id="approveRejectForm" method="post" action="@Url.Action("XuLyPhieumuahang", "Yeucau", new { area = "TruongBPKetoan" })" style="display: flex; gap: 10px;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="MaMuahang" id="hiddenMaMuahang" value="" />
                        <button type="button" id="btnApprove" class="btn-icon" style="background-color: #336600; color: white; padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer;">
                            <i class="bx bxs-check-circle"></i> Duyệt
                        </button>
                        <button type="button" id="btnReject" class="btn-icon" style="background-color: #336600; color: white; padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer;">
                            <i class="bx bxs-x-circle"></i> Từ chối
                        </button>
                    </form>
                </div>
            </div>
        </nav>
        <script src="~/js/phieumuahang.js"></script>
        <script>
            $(document).ready(function () {
                if (typeof getThongbaoData === 'function') {
                getThongbaoData();
                }
                
                // Xử lý nút duyệt
                $('#btnApprove').on('click', function() {
                    if (!confirm('Bạn có chắc chắn muốn duyệt phiếu mua hàng này?')) {
                        return;
                    }
                    $('#hiddenMaMuahang').val(selectedMamuahang);
                    var form = $('#approveRejectForm');
                    var actionInput = $('<input>').attr('type', 'hidden').attr('name', 'action').val('approve');
                    form.append(actionInput);
                    form.submit();
                });
                
                // Xử lý nút từ chối
                $('#btnReject').on('click', function() {
                    if (!confirm('Bạn có chắc chắn muốn từ chối phiếu mua hàng này?')) {
                        return;
                    }
                    $('#hiddenMaMuahang').val(selectedMamuahang);
                    var form = $('#approveRejectForm');
                    var actionInput = $('<input>').attr('type', 'hidden').attr('name', 'action').val('reject');
                    form.append(actionInput);
                    form.submit();
                });
            });
        </script>
    </body>

</html>
